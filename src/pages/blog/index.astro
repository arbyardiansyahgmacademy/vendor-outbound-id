---
import PublicLayout from '../../layouts/PublicLayout.astro';
import FAQAccordion from '../../components/sections/FAQAccordion.astro';
import CTASection from '../../components/sections/CTASection.astro';
import { BLOG_POSTS } from '../../data/defaultContent';

const breadcrumbs = [
  { name: 'Blog' }
];
---

<PublicLayout
  title="Blog & Panduan Outbound Batu Malang | Vendor Outbound"
  description="Artikel, tips persiapan, dan panduan lengkap penyelenggaraan kegiatan outbound, family gathering, dan team building di Batu Malang."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section -->
  <section class="py-16 sm:py-24 relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-400">
        Pusat Edukasi &amp; Panduan
      </span>
      <h1 class="font-heading font-black text-3xl sm:text-5xl uppercase tracking-[0.14em] text-white">
        ARTIKEL &amp; PANDUAN OUTBOUND
      </h1>
      <p class="text-base sm:text-lg text-rose-100/85 max-w-3xl mx-auto leading-relaxed">
        Wawasan praktis seputar pemilihan lokasi, tips merancang rundown gathering, dan strategi membangun komunikasi tim di alam terbuka.
      </p>
    </div>
  </section>

  <!-- Blog Articles Grid -->
  <section class="py-12 border-t border-rose-900/40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {BLOG_POSTS.map((post) => (
          <article class="rounded-2xl bg-[#480308]/60 border border-rose-700/35 overflow-hidden flex flex-col justify-between hover:border-amber-400/50 transition-all duration-300 hover:-translate-y-1.5 shadow-card group">
            <div>
              <a href={`/blog/${post.slug}`} class="aspect-16/10 w-full overflow-hidden block relative">
                <img
                  src={post.thumbnailUrl}
                  alt={post.imageAlt}
                  width="500"
                  height="320"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <span class="absolute top-3 left-3 px-2.5 py-1 rounded bg-stone-900/85 backdrop-blur-sm text-[10px] font-bold uppercase tracking-wider text-amber-400 border border-amber-400/30">
                  {post.category}
                </span>
              </a>

              <div class="p-6 space-y-3 text-left">
                <div class="flex items-center gap-2 text-[11px] text-rose-300/70">
                  <span>{post.publishedAt}</span>
                  <span>•</span>
                  <span>{post.readingTimeMinutes} mnt baca</span>
                </div>

                <a href={`/blog/${post.slug}`} class="block group-hover:text-amber-400 transition-colors">
                  <h2 class="font-heading font-black text-lg text-white leading-snug">
                    {post.title}
                  </h2>
                </a>

                <p class="text-xs text-rose-200/75 line-clamp-3 leading-relaxed">
                  {post.excerpt}
                </p>
              </div>
            </div>

            <div class="p-6 pt-0 mt-4 border-t border-rose-900/30 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <img
                  src={post.authorAvatar || '/images/author-artikel/author-artikel-arby-ardiansyah.webp'}
                  alt={post.authorName}
                  width="24"
                  height="24"
                  class="w-6 h-6 rounded-full object-cover border border-amber-400/50"
                  loading="lazy"
                />
                <span class="text-xs text-rose-300/80 font-medium">
                  {post.authorName}
                </span>
              </div>
              <a
                href={`/blog/${post.slug}`}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-400 group-hover:translate-x-1 transition-transform"
              >
                <span>Baca Selengkapnya</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQAccordion title="FAQ SEPUTAR ARTIKEL OUTBOUND" />

  <!-- CTA Section -->
  <CTASection />

</PublicLayout>
