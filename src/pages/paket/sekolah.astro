---
import PublicLayout from '../../layouts/PublicLayout.astro';
import FAQAccordion from '../../components/sections/FAQAccordion.astro';
import CTASection from '../../components/sections/CTASection.astro';
import { PACKAGES } from '../../data/defaultContent';
import { getWhatsAppUrl } from '../../lib/utils';

const categorySlug = 'sekolah';
const categoryName = 'Sekolah & Pelajar';
const packages = PACKAGES.filter((p) => p.categorySlug === categorySlug);

const breadcrumbs = [
  { name: 'Paket', url: '/paket' },
  { name: categoryName }
];
---

<PublicLayout
  title={`Paket Outbound ${categoryName} Batu Malang | Vendor Outbound`}
  description="Pilihan paket outbound sekolah: Outbound Pelajar, Character Building, LDKS Leadership, dan Edukasi Alam di Batu Malang."
  breadcrumbs={breadcrumbs}
>
  <section class="py-16 sm:py-24 relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/15 border border-amber-400/30 text-amber-300 text-xs font-bold uppercase tracking-widest">
        Kategori Paket 03
      </div>
      <h1 class="font-heading font-black text-3xl sm:text-5xl uppercase tracking-[0.14em] text-white">
        PAKET OUTBOUND {categoryName.toUpperCase()}
      </h1>
      <p class="text-base sm:text-lg text-rose-100/85 max-w-3xl mx-auto leading-relaxed">
        Program pembentukan karakter disiplin, kepemimpinan siswa (LDKS), dan edukasi kelestarian lingkungan alam di bumi perkemahan sejuk Kota Batu.
      </p>
    </div>
  </section>

  <section class="py-12 border-t border-rose-900/40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {packages.map((pkg) => {
          const waUrl = getWhatsAppUrl(`Halo Vendor Outbound, saya ingin konsultasi paket ${pkg.title} (${categoryName}).`);

          return (
            <div class="rounded-2xl bg-[#480308]/60 border border-rose-700/35 overflow-hidden flex flex-col justify-between hover:border-amber-400/50 transition-all duration-300 shadow-card group">
              <div>
                <div class="aspect-16/9 w-full overflow-hidden bg-brand-950 relative">
                  <img
                    src={pkg.imageUrl}
                    alt={pkg.title}
                    width="600"
                    height="350"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                  <div class="absolute bottom-3 left-3 px-3 py-1 rounded bg-stone-900/85 backdrop-blur-sm text-xs font-bold uppercase tracking-wider text-amber-400 border border-amber-400/30">
                    Durasi: {pkg.duration}
                  </div>
                </div>

                <div class="p-6 space-y-4 text-left">
                  <h2 class="font-heading font-black text-xl sm:text-2xl uppercase tracking-wider text-white group-hover:text-amber-400 transition-colors">
                    {pkg.title}
                  </h2>
                  <p class="text-sm text-rose-100/85 leading-relaxed">
                    {pkg.excerpt}
                  </p>

                  <div class="space-y-2 pt-2 border-t border-rose-900/30">
                    <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Rangkaian Aktivitas:</span>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-xs text-rose-200/90">
                      {pkg.activities.map((act) => (
                        <li class="flex items-center gap-2">
                          <span class="text-amber-400 font-bold">•</span>
                          <span>{act}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="space-y-2 pt-2 border-t border-rose-900/30">
                    <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Fasilitas Termasuk:</span>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-xs text-rose-200/90">
                      {pkg.features.map((feat) => (
                        <li class="flex items-center gap-2">
                          <span class="text-emerald-400 font-bold">✓</span>
                          <span>{feat}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>

              <div class="p-6 pt-0 mt-4">
                <a
                  href={waUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center gap-2.5 py-3.5 rounded-md bg-amber-500 hover:bg-amber-400 text-stone-950 font-heading font-black text-xs uppercase tracking-wider shadow-md hover:scale-[1.02] transition-all"
                >
                  <span>Konsultasi Paket Ini</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <FAQAccordion title={`FAQ SEPUTAR PAKET ${categoryName.toUpperCase()}`} />

  <CTASection
    title={`KONSULTASIKAN OUTBOUND ${categoryName.toUpperCase()} BATU MALANG`}
    customMessage={`Halo Vendor Outbound, saya ingin konsultasi paket outbound sekolah di Batu Malang.`}
  />
</PublicLayout>
