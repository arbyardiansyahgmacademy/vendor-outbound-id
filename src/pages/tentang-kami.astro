---
import PublicLayout from '../layouts/PublicLayout.astro';
import WhyChooseUs from '../components/sections/WhyChooseUs.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import CTASection from '../components/sections/CTASection.astro';
import { SITE_INFO } from '../data/defaultContent';

const breadcrumbs = [
  { name: 'Tentang Kami' }
];
---

<PublicLayout
  title="Tentang Kami | Provider Outbound Batu Malang"
  description="Mengenal Provider Outbound, mitra profesional penyelenggara kegiatan outbound, team building, dan family gathering terbaik di area Kota Batu, Malang, dan sekitarnya."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section (Clean & Elegant Seperti Sebelumnya) -->
  <section class="py-16 sm:py-24 relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <span id="tk-eyebrow" class="text-xs font-bold uppercase tracking-widest text-amber-400">
        Profil &amp; Dedikasi Kami
      </span>
      <h1 id="tk-h1" class="font-heading font-black text-3xl sm:text-5xl uppercase tracking-[0.14em] text-white">
        TENTANG PROVIDER OUTBOUND
      </h1>
      <p id="tk-subheading" class="text-base sm:text-lg text-rose-100/85 max-w-3xl mx-auto leading-relaxed">
        Penyedia jasa outbound profesional dan fasilitator kegiatan luar ruang terbaik yang berakar di kawasan pegunungan sejuk Kota Batu, Kota Malang, dan sekitarnya.
      </p>
    </div>
  </section>

  <!-- Profil & Narasi Pendekatan Kerja -->
  <section class="py-12 border-t border-rose-900/40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 text-left text-rose-100/85 leading-relaxed text-sm sm:text-base">
      
      <!-- Narrative Card -->
      <div class="rounded-xl bg-[#480308]/60 border border-rose-700/30 p-7 sm:p-9 space-y-4 shadow-card">
        <h2 id="tk-narrative-title" class="font-heading font-black text-xl sm:text-2xl uppercase tracking-wider text-white">
          Penyelenggara Outbound Terbaik di Kota Batu, Malang &amp; Sekitarnya
        </h2>
        <p id="tk-narrative-p1" class="text-xs sm:text-sm text-rose-100/90 leading-relaxed">
          Sebagai provider outbound terbaik dan terpercaya di Kota Batu, Malang, dan sekitarnya, kami berfokus pada penyelenggaraan kegiatan luar ruang yang tidak hanya seru dan menyenangkan, tetapi juga memberikan dampak nyata bagi kekompakan tim, penyegaran mental, dan penguatan nilai-nilai positif organisasi.
        </p>
        <p id="tk-narrative-p2" class="text-xs sm:text-sm text-rose-100/90 leading-relaxed">
          Dengan memanfaatkan kekayaan alam pegunungan Kota Batu dan Malang—mulai dari teduhnya hutan pinus, hamparan rumput resort hijau, hingga aliran deras sungai arung jeram—setiap program dirancang secara adaptif dan terstruktur dengan metode <em>Experiential Learning</em> yang disesuaikan dengan kebutuhan instansi perusahaan, sekolah, maupun keluarga.
        </p>
      </div>

      <!-- Team Showcase Photo -->
      <div class="rounded-xl overflow-hidden border border-rose-700/40 shadow-xl bg-black/40">
        <img
          id="tk-team-img"
          src="/images/about/team-fasilitator.webp"
          alt="Tim Fasilitator dan Instruktur Provider Outbound Batu Malang"
          width="1200"
          height="675"
          class="w-full h-auto max-h-[460px] object-cover"
          loading="lazy"
        />
        <div class="p-3.5 bg-[#350206] text-center border-t border-rose-800/40">
          <p class="text-xs sm:text-sm text-rose-200/90 font-medium">
            <i class="fas fa-certificate text-amber-400 me-1.5"></i>
            Tim Fasilitator Lapangan Bersertifikasi BNSP &amp; Siaga P3K di Kota Wisata Batu &amp; Malang Raya
          </p>
        </div>
      </div>

      <!-- 4 Pillars of Excellence (Proporsional & Selaras Style Halaman Lain) -->
      <div class="space-y-4 pt-2">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-amber-400">
            Standar Mutu
          </span>
          <h3 class="font-heading font-black text-xl sm:text-2xl uppercase tracking-wider text-white mt-1">
            PILAR KEUNGGULAN LAYANAN KAMI
          </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Pilar 1 -->
          <div class="rounded-xl bg-[#480308]/60 border border-rose-700/30 p-6 flex flex-col justify-between hover:border-amber-400/50 transition-all duration-300 hover:-translate-y-1 shadow-card group">
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 font-heading font-black text-sm group-hover:bg-amber-500 group-hover:text-stone-950 transition-colors">
                01
              </div>
              <h4 id="tk-p1-title" class="font-heading font-black text-base uppercase tracking-wider text-white group-hover:text-amber-300 transition-colors">
                Keamanan Terpantau
              </h4>
              <p id="tk-p1-desc" class="text-xs text-rose-200/75 leading-relaxed">
                Peralatan safety standar CE/UIAA, briefing keselamatan sebelum kegiatan, serta persiapan jalur alternatif saat kondisi cuaca pegunungan berubah.
              </p>
            </div>
          </div>

          <!-- Pilar 2 -->
          <div class="rounded-xl bg-[#480308]/60 border border-rose-700/30 p-6 flex flex-col justify-between hover:border-amber-400/50 transition-all duration-300 hover:-translate-y-1 shadow-card group">
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 font-heading font-black text-sm group-hover:bg-amber-500 group-hover:text-stone-950 transition-colors">
                02
              </div>
              <h4 id="tk-p2-title" class="font-heading font-black text-base uppercase tracking-wider text-white group-hover:text-amber-300 transition-colors">
                Agenda Fleksibel
              </h4>
              <p id="tk-p2-desc" class="text-xs text-rose-200/75 leading-relaxed">
                Skenario aktivitas dapat disesuaikan dengan tema internal, kapasitas fisik peserta, serta durasi acara (half day, full day, atau gathering menginap).
              </p>
            </div>
          </div>

          <!-- Pilar 3 -->
          <div class="rounded-xl bg-[#480308]/60 border border-rose-700/30 p-6 flex flex-col justify-between hover:border-amber-400/50 transition-all duration-300 hover:-translate-y-1 shadow-card group">
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 font-heading font-black text-sm group-hover:bg-amber-500 group-hover:text-stone-950 transition-colors">
                03
              </div>
              <h4 id="tk-p3-title" class="font-heading font-black text-base uppercase tracking-wider text-white group-hover:text-amber-300 transition-colors">
                Fasilitator BNSP
              </h4>
              <p id="tk-p3-desc" class="text-xs text-rose-200/75 leading-relaxed">
                Instruktur dan master games berlisensi resmi yang berpengalaman memandu ice breaking dinamis dan sesi debriefing yang bermakna.
              </p>
            </div>
          </div>

          <!-- Pilar 4 -->
          <div class="rounded-xl bg-[#480308]/60 border border-rose-700/30 p-6 flex flex-col justify-between hover:border-amber-400/50 transition-all duration-300 hover:-translate-y-1 shadow-card group">
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 font-heading font-black text-sm group-hover:bg-amber-500 group-hover:text-stone-950 transition-colors">
                04
              </div>
              <h4 id="tk-p4-title" class="font-heading font-black text-base uppercase tracking-wider text-white group-hover:text-amber-300 transition-colors">
                Layanan All-In
              </h4>
              <p id="tk-p4-desc" class="text-xs text-rose-200/75 leading-relaxed">
                Bebas repot dengan penanganan menyeluruh: sewa lokasi, konsumsi katering prasmanan, sound system, hingga dokumentasi foto dan video.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Visi & Misi (2 Card Simetris & Seimbang) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
        <div class="rounded-xl bg-[#480308]/60 border border-rose-700/30 p-6 sm:p-7 space-y-3 shadow-card hover:border-amber-400/50 transition-all">
          <div class="flex items-center gap-2.5 border-b border-rose-800/40 pb-3">
            <i class="fas fa-eye text-amber-400 text-lg"></i>
            <h3 class="font-heading font-black text-lg uppercase tracking-wider text-white">
              Visi Kami
            </h3>
          </div>
          <p id="tk-visi" class="text-xs sm:text-sm text-rose-100/90 leading-relaxed">
            Menjadi penyelenggara kegiatan alam terbuka dan pelatihan kapasitas tim terdepan di Kota Batu, Malang Raya, dan Jawa Timur yang diakui karena profesionalisme, keselamatan, dan dampak positif bagi pengembangan karakter SDM.
          </p>
        </div>

        <div class="rounded-xl bg-[#480308]/60 border border-rose-700/30 p-6 sm:p-7 space-y-3 shadow-card hover:border-amber-400/50 transition-all">
          <div class="flex items-center gap-2.5 border-b border-rose-800/40 pb-3">
            <i class="fas fa-bullseye text-amber-400 text-lg"></i>
            <h3 class="font-heading font-black text-lg uppercase tracking-wider text-white">
              Misi Kami
            </h3>
          </div>
          <ul id="tk-misi-list" class="text-xs sm:text-sm text-rose-100/90 leading-relaxed space-y-2">
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-bold">•</span>
              <span>Menyajikan program simulasi team building yang bermakna, aplikatif, dan menyenangkan.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-bold">•</span>
              <span>Mengutamakan standar operasional keselamatan tinggi dalam setiap kegiatan petualangan luar ruang.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-bold">•</span>
              <span>Memberikan pelayanan ramah, responsif, dan transparan bagi seluruh mitra instansi dan komunitas.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Jangkauan Wilayah Operasional (3 Card Simetris) -->
      <div class="space-y-4 pt-2">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-amber-400">
            Area Layanan
          </span>
          <h3 class="font-heading font-black text-xl sm:text-2xl uppercase tracking-wider text-white mt-1">
            WILAYAH OPERASIONAL KAMI
          </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="rounded-xl bg-[#480308]/60 border border-rose-700/30 p-6 space-y-2.5 shadow-card hover:border-amber-400/50 transition-all">
            <h4 class="font-heading font-bold text-base text-white uppercase tracking-wider text-amber-400">
              Kota Wisata Batu
            </h4>
            <p class="text-xs text-rose-200/80 leading-relaxed">
              Pusat venue outbound pinus &amp; resort: Coban Rondo, Coban Rais, Coban Talun, Songgoriti, Payung Pinus, hingga bumi perkemahan sejuk Bumiaji.
            </p>
          </div>

          <div class="rounded-xl bg-[#480308]/60 border border-rose-700/30 p-6 space-y-2.5 shadow-card hover:border-amber-400/50 transition-all">
            <h4 class="font-heading font-bold text-base text-white uppercase tracking-wider text-amber-400">
              Kota &amp; Kab. Malang
            </h4>
            <p class="text-xs text-rose-200/80 leading-relaxed">
              Jalur petualangan arung jeram Kaliwatu &amp; Kasembon Rafting, Kebun Teh Wonosari Lawang, Coban Putri, hingga kawasan alam Dau dan Malang Selatan.
            </p>
          </div>

          <div class="rounded-xl bg-[#480308]/60 border border-rose-700/30 p-6 space-y-2.5 shadow-card hover:border-amber-400/50 transition-all">
            <h4 class="font-heading font-bold text-base text-white uppercase tracking-wider text-amber-400">
              Jawa Timur &amp; Sekitarnya
            </h4>
            <p class="text-xs text-rose-200/80 leading-relaxed">
              Ekspedisi Jeep 4x4 Taman Nasional Bromo Tengger Semeru, Air Terjun Tumpak Sewu, kawasan pinus Trawas &amp; Pacet Mojokerto, serta area kustom instansi.
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Mengapa Memilih Kami -->
  <WhyChooseUs />

  <!-- FAQ Section -->
  <FAQAccordion title="FAQ SEPUTAR TENTANG KAMI" />

  <!-- CTA Section -->
  <CTASection />

</PublicLayout>

<script is:inline>
  (function() {
    function hydrateTentangKami() {
      var raw = localStorage.getItem('vo_page_tentang_kami');
      if (!raw) return;
      try {
        var d = JSON.parse(raw);
        var eb = document.getElementById('tk-eyebrow');
        if (eb && d.eyebrow) eb.textContent = d.eyebrow;

        var h1 = document.getElementById('tk-h1');
        if (h1 && d.h1) h1.textContent = d.h1;

        var sub = document.getElementById('tk-subheading');
        if (sub && d.subheading) sub.textContent = d.subheading;

        var nt = document.getElementById('tk-narrative-title');
        if (nt && d.narrativeTitle) nt.textContent = d.narrativeTitle;

        var p1 = document.getElementById('tk-narrative-p1');
        if (p1 && d.narrativeP1) p1.textContent = d.narrativeP1;

        var p2 = document.getElementById('tk-narrative-p2');
        if (p2 && d.narrativeP2) p2.textContent = d.narrativeP2;

        var team = document.getElementById('tk-team-img');
        if (team && d.teamImg) team.src = d.teamImg;

        var p1t = document.getElementById('tk-p1-title');
        if (p1t && d.pilar1Title) p1t.textContent = d.pilar1Title;

        var p1d = document.getElementById('tk-p1-desc');
        if (p1d && d.pilar1Desc) p1d.textContent = d.pilar1Desc;

        var p2t = document.getElementById('tk-p2-title');
        if (p2t && d.pilar2Title) p2t.textContent = d.pilar2Title;

        var p2d = document.getElementById('tk-p2-desc');
        if (p2d && d.pilar2Desc) p2d.textContent = d.pilar2Desc;

        var p3t = document.getElementById('tk-p3-title');
        if (p3t && d.pilar3Title) p3t.textContent = d.pilar3Title;

        var p3d = document.getElementById('tk-p3-desc');
        if (p3d && d.pilar3Desc) p3d.textContent = d.pilar3Desc;

        var p4t = document.getElementById('tk-p4-title');
        if (p4t && d.pilar4Title) p4t.textContent = d.pilar4Title;

        var p4d = document.getElementById('tk-p4-desc');
        if (p4d && d.pilar4Desc) p4d.textContent = d.pilar4Desc;

        var visi = document.getElementById('tk-visi');
        if (visi && d.visi) visi.textContent = d.visi;

        var misiList = document.getElementById('tk-misi-list');
        if (misiList && d.misi) {
          var lines = d.misi.split('\n').filter(function(l) { return l.trim().length > 0; });
          if (lines.length > 0) {
            misiList.innerHTML = lines.map(function(line) {
              return '<li class="flex items-start gap-2"><span class="text-amber-400 font-bold">•</span><span>' + line.trim() + '</span></li>';
            }).join('');
          }
        }

        if (d.seoTitle) document.title = d.seoTitle;
        if (d.seoDesc) {
          var m = document.querySelector('meta[name="description"]');
          if (m) m.setAttribute('content', d.seoDesc);
        }
      } catch(e) {
        console.error('Tentang kami hydration error:', e);
      }
    }

    hydrateTentangKami();
    document.addEventListener('DOMContentLoaded', hydrateTentangKami);
    window.addEventListener('storage', function(e) {
      if (e.key === 'vo_page_tentang_kami') hydrateTentangKami();
    });
    window.addEventListener('vo_content_updated', function(e) {
      if (!e.detail || e.detail.key === 'vo_page_tentang_kami') hydrateTentangKami();
    });
  })();
</script>
