<script is:inline>
  (function() {
    function hydrateKontak() {
      var raw = localStorage.getItem('vo_page_kontak');
      if (!raw) return;
      try {
        var d = JSON.parse(raw);
        var eb = document.getElementById('kontak-eyebrow');
        if (eb && d.eyebrow) eb.textContent = d.eyebrow;

        var h1 = document.getElementById('kontak-h1');
        if (h1 && d.h1) h1.textContent = d.h1;

        var desc = document.getElementById('kontak-desc');
        if (desc && d.desc) desc.textContent = d.desc;

        var waDisp = document.getElementById('kontak-wa-disp');
        if (waDisp && d.waDisplay) waDisp.textContent = d.waDisplay;

        var areas = document.getElementById('kontak-service-areas');
        if (areas && d.address) areas.textContent = d.address;

        var hours = document.getElementById('kontak-operating-hours');
        if (hours && d.hours) hours.textContent = d.hours;

        var officeImg = document.getElementById('kontak-office-img');
        if (officeImg && d.officeImg) officeImg.src = d.officeImg;

        var waBtn = document.getElementById('kontak-wa-btn');
        if (waBtn && d.waNumber) {
          var clean = d.waNumber.replace(/[^0-9]/g, '');
          waBtn.href = 'https://wa.me/' + clean + '?text=Halo%20Vendor%20Outbound,%20saya%20ingin%20konsultasi%20langsung.';
        }

        if (d.seoTitle) document.title = d.seoTitle;
        if (d.seoDesc) {
          var m = document.querySelector('meta[name="description"]');
          if (m) m.setAttribute('content', d.seoDesc);
        }
      } catch(e) {
        console.error('Kontak hydration error:', e);
      }
    }

    hydrateKontak();
    document.addEventListener('DOMContentLoaded', hydrateKontak);
    window.addEventListener('storage', function(e) {
      if (e.key === 'vo_page_kontak') hydrateKontak();
    });
    window.addEventListener('vo_content_updated', function(e) {
      if (!e.detail || e.detail.key === 'vo_page_kontak') hydrateKontak();
    });
    try {
      var bc = new BroadcastChannel('vo_sync_channel');
      bc.onmessage = function(e) {
        if (!e.data || e.data.key === 'vo_page_kontak') hydrateKontak();
      };
    } catch(err) {}
  })();
</script>

<script>
  import { isSupabaseConfigured, supabase } from '../lib/supabase';

  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  const alertBox = document.getElementById('form-alert');
  const submitBtn = document.getElementById('submit-lead-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');

  if (form && alertBox && submitBtn && btnText && btnSpinner) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Check honeypot for spam bot prevention (PRD 8.7)
      const hp = (document.getElementById('lead_hp') as HTMLInputElement)?.value;
      if (hp) {
        console.warn('Spam submission detected');
        return;
      }

      // Prevent double submit
      submitBtn.disabled = true;
      btnSpinner.classList.remove('hidden');
      btnText.textContent = 'Menyimpan Permintaan...';

      const formData = new FormData(form);
      const leadData = {
        name: formData.get('name')?.toString() || '',
        organization: formData.get('organization')?.toString() || '',
        whatsapp: formData.get('whatsapp')?.toString() || '',
        email: formData.get('email')?.toString() || '',
        service_type: formData.get('service_type')?.toString() || '',
        participant_count: formData.get('participant_count') ? Number(formData.get('participant_count')) : null,
        event_date: formData.get('event_date')?.toString() || null,
        preferred_location: formData.get('preferred_location')?.toString() || '',
        message: formData.get('message')?.toString() || '',
        privacy_consent: formData.get('privacy_consent') === 'on',
        status: 'Baru',
        created_at: new Date().toISOString()
      };

      try {
        // Save to Supabase if configured
        if (isSupabaseConfigured && supabase) {
          const { error } = await supabase.from('leads').insert([leadData]);
          if (error) console.error('Supabase error:', error);
        }

        // Also save to LocalStorage leads cache so admin can review in browser right away
        const localLeads = JSON.parse(localStorage.getItem('vo_leads') || '[]');
        localLeads.unshift({ id: 'lead-' + Date.now(), ...leadData });
        localStorage.setItem('vo_leads', JSON.stringify(localLeads));

        // Show Success
        alertBox.className = 'p-4 rounded-lg text-xs font-bold bg-emerald-950/80 text-emerald-200 border border-emerald-500/50 block';
        alertBox.innerHTML = `
          <div class="flex items-center gap-2 mb-1 text-sm font-heading font-black text-emerald-400">
            ✓ Permintaan Berhasil Dikirim!
          </div>
          <p class="font-normal text-emerald-100">
            Terima kasih, <strong>${leadData.name}</strong>. Data konsultasi Anda telah tersimpan. Ingin terhubung lebih cepat? 
            <a href="https://wa.me/6282211221909?text=${encodeURIComponent(`Halo saya ${leadData.name}, telah mengisi form konsultasi untuk program ${leadData.service_type}.`)}" target="_blank" class="underline font-bold text-amber-300">Lanjutkan ke WhatsApp Resmi</a>.
          </p>
        `;

        form.reset();
      } catch (err) {
        console.error('Lead error:', err);
        alertBox.className = 'p-4 rounded-lg text-xs font-bold bg-rose-950 text-rose-200 border border-rose-600 block';
        alertBox.textContent = 'Terjadi kendala saat mengirim. Silakan langsung chat via WhatsApp kami: +62 822-1122-1909';
      } finally {
        submitBtn.disabled = false;
        btnSpinner.classList.add('hidden');
        btnText.textContent = 'Kirim Permintaan Konsultasi';
      }
    });
  }
</script>
