---
import PublicLayout from '../layouts/PublicLayout.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import CTASection from '../components/sections/CTASection.astro';
import { SITE_INFO } from '../data/defaultContent';
import { getWhatsAppUrl } from '../lib/utils';

const breadcrumbs = [
  { name: 'Kontak' }
];

const waDirectUrl = getWhatsAppUrl('Halo Provider Outbound, saya ingin konsultasi langsung kebutuhan outbound di Batu Malang.');

const socialMediaList = [
  {
    name: 'Instagram',
    handle: '@provideroutbound.id',
    url: 'https://instagram.com',
    icon: 'fab fa-instagram',
    tag: 'Dokumentasi Harian',
    accentColor: 'from-pink-500 via-rose-500 to-amber-500',
    borderColor: 'group-hover:border-pink-500/70',
    iconBg: 'bg-gradient-to-tr from-pink-600 to-rose-500 text-white shadow-pink-500/20',
    desc: 'Update harian foto keseruan outbound, highlight reels, dan tips persiapan gathering tim di Batu Malang.',
    btnText: 'Buka Instagram',
    btnClass: 'bg-gradient-to-r from-pink-600 to-rose-600 hover:from-pink-500 hover:to-rose-500 text-white border border-pink-400/30 shadow-pink-950/40'
  },
  {
    name: 'TikTok',
    handle: '@provideroutbound',
    url: 'https://tiktok.com',
    icon: 'fab fa-tiktok',
    tag: 'Video Pendek Viral',
    accentColor: 'from-cyan-400 to-rose-500',
    borderColor: 'group-hover:border-cyan-400/70',
    iconBg: 'bg-stone-900 border border-cyan-400/50 text-cyan-300 shadow-cyan-500/20',
    desc: 'Cuplikan video seru ice breaking, simulasi game kocak, serta aksi menantang offroad dan arung jeram.',
    btnText: 'Buka TikTok',
    btnClass: 'bg-stone-900 hover:bg-stone-850 text-cyan-300 border border-cyan-400/50 hover:border-cyan-300 shadow-cyan-950/40'
  },
  {
    name: 'Facebook',
    handle: 'Provider Outbound Batu Malang',
    url: 'https://facebook.com',
    icon: 'fab fa-facebook-f',
    tag: 'Komunitas & Event',
    accentColor: 'from-blue-600 to-blue-400',
    borderColor: 'group-hover:border-blue-500/70',
    iconBg: 'bg-blue-600 text-white shadow-blue-500/20',
    desc: 'Album foto kegiatan per instansi, testimoni korporat, ulasan venue, dan artikel panduan outbound.',
    btnText: 'Buka Facebook',
    btnClass: 'bg-blue-600 hover:bg-blue-500 text-white border border-blue-400/30 shadow-blue-950/40'
  },
  {
    name: 'X (Twitter)',
    handle: '@provideroutbound',
    url: 'https://x.com',
    icon: 'fab fa-x-twitter',
    tag: 'Update Kilat & Info',
    accentColor: 'from-stone-300 to-stone-500',
    borderColor: 'group-hover:border-stone-400/70',
    iconBg: 'bg-stone-900 border border-white/20 text-white shadow-white/10',
    desc: 'Update kilat kondisi cuaca Kota Batu, info ketersediaan slot venue, dan tips outbound singkat.',
    btnText: 'Buka Akun X',
    btnClass: 'bg-stone-900 hover:bg-stone-850 text-white border border-stone-600 hover:border-stone-400 shadow-stone-950/40'
  },
  {
    name: 'YouTube',
    handle: 'Provider Outbound Official',
    url: 'https://youtube.com',
    icon: 'fab fa-youtube',
    tag: 'Aftermovie 4K HD',
    accentColor: 'from-red-600 to-red-500',
    borderColor: 'group-hover:border-red-500/70',
    iconBg: 'bg-red-600 text-white shadow-red-500/20',
    desc: 'Aftermovie sinematik resolusi tinggi 4K, profil perusahaan, dan video eksplorasi venue pegunungan.',
    btnText: 'Buka YouTube',
    btnClass: 'bg-red-600 hover:bg-red-500 text-white border border-red-400/30 shadow-red-950/40'
  }
];
---

<PublicLayout
  title="Kontak & Konsultasi Outbound Batu Malang | Provider Outbound"
  description="Hubungi Provider Outbound untuk konsultasi dan perencanaan kegiatan outbound korporat, gathering keluarga, dan petualangan di Batu Malang."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section -->
  <section class="py-16 sm:py-24 relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <span id="kontak-eyebrow" class="text-xs font-bold uppercase tracking-widest text-amber-400">
        Layanan Pelanggan
      </span>
      <h1 id="kontak-h1" class="font-heading font-black text-3xl sm:text-5xl uppercase tracking-[0.14em] text-white">
        KONTAK &amp; KONSULTASI
      </h1>
      <p id="kontak-desc" class="text-base sm:text-lg text-rose-100/85 max-w-3xl mx-auto leading-relaxed">
        Diskusikan rancangan kegiatan, pilihan lokasi pegunungan di Batu & Malang, dan penawaran program yang tepat untuk tim Anda.
      </p>
    </div>
  </section>

  <!-- Contact Form & Info Section -->
  <section class="py-12 border-t border-rose-900/40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Left: Form Konsultasi (PRD 8.7) -->
      <div class="lg:col-span-7">
        <div class="rounded-2xl bg-[#480308]/70 border border-rose-700/40 p-6 sm:p-10 shadow-2xl space-y-6">
          <div class="space-y-1 text-left">
            <h2 class="font-heading font-black text-xl sm:text-2xl uppercase tracking-wider text-white">
              Formulir Permintaan Konsultasi
            </h2>
            <p class="text-xs text-rose-200/80">
              Isi data di bawah ini. Tim kami akan segera menanggapi melalui WhatsApp resmi.
            </p>
          </div>

          <!-- Alert Notification -->
          <div id="form-alert" class="hidden p-4 rounded-lg text-xs font-bold"></div>

          <form id="lead-form" class="space-y-4 text-left">
            <!-- Honeypot Field for Spam Protection (PRD 8.7) -->
            <div class="hidden" aria-hidden="true">
              <label for="lead_hp">Jangan isi field ini:</label>
              <input type="text" id="lead_hp" name="website_url_hp" tabindex="-1" autocomplete="off" />
            </div>

            <!-- Nama Lengkap -->
            <div>
              <label for="name" class="block text-xs font-bold uppercase tracking-wider text-rose-200 mb-1.5">
                Nama Lengkap <span class="text-amber-400">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                placeholder="Contoh: Budi Santoso"
                class="w-full px-4 py-3 rounded-lg bg-stone-950/60 border border-rose-800/50 text-white placeholder-rose-300/40 text-sm focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400"
              />
            </div>

            <!-- Nama Instansi / Perusahaan -->
            <div>
              <label for="organization" class="block text-xs font-bold uppercase tracking-wider text-rose-200 mb-1.5">
                Nama Perusahaan / Komunitas / Sekolah (Opsional)
              </label>
              <input
                type="text"
                id="organization"
                name="organization"
                autocomplete="organization"
                placeholder="Contoh: PT Nusantara Maju"
                class="w-full px-4 py-3 rounded-lg bg-stone-950/60 border border-rose-800/50 text-white placeholder-rose-300/40 text-sm focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400"
              />
            </div>

            <!-- WhatsApp & Email Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="whatsapp" class="block text-xs font-bold uppercase tracking-wider text-rose-200 mb-1.5">
                  Nomor WhatsApp <span class="text-amber-400">*</span>
                </label>
                <input
                  type="tel"
                  id="whatsapp"
                  name="whatsapp"
                  required
                  inputmode="tel"
                  autocomplete="tel"
                  placeholder="Contoh: 081234567890"
                  class="w-full px-4 py-3 rounded-lg bg-stone-950/60 border border-rose-800/50 text-white placeholder-rose-300/40 text-sm focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-bold uppercase tracking-wider text-rose-200 mb-1.5">
                  Alamat Email (Opsional)
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  inputmode="email"
                  autocomplete="email"
                  placeholder="budi@example.com"
                  class="w-full px-4 py-3 rounded-lg bg-stone-950/60 border border-rose-800/50 text-white placeholder-rose-300/40 text-sm focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400"
                />
              </div>
            </div>

            <!-- Jenis Layanan -->
            <div>
              <label for="service_type" class="block text-xs font-bold uppercase tracking-wider text-rose-200 mb-1.5">
                Kebutuhan Program <span class="text-amber-400">*</span>
              </label>
              <select
                id="service_type"
                name="service_type"
                required
                class="w-full px-4 py-3 rounded-lg bg-[#2B0104] border border-rose-800/50 text-white text-sm focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400"
              >
                <option value="Outbound Perusahaan">Outbound Perusahaan & Team Building</option>
                <option value="Family Gathering">Family Gathering Perusahaan / Komunitas</option>
                <option value="Outbound Sekolah">Outbound Sekolah & LDKS Pelajar</option>
                <option value="Wisata & Adventure">Wisata Adventure (Rafting, Offroad 4x4, Camping)</option>
                <option value="Lainnya">Kebutuhan Program Kustom Lainnya</option>
              </select>
            </div>

            <!-- Peserta, Tanggal & Lokasi Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label for="participant_count" class="block text-xs font-bold uppercase tracking-wider text-rose-200 mb-1.5">
                  Est. Peserta (Orang)
                </label>
                <input
                  type="number"
                  id="participant_count"
                  name="participant_count"
                  min="5"
                  placeholder="50"
                  class="w-full px-4 py-3 rounded-lg bg-stone-950/60 border border-rose-800/50 text-white placeholder-rose-300/40 text-sm focus:outline-none focus:border-amber-400"
                />
              </div>

              <div>
                <label for="event_date" class="block text-xs font-bold uppercase tracking-wider text-rose-200 mb-1.5">
                  Rencana Tanggal
                </label>
                <input
                  type="date"
                  id="event_date"
                  name="event_date"
                  class="w-full px-4 py-3 rounded-lg bg-stone-950/60 border border-rose-800/50 text-white text-sm focus:outline-none focus:border-amber-400"
                />
              </div>

              <div>
                <label for="preferred_location" class="block text-xs font-bold uppercase tracking-wider text-rose-200 mb-1.5">
                  Area Pilihan
                </label>
                <input
                  type="text"
                  id="preferred_location"
                  name="preferred_location"
                  placeholder="Kota Batu / Malang"
                  class="w-full px-4 py-3 rounded-lg bg-stone-950/60 border border-rose-800/50 text-white placeholder-rose-300/40 text-sm focus:outline-none focus:border-amber-400"
                />
              </div>
            </div>

            <!-- Pesan / Kebutuhan Khusus -->
            <div>
              <label for="message" class="block text-xs font-bold uppercase tracking-wider text-rose-200 mb-1.5">
                Pesan &amp; Kebutuhan Khusus <span class="text-amber-400">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="4"
                placeholder="Jelaskan kebutuhan acara, target kegiatan, atau fasilitas khusus yang diharapkan..."
                class="w-full px-4 py-3 rounded-lg bg-stone-950/60 border border-rose-800/50 text-white placeholder-rose-300/40 text-sm focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400"
              ></textarea>
            </div>

            <!-- Privacy Consent Checkbox (PRD 8.7 & 14) -->
            <div class="flex items-start gap-2.5 pt-2">
              <input
                type="checkbox"
                id="privacy_consent"
                name="privacy_consent"
                required
                checked
                class="mt-1 w-4 h-4 rounded bg-stone-950 border-rose-700 text-amber-500 focus:ring-amber-400"
              />
              <label for="privacy_consent" class="text-xs text-rose-200/80 leading-snug">
                Saya menyetujui pemrosesan data di atas untuk keperluan komunikasi dan konsultasi program outbound sesuai <a href="/kebijakan-privasi" target="_blank" class="text-amber-400 underline">Kebijakan Privasi</a>.
              </label>
            </div>

            <!-- Submit Button -->
            <button
              id="submit-lead-btn"
              type="submit"
              class="w-full py-4 rounded-md bg-amber-500 hover:bg-amber-400 text-stone-950 font-heading font-black text-xs uppercase tracking-wider shadow-glow-amber transition-all duration-200 flex items-center justify-center gap-2"
            >
              <span id="btn-text">Kirim Permintaan Konsultasi</span>
              <svg id="btn-spinner" class="w-4 h-4 animate-spin hidden" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
              </svg>
            </button>
          </form>
        </div>
      </div>

      <!-- Right: Official Contact Info -->
      <div class="lg:col-span-5 space-y-6 text-left">
        
        <!-- WhatsApp Callout -->
        <div class="rounded-2xl bg-gradient-to-br from-emerald-950/70 to-emerald-900/40 border-2 border-emerald-500/40 p-6 sm:p-8 space-y-4 shadow-xl">
          <div class="w-13 h-13 sm:w-14 sm:h-14 rounded-2xl bg-emerald-500 text-white flex items-center justify-center shadow-lg shadow-emerald-500/30">
            <svg class="w-7 h-7 sm:w-8 sm:h-8 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </div>

          <h3 class="font-heading font-black text-xl text-white uppercase tracking-wider">
            WhatsApp Resmi
          </h3>
          <p class="text-xs text-emerald-100/80 leading-relaxed">
            Butuh penawaran kilat atau diskusi langsung via chat? Hubungi fasilitator kami di:
          </p>
          <div id="kontak-wa-disp" class="text-2xl font-heading font-black text-amber-300">
            {SITE_INFO.whatsappDisplay}
          </div>

          <a
            id="kontak-wa-btn"
            href={waDirectUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-5 py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-stone-950 font-heading font-black text-xs uppercase tracking-wider transition-all shadow-md hover:scale-[1.02]"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Buka WhatsApp Sekarang</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <!-- Service Area Card -->
        <div class="rounded-xl bg-[#450308]/60 border border-rose-700/35 p-6 space-y-3">
          <h4 class="font-heading font-bold text-sm text-amber-400 uppercase tracking-wider">
            Wilayah Operasional Utama
          </h4>
          <p id="kontak-service-areas" class="text-xs text-rose-100/85 leading-relaxed">
            {SITE_INFO.serviceAreas}. Kami melayani kegiatan di kawasan hutan pinus, resort outbound, rafting Kaliwatu &amp; Kasembon, serta area camping ground Batu Malang.
          </p>
        </div>

        <!-- Operating Hours Card -->
        <div class="rounded-xl bg-[#450308]/60 border border-rose-700/35 p-6 space-y-3">
          <h4 class="font-heading font-bold text-sm text-amber-400 uppercase tracking-wider">
            Jam Layanan Konsultasi
          </h4>
          <p class="text-xs text-rose-100/85 leading-relaxed">
            Setiap hari: <span id="kontak-operating-hours" class="font-bold text-white">{SITE_INFO.operatingHours}</span>. Permintaan yang masuk di luar jam layanan akan ditindaklanjuti pada pagi hari berikutnya.
          </p>
        </div>

        <!-- Basecamp & Office Card -->
        <div class="rounded-xl bg-[#450308]/60 border border-rose-700/35 p-6 space-y-3">
          <h4 class="font-heading font-bold text-sm text-amber-400 uppercase tracking-wider flex items-center gap-2">
            <i class="fas fa-map-marked-alt text-amber-400"></i>
            <span>Kantor &amp; Basecamp Lapangan</span>
          </h4>
          <p id="kontak-office-desc" class="text-xs text-rose-100/85 leading-relaxed">
            Jl. Raya Oro-Oro Ombo No. 9, Bumiaji, Kota Wisata Batu, Jawa Timur 65316. Tersedia area parkir luas dan ruang diskusi koordinasi teknis agenda kegiatan.
          </p>
          <div class="overflow-hidden rounded-lg border border-rose-800/40">
            <img
              id="kontak-office-img"
              src="/images/gallery/gallery-4.webp"
              alt="Basecamp Provider Outbound Batu Malang"
              class="w-full h-32 sm:h-36 object-cover hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- DEDICATED SOCIAL MEDIA CARDS SECTION (INSTAGRAM, TIKTOK, FACEBOOK, X, YOUTUBE) -->
  <section class="py-16 sm:py-20 relative bg-brand-950/50 border-t border-rose-900/40" id="media-sosial-resmi">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <!-- Section Header -->
      <div class="text-center space-y-3 max-w-3xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-400 bg-amber-500/10 px-3.5 py-1 rounded-full border border-amber-400/20 inline-flex items-center gap-2">
          <i class="fas fa-hashtag text-[11px]"></i> Kanal Resmi Media Sosial
        </span>
        <h2 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl uppercase tracking-wider text-white">
          TERHUBUNG DI MEDIA SOSIAL RESMI
        </h2>
        <p class="text-xs sm:text-sm text-rose-200/80 leading-relaxed">
          Ikuti media sosial Provider Outbound untuk melihat dokumentasi video real-time, recap keseruan games peserta, tips team building, dan update promo paket gathering di Batu Malang.
        </p>
      </div>

      <!-- 5 Social Media Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
        {socialMediaList.map((soc) => (
          <div class={`rounded-2xl bg-[#480308]/75 border border-rose-700/40 ${soc.borderColor} p-5 sm:p-6 flex flex-col justify-between shadow-card hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 group text-left relative overflow-hidden`}>
            
            <!-- Top Gradient Accent Line -->
            <div class={`absolute top-0 left-0 right-0 h-1 bg-gradient-to-r ${soc.accentColor}`}></div>

            <div class="space-y-4">
              <!-- Header with Icon & Tag -->
              <div class="flex items-center justify-between">
                <div class={`w-12 h-12 rounded-xl flex items-center justify-center text-xl shadow-lg ${soc.iconBg} group-hover:scale-110 transition-transform`}>
                  <i class={soc.icon}></i>
                </div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-amber-300/90 bg-stone-900/60 px-2 py-0.5 rounded border border-rose-800/40">
                  {soc.tag}
                </span>
              </div>

              <!-- Title & Handle -->
              <div>
                <h3 class="font-heading font-black text-lg text-white uppercase tracking-wider group-hover:text-amber-400 transition-colors">
                  {soc.name}
                </h3>
                <span class="text-xs font-mono font-medium text-amber-400/90 block mt-0.5 truncate">
                  {soc.handle}
                </span>
              </div>

              <!-- Description -->
              <p class="text-xs text-rose-200/80 leading-relaxed line-clamp-3 min-h-[56px]">
                {soc.desc}
              </p>
            </div>

