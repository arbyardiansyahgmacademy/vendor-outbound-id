---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { SERVICES, PACKAGES, GALLERY_ITEMS, BLOG_POSTS } from '../../data/defaultContent';
---

<AdminLayout title="Ringkasan Dashboard">
  <div class="space-y-8 text-left">
    
    <!-- Welcome Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-rose-900/40">
      <div>
        <h1 class="font-heading font-black text-2xl sm:text-3xl uppercase tracking-wider text-white flex items-center gap-2.5">
          <i class="fas fa-chart-pie text-amber-400"></i>
          <span>DASHBOARD RINGKASAN</span>
        </h1>
        <p class="text-xs sm:text-sm text-rose-300/80 mt-1">
          Pusat kendali konten, katalog paket pilihan, galeri dokumentasi, artikel, dan leads konsultasi Vendor Outbound Batu Malang.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/profil"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-brand-900/70 hover:bg-brand-800 text-rose-200 hover:text-white text-xs font-bold border border-rose-700/50 transition-colors"
        >
          <i class="fas fa-user-cog text-amber-400"></i>
          <span>Profil Admin</span>
        </a>
        <a
          href="/admin/leads"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold text-xs uppercase tracking-wider transition-all shadow"
        >
          <i class="fas fa-inbox"></i>
          <span>Cek Leads Baru</span>
        </a>
      </div>
    </div>

    <!-- Stats Grid (Aligned with Frontend) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      
      <!-- Layanan Aktif -->
      <a href="/admin/layanan" class="rounded-xl bg-[#3D0308]/80 hover:bg-[#48050B] border border-rose-700/40 hover:border-amber-400/50 p-5 space-y-2 transition-all group block shadow-card">
        <div class="flex items-center justify-between">
          <div class="text-[11px] uppercase font-bold text-rose-300/80 tracking-wider">Layanan Utama</div>
          <i class="fas fa-briefcase text-amber-400 group-hover:scale-110 transition-transform"></i>
        </div>
        <div class="font-heading font-black text-3xl text-white">
          {SERVICES.length}
        </div>
        <div class="text-[11px] text-emerald-400 font-semibold flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>4 Kategori Layanan Aktif</span>
        </div>
      </a>

      <!-- Paket Pilihan Outbound -->
      <a href="/admin/paket" class="rounded-xl bg-[#3D0308]/80 hover:bg-[#48050B] border border-rose-700/40 hover:border-amber-400/50 p-5 space-y-2 transition-all group block shadow-card">
        <div class="flex items-center justify-between">
          <div class="text-[11px] uppercase font-bold text-rose-300/80 tracking-wider">Paket Pilihan</div>
          <i class="fas fa-box-open text-amber-400 group-hover:scale-110 transition-transform"></i>
        </div>
        <div class="font-heading font-black text-3xl text-amber-400">
          {PACKAGES.length}
        </div>
        <div class="text-[11px] text-rose-300/80">Corporate, Gathering &amp; Adventure</div>
      </a>

      <!-- Foto Galeri Dokumentasi -->
      <a href="/admin/galeri" class="rounded-xl bg-[#3D0308]/80 hover:bg-[#48050B] border border-rose-700/40 hover:border-amber-400/50 p-5 space-y-2 transition-all group block shadow-card">
        <div class="flex items-center justify-between">
          <div class="text-[11px] uppercase font-bold text-rose-300/80 tracking-wider">Galeri Foto</div>
          <i class="fas fa-camera text-amber-400 group-hover:scale-110 transition-transform"></i>
        </div>
        <div class="font-heading font-black text-3xl text-white">
          {GALLERY_ITEMS.length}
        </div>
        <div class="text-[11px] text-emerald-400 font-semibold">WebP Asli (&lt; 100 KB)</div>
      </a>

      <!-- Artikel Blog -->
      <a href="/admin/blog" class="rounded-xl bg-[#3D0308]/80 hover:bg-[#48050B] border border-rose-700/40 hover:border-amber-400/50 p-5 space-y-2 transition-all group block shadow-card">
        <div class="flex items-center justify-between">
          <div class="text-[11px] uppercase font-bold text-rose-300/80 tracking-wider">Artikel &amp; Tips</div>
          <i class="fas fa-feather-alt text-amber-400 group-hover:scale-110 transition-transform"></i>
        </div>
        <div class="font-heading font-black text-3xl text-amber-400">
          {BLOG_POSTS.length}
        </div>
        <div class="text-[11px] text-emerald-400 font-semibold">Author: Arby Ardiansyah</div>
      </a>

    </div>

    <!-- Quick Action Shortcuts (Aligned with New Multi-Page CRUD Structure) -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="font-heading font-bold text-sm uppercase tracking-wider text-amber-400 flex items-center gap-2">
          <i class="fas fa-th-large"></i>
          <span>Akses Cepat Pengelolaan Halaman &amp; Konten</span>
        </h2>
        <a href="/admin/halaman" class="text-xs text-rose-300 hover:text-amber-400 transition-colors">
          Lihat Semua Halaman →
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        
        <a
          href="/admin/halaman/beranda"
          class="p-4 rounded-xl bg-[#330206] border border-rose-800/40 hover:border-amber-400/60 hover:bg-[#400308] transition-all text-center space-y-2 group shadow-md"
        >
          <div class="w-10 h-10 rounded-lg bg-amber-500/10 text-amber-400 mx-auto flex items-center justify-center font-bold group-hover:bg-amber-500 group-hover:text-stone-950 transition-colors">
            <i class="fas fa-home text-base"></i>
          </div>
          <div class="text-xs font-bold text-white uppercase tracking-wider">Edit Beranda</div>
          <div class="text-[10px] text-rose-300/70">Hero &amp; Our Services</div>
        </a>

        <a
          href="/admin/layanan"
          class="p-4 rounded-xl bg-[#330206] border border-rose-800/40 hover:border-amber-400/60 hover:bg-[#400308] transition-all text-center space-y-2 group shadow-md"
        >
          <div class="w-10 h-10 rounded-lg bg-amber-500/10 text-amber-400 mx-auto flex items-center justify-center font-bold group-hover:bg-amber-500 group-hover:text-stone-950 transition-colors">
            <i class="fas fa-briefcase text-base"></i>
          </div>
          <div class="text-xs font-bold text-white uppercase tracking-wider">Kelola Layanan</div>
          <div class="text-[10px] text-rose-300/70">4 Modul Layanan</div>
        </a>

        <a
          href="/admin/paket"
          class="p-4 rounded-xl bg-[#330206] border border-rose-800/40 hover:border-amber-400/60 hover:bg-[#400308] transition-all text-center space-y-2 group shadow-md"
        >
          <div class="w-10 h-10 rounded-lg bg-amber-500/10 text-amber-400 mx-auto flex items-center justify-center font-bold group-hover:bg-amber-500 group-hover:text-stone-950 transition-colors">
            <i class="fas fa-box-open text-base"></i>
          </div>
          <div class="text-xs font-bold text-white uppercase tracking-wider">Paket Pilihan</div>
          <div class="text-[10px] text-rose-300/70">16 Paket Outbound</div>
        </a>

        <a
          href="/admin/galeri"
          class="p-4 rounded-xl bg-[#330206] border border-rose-800/40 hover:border-amber-400/60 hover:bg-[#400308] transition-all text-center space-y-2 group shadow-md"
        >
          <div class="w-10 h-10 rounded-lg bg-amber-500/10 text-amber-400 mx-auto flex items-center justify-center font-bold group-hover:bg-amber-500 group-hover:text-stone-950 transition-colors">
            <i class="fas fa-camera text-base"></i>
          </div>
          <div class="text-xs font-bold text-white uppercase tracking-wider">Upload Galeri</div>
          <div class="text-[10px] text-rose-300/70">Target &lt; 100 KB WebP</div>
        </a>

        <a
          href="/admin/halaman/tentang-kami"
          class="p-4 rounded-xl bg-[#330206] border border-rose-800/40 hover:border-amber-400/60 hover:bg-[#400308] transition-all text-center space-y-2 group shadow-md"
        >
          <div class="w-10 h-10 rounded-lg bg-amber-500/10 text-amber-400 mx-auto flex items-center justify-center font-bold group-hover:bg-amber-500 group-hover:text-stone-950 transition-colors">
            <i class="fas fa-users text-base"></i>
          </div>
          <div class="text-xs font-bold text-white uppercase tracking-wider">Tentang Kami</div>
          <div class="text-[10px] text-rose-300/70">Profil &amp; Tim Fasilitator</div>
        </a>

        <a
          href="/admin/halaman/kontak"
          class="p-4 rounded-xl bg-[#330206] border border-rose-800/40 hover:border-amber-400/60 hover:bg-[#400308] transition-all text-center space-y-2 group shadow-md"
        >
          <div class="w-10 h-10 rounded-lg bg-amber-500/10 text-amber-400 mx-auto flex items-center justify-center font-bold group-hover:bg-amber-500 group-hover:text-stone-950 transition-colors">
            <i class="fas fa-phone-alt text-base"></i>
          </div>
          <div class="text-xs font-bold text-white uppercase tracking-wider">Halaman Kontak</div>
          <div class="text-[10px] text-rose-300/70">WhatsApp &amp; Alamat Batu</div>
        </a>

        <a
          href="/admin/blog"
          class="p-4 rounded-xl bg-[#330206] border border-rose-800/40 hover:border-amber-400/60 hover:bg-[#400308] transition-all text-center space-y-2 group shadow-md"
        >
          <div class="w-10 h-10 rounded-lg bg-amber-500/10 text-amber-400 mx-auto flex items-center justify-center font-bold group-hover:bg-amber-500 group-hover:text-stone-950 transition-colors">
            <i class="fas fa-feather-alt text-base"></i>
          </div>
          <div class="text-xs font-bold text-white uppercase tracking-wider">Artikel Blog</div>
          <div class="text-[10px] text-rose-300/70">Edukasi &amp; Tips Outbound</div>
        </a>

        <a
          href="/admin/profil"
          class="p-4 rounded-xl bg-[#330206] border border-rose-800/40 hover:border-amber-400/60 hover:bg-[#400308] transition-all text-center space-y-2 group shadow-md"
        >
          <div class="w-10 h-10 rounded-lg bg-amber-500/10 text-amber-400 mx-auto flex items-center justify-center font-bold group-hover:bg-amber-500 group-hover:text-stone-950 transition-colors">
            <i class="fas fa-user-shield text-base"></i>
          </div>
          <div class="text-xs font-bold text-white uppercase tracking-wider">Profil Admin</div>
          <div class="text-[10px] text-rose-300/70">Nama, Foto &amp; Sandi</div>
        </a>

      </div>
    </div>

    <!-- Leads Masuk Terkini Preview -->
    <div class="rounded-2xl bg-[#300205]/80 border border-rose-700/40 p-6 space-y-4 shadow-xl">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="font-heading font-black text-lg uppercase tracking-wider text-white flex items-center gap-2">
            <i class="fas fa-inbox text-amber-400"></i>
            <span>Leads Konsultasi Masuk Terbaru</span>
          </h2>
          <p class="text-xs text-rose-300/80">Permintaan penawaran terbaru dari formulir website</p>
        </div>
        <a href="/admin/leads" class="text-xs font-bold text-amber-400 hover:underline">
          Lihat Semua Leads →
        </a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left">
          <thead class="text-[10px] uppercase font-bold text-rose-300/70 border-b border-rose-900/50">
            <tr>
              <th class="py-2.5 px-3">Nama Pengirim</th>
              <th class="py-2.5 px-3">WhatsApp</th>
              <th class="py-2.5 px-3">Program Layanan</th>
              <th class="py-2.5 px-3">Peserta</th>
              <th class="py-2.5 px-3">Status</th>
              <th class="py-2.5 px-3 text-right">Tindakan</th>
            </tr>
          </thead>
          <tbody id="dashboard-leads-tbody" class="divide-y divide-rose-900/30 text-rose-100">
            <!-- Populated via script -->
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <script>
    import { DEFAULT_LEADS } from '../../lib/adminStore';

    const tbody = document.getElementById('dashboard-leads-tbody');
    if (tbody) {
      const stored = localStorage.getItem('vo_leads');
      const leads = stored ? JSON.parse(stored) : DEFAULT_LEADS;

      if (leads.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="py-4 text-center text-rose-400">Belum ada leads masuk.</td></tr>`;
      } else {
        tbody.innerHTML = leads.slice(0, 5).map((l: any) => `
          <tr class="hover:bg-rose-950/40 transition-colors">
            <td class="py-3 px-3 font-semibold text-white">${l.name}</td>
            <td class="py-3 px-3 text-amber-300 font-mono">${l.whatsapp}</td>
            <td class="py-3 px-3">${l.service_type}</td>
            <td class="py-3 px-3">${l.participant_count ? l.participant_count + ' org' : '-'}</td>
            <td class="py-3 px-3">
              <span class="px-2 py-0.5 rounded text-[10px] font-bold ${
                l.status === 'Baru' ? 'bg-amber-500/20 text-amber-300 border border-amber-400/30' : 'bg-emerald-500/20 text-emerald-300'
              }">${l.status}</span>
            </td>
            <td class="py-3 px-3 text-right">
              <a href="https://wa.me/${l.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`Halo ${l.name}, kami dari Vendor Outbound Batu Malang ingin menindaklanjuti konsultasi kegiatan Anda.`)}" target="_blank" class="px-2.5 py-1 rounded bg-emerald-600 text-white font-bold text-[10px] hover:bg-emerald-500 inline-flex items-center gap-1 shadow">
                <i class="fab fa-whatsapp"></i>
                <span>Chat WA</span>
              </a>
            </td>
          </tr>
        `).join('');
      }
    }
  </script>
</AdminLayout>
