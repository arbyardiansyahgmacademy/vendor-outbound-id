---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Editor Halaman Kebijakan & Syarat">
  <div class="space-y-8 text-left max-w-4xl">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-rose-900/40">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <a href="/admin/halaman" class="text-xs text-amber-400 hover:underline">← Master Halaman</a>
          <span class="text-xs text-rose-400">/</span>
          <span class="text-xs text-rose-300">Editor Legalitas</span>
        </div>
        <h1 class="font-heading font-black text-2xl uppercase tracking-wider text-white flex items-center gap-2">
          <i class="fas fa-balance-scale text-amber-400"></i>
          <span>EDITOR KEBIJAKAN PRIVASI &amp; SYARAT KETENTUAN</span>
        </h1>
        <p class="text-xs text-rose-300/80 mt-1">
          Kelola ketentuan layanan outbound, klausul pemesanan, kebijakan perlindungan data, dan hak cipta.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/kebijakan-privasi"
          target="_blank"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-brand-900/70 hover:bg-brand-800 text-rose-200 hover:text-white text-xs font-bold border border-rose-700/50"
        >
          <i class="fas fa-shield-alt"></i>
          <span>Privasi</span>
        </a>
        <a
          href="/syarat-ketentuan"
          target="_blank"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-brand-900/70 hover:bg-brand-800 text-rose-200 hover:text-white text-xs font-bold border border-rose-700/50"
        >
          <i class="fas fa-file-contract"></i>
          <span>Syarat</span>
        </a>
      </div>
    </div>

    <!-- Alert Box -->
    <div id="legal-alert" class="hidden p-3 rounded-lg text-xs font-bold transition-all"></div>

    <form id="legal-editor-form" class="space-y-8">
      
      <!-- Section 1: Kebijakan Privasi -->
      <div class="rounded-xl bg-[#330206] border border-rose-700/40 p-6 space-y-4 shadow-xl">
        <div class="flex items-center justify-between border-b border-rose-900/50 pb-2">
          <h2 class="font-heading font-bold text-base uppercase text-amber-400 tracking-wider flex items-center gap-2">
            <i class="fas fa-user-secret"></i>
            <span>01. Halaman Kebijakan Privasi (/kebijakan-privasi)</span>
          </h2>
          <span class="text-[10px] uppercase font-bold text-rose-400/80 tracking-widest">Privasi Data</span>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-rose-200 mb-1">
            Judul Halaman
          </label>
          <input
            type="text"
            id="l-privasi-title"
            class="w-full px-3.5 py-2.5 rounded-lg bg-stone-950/70 border border-rose-800/60 text-white text-xs focus:outline-none focus:border-amber-400 font-bold"
            value="KEBIJAKAN PRIVASI"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-rose-200 mb-1">
            Isi Klausul Kebijakan Privasi (Data Pribadi & Perlindungan Pengguna)
          </label>
          <textarea
            id="l-privasi-content"
            rows="6"
            class="w-full px-3.5 py-2.5 rounded-lg bg-stone-950/70 border border-rose-800/60 text-white text-xs font-mono focus:outline-none focus:border-amber-400 leading-relaxed"
          >Vendor Outbound menghargai privasi Anda dan berkomitmen melindungi informasi pribadi yang Anda berikan melalui formulir konsultasi website vendoroutbound.id. Data berupa nama instansi, nomor WhatsApp, estimasi peserta, dan pesan hanya digunakan untuk keperluan perancangan paket kegiatan dan koordinasi penawaran resmi. Kami tidak pernah membagikan atau menjual data Anda kepada pihak ketiga.</textarea>
        </div>
      </div>

      <!-- Section 2: Syarat & Ketentuan Layanan -->
      <div class="rounded-xl bg-[#330206] border border-rose-700/40 p-6 space-y-4 shadow-xl">
        <div class="flex items-center justify-between border-b border-rose-900/50 pb-2">
          <h2 class="font-heading font-bold text-base uppercase text-amber-400 tracking-wider flex items-center gap-2">
            <i class="fas fa-file-signature"></i>
            <span>02. Halaman Syarat &amp; Ketentuan (/syarat-ketentuan)</span>
          </h2>
          <span class="text-[10px] uppercase font-bold text-rose-400/80 tracking-widest">Ketentuan Acara</span>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-rose-200 mb-1">
            Judul Halaman
          </label>
          <input
            type="text"
            id="l-syarat-title"
            class="w-full px-3.5 py-2.5 rounded-lg bg-stone-950/70 border border-rose-800/60 text-white text-xs focus:outline-none focus:border-amber-400 font-bold"
            value="SYARAT & KETENTUAN LAYANAN"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-rose-200 mb-1">
            Isi Klausul Pemesanan, Pembayaran DP, & Keamanan di Lapangan
          </label>
          <textarea
            id="l-syarat-content"
            rows="6"
            class="w-full px-3.5 py-2.5 rounded-lg bg-stone-950/70 border border-rose-800/60 text-white text-xs font-mono focus:outline-none focus:border-amber-400 leading-relaxed"
          >1. Konfirmasi Kegiatan: Pemesanan tanggal kegiatan outbound dinyatakan resmi setelah penandatanganan Surat Perjanjian Kerja (SPK) atau persetujuan proposal penawaran serta pembayaran uang muka (DP).
2. Keselamatan & SOP: Peserta wajib mematuhi seluruh instruksi fasilitator dan standar operasional prosedur (SOP) keselamatan selama kegiatan outbound, rafting, offroad, atau camping.
3. Rencana Cadangan (Contingency Plan): Apabila terjadi perubahan cuaca ekstrim di kawasan Batu Malang, fasilitator berhak mengalihkan simulasi ke modul semi-indoor tanpa mengurangi esensi pembelajaran dan keselamatan peserta.</textarea>
        </div>
      </div>

      <!-- Submit Bar -->
      <div class="flex items-center justify-between pt-4 border-t border-rose-900/50">
        <span class="text-xs text-rose-300/80">
          Status: Sinkronisasi instan ke basis data
        </span>
        <button
          type="submit"
          class="px-6 py-3 rounded-lg bg-amber-500 hover:bg-amber-400 text-stone-950 font-heading font-black text-xs uppercase tracking-wider shadow-lg transition-all hover:scale-105 flex items-center gap-2"
        >
          <i class="fas fa-save"></i>
          <span>Simpan Ketentuan Legal</span>
        </button>
      </div>

    </form>

  </div>

  <script>
    const form = document.getElementById('legal-editor-form') as HTMLFormElement | null;
    const alertBox = document.getElementById('legal-alert');
    const STORAGE_KEY = 'vo_page_legal';

    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      try {
        const d = JSON.parse(saved);
        if (d.privasiTitle) (document.getElementById('l-privasi-title') as HTMLInputElement).value = d.privasiTitle;
        if (d.privasiContent) (document.getElementById('l-privasi-content') as HTMLTextAreaElement).value = d.privasiContent;
        if (d.syaratTitle) (document.getElementById('l-syarat-title') as HTMLInputElement).value = d.syaratTitle;
        if (d.syaratContent) (document.getElementById('l-syarat-content') as HTMLTextAreaElement).value = d.syaratContent;
      } catch (e) {
        console.error(e);
      }
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const payload = {
        privasiTitle: (document.getElementById('l-privasi-title') as HTMLInputElement).value,
        privasiContent: (document.getElementById('l-privasi-content') as HTMLTextAreaElement).value,
        syaratTitle: (document.getElementById('l-syarat-title') as HTMLInputElement).value,
        syaratContent: (document.getElementById('l-syarat-content') as HTMLTextAreaElement).value,
        updatedAt: new Date().toISOString()
      };

      localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));

      if (alertBox) {
        alertBox.className = 'p-3 rounded-lg text-xs font-bold bg-emerald-950 text-emerald-200 border border-emerald-500 block';
        alertBox.textContent = '✓ Seluruh konten Kebijakan Privasi & Syarat Ketentuan berhasil disimpan!';
        setTimeout(() => alertBox.classList.add('hidden'), 3500);
      }
    });
  </script>
</AdminLayout>
