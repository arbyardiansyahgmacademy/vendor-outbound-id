---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { SITE_INFO } from '../../../data/defaultContent';
---

<AdminLayout title="Editor Halaman Tentang Kami (Section-to-Section)">
  <div class="space-y-8 text-left max-w-5xl">
    
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#235347]">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <a href="/admin/halaman" class="text-xs text-[#DAF1DE] hover:underline">← Master Halaman</a>
          <span class="text-xs text-[#235347]">/</span>
          <span class="text-xs text-[#8EB69B]">Editor Tentang Kami</span>
        </div>
        <h1 class="font-heading font-black text-2xl uppercase tracking-wider text-white flex items-center gap-2">
          <i class="fas fa-users text-[#8EB69B]"></i>
          <span>EDITOR SECTION-TO-SECTION TENTANG KAMI</span>
        </h1>
        <p class="text-xs text-[#8EB69B] mt-1">
          Kelola Head SEO, Hero Section, Narasi Profil, Foto Tim, 4 Pilar Mutu, dan Visi Misi lengkap dengan kontrol gambar di setiap section.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/tentang-kami"
          target="_blank"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-xs font-bold border border-[#235347] transition-all hover:scale-105"
        >
          <i class="fas fa-external-link-alt"></i>
          <span>Buka Halaman Live</span>
        </a>
      </div>
    </div>

    <!-- Alert Box -->
    <div id="tentang-alert" class="hidden p-3 rounded-lg text-xs font-bold transition-all shadow-md"></div>

    <form id="tentang-editor-form" class="space-y-8">
      
      <!-- Section 1: Head & SEO Meta -->
      <div class="rounded-xl bg-[#0B2B26] border border-[#235347] p-6 space-y-4 shadow-xl">
        <div class="flex items-center justify-between border-b border-[#235347] pb-3">
          <h2 class="font-heading font-bold text-base uppercase text-[#DAF1DE] tracking-wider flex items-center gap-2">
            <span>01.</span>
            <span>Pengaturan Head &amp; Meta SEO Tentang Kami</span>
          </h2>
          <span class="text-[10px] uppercase font-bold text-[#8EB69B] tracking-widest">SEO Meta</span>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            SEO Title (Tag &lt;title&gt;)
          </label>
          <input
            type="text"
            id="t-seo-title"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
            value="Tentang Kami | Provider Outbound Batu Malang"
          />
        </div>

        <!-- SEO Social Share OG Image Control -->
        <div class="p-3.5 rounded-lg bg-[#051F20] border border-[#235347] space-y-2">
          <div class="flex items-center justify-between">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B]">
              Social Share Image (OG Image 1200x630)
            </label>
            <span class="text-[10px] text-[#8EB69B]/70">URL / Upload / Preset</span>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
            <div class="w-16 h-12 rounded-lg bg-[#0B2B26] border border-[#235347] overflow-hidden flex-shrink-0 flex items-center justify-center">
              <img id="t-seo-og-preview" src="/images/about/team-fasilitator.webp" alt="OG Preview" class="w-full h-full object-cover" />
            </div>

            <div class="flex-1 w-full space-y-1.5">
              <div class="flex gap-2">
                <input
                  type="text"
                  id="t-seo-og"
                  data-preview="t-seo-og-preview"
                  class="img-ctrl-input flex-1 px-3 py-1.5 rounded-lg bg-[#0B2B26] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
                  value="/images/about/team-fasilitator.webp"
                />
                <label class="btn-img-upload px-3 py-1.5 rounded-lg bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-xs font-bold border border-[#235347] cursor-pointer flex items-center gap-1.5 transition-all">
                  <i class="fas fa-upload text-[11px]"></i>
                  <span>Upload</span>
                  <input type="file" accept="image/*" class="hidden img-ctrl-file" data-input="t-seo-og" data-preview="t-seo-og-preview" />
                </label>
              </div>

              <div class="flex flex-wrap items-center gap-1.5 text-[10px]">
                <span class="text-[#8EB69B]">Preset:</span>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="t-seo-og" data-preview="t-seo-og-preview" data-val="/images/about/team-fasilitator.webp">Tim Fasilitator</button>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="t-seo-og" data-preview="t-seo-og-preview" data-val="/images/hero/hero-outbound.webp">Hero Outbound</button>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="t-seo-og" data-preview="t-seo-og-preview" data-val="/images/hero-bromo-sunrise.webp">Bromo Sunrise</button>
              </div>
            </div>
          </div>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            SEO Meta Description
          </label>
          <textarea
            id="t-seo-desc"
            rows="2"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
          >Mengenal Provider Outbound, mitra profesional penyelenggara kegiatan outbound, team building, dan family gathering di area Batu & Malang, Jawa Timur.</textarea>
        </div>
      </div>

      <!-- Section 2: Hero Header -->
      <div class="rounded-xl bg-[#0B2B26] border border-[#235347] p-6 space-y-4 shadow-xl">
        <div class="flex items-center justify-between border-b border-[#235347] pb-3">
          <h2 class="font-heading font-bold text-base uppercase text-[#DAF1DE] tracking-wider flex items-center gap-2">
            <span>02.</span>
            <span>Section Hero Header Tentang Kami</span>
          </h2>
          <span class="text-[10px] uppercase font-bold text-[#8EB69B] tracking-widest">Hero Section</span>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Eyebrow Badge
          </label>
          <input
            type="text"
            id="t-eyebrow"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
            value="Profil & Dedikasi Kami"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Judul Utama Halaman (H1)
          </label>
          <input
            type="text"
            id="t-h1"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B] font-bold"
            value="TENTANG PROVIDER OUTBOUND"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Subjudul / Paragraf Pengantar Singkat
          </label>
          <textarea
            id="t-subheading"
            rows="2"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
          >Penyedia jasa outbound profesional dan fasilitator kegiatan luar ruang terbaik yang berakar di kawasan pegunungan sejuk Kota Batu, Kota Malang, dan sekitarnya.</textarea>
        </div>

        <!-- Hero Background Banner Image Control -->
        <div class="p-3.5 rounded-lg bg-[#051F20] border border-[#235347] space-y-2">
          <div class="flex items-center justify-between">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B]">
              Gambar Latar / Banner Hero Tentang Kami
            </label>
            <span class="text-[10px] text-[#8EB69B]/70">URL / Upload / Preset</span>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
            <div class="w-16 h-12 rounded-lg bg-[#0B2B26] border border-[#235347] overflow-hidden flex-shrink-0 flex items-center justify-center">
              <img id="t-hero-bg-preview" src="/images/hero/hero-outbound.webp" alt="Hero BG Preview" class="w-full h-full object-cover" />
            </div>

            <div class="flex-1 w-full space-y-1.5">
              <div class="flex gap-2">
                <input
                  type="text"
                  id="t-hero-bg"
                  data-preview="t-hero-bg-preview"
                  class="img-ctrl-input flex-1 px-3 py-1.5 rounded-lg bg-[#0B2B26] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
                  value="/images/hero/hero-outbound.webp"
                />
                <label class="btn-img-upload px-3 py-1.5 rounded-lg bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-xs font-bold border border-[#235347] cursor-pointer flex items-center gap-1.5 transition-all">
                  <i class="fas fa-upload text-[11px]"></i>
                  <span>Upload</span>
                  <input type="file" accept="image/*" class="hidden img-ctrl-file" data-input="t-hero-bg" data-preview="t-hero-bg-preview" />
                </label>
              </div>

              <div class="flex flex-wrap items-center gap-1.5 text-[10px]">
                <span class="text-[#8EB69B]">Preset:</span>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="t-hero-bg" data-preview="t-hero-bg-preview" data-val="/images/hero/hero-outbound.webp">Hero Outbound</button>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="t-hero-bg" data-preview="t-hero-bg-preview" data-val="/images/hero-bromo-sunrise.webp">Gunung Bromo</button>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="t-hero-bg" data-preview="t-hero-bg-preview" data-val="/images/destinasi/coban-rondo.webp">Coban Rondo</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 3: Narasi Profil & Foto Tim Fasilitator -->
      <div class="rounded-xl bg-[#0B2B26] border border-[#235347] p-6 space-y-4 shadow-xl">
        <div class="flex items-center justify-between border-b border-[#235347] pb-3">
          <h2 class="font-heading font-bold text-base uppercase text-[#DAF1DE] tracking-wider flex items-center gap-2">
            <span>03.</span>
            <span>Narasi Profil &amp; Foto Tim Fasilitator</span>
          </h2>
          <span class="text-[10px] uppercase font-bold text-[#8EB69B] tracking-widest">Kisah Brand</span>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Heading Narasi
          </label>
          <input
            type="text"
            id="t-narrative-title"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B] font-bold"
            value="Penyelenggara Outbound Terbaik di Kota Batu, Malang & Sekitarnya"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Paragraf 1: Nilai & Misi Outbound
          </label>
          <textarea
            id="t-narrative-p1"
            rows="3"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
          >Sebagai provider outbound terbaik dan terpercaya di Kota Batu, Malang, dan sekitarnya, kami berfokus pada penyelenggaraan kegiatan luar ruang yang tidak hanya seru dan menyenangkan, tetapi juga memberikan dampak nyata bagi kekompakan tim, penyegaran mental, dan penguatan nilai-nilai positif organisasi.</textarea>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Paragraf 2: Pemanfaatan Alam Pegunungan Batu Malang
          </label>
          <textarea
            id="t-narrative-p2"
            rows="3"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
          >Dengan memanfaatkan kekayaan alam pegunungan Kota Batu dan Malang—mulai dari teduhnya hutan pinus, hamparan rumput resort hijau, hingga aliran deras sungai arung jeram—setiap program dirancang secara adaptif dan terstruktur dengan metode Experiential Learning yang disesuaikan dengan kebutuhan instansi perusahaan, sekolah, maupun keluarga.</textarea>
        </div>

        <!-- Foto Tim Fasilitator Image Control -->
        <div class="p-3.5 rounded-lg bg-[#051F20] border border-[#235347] space-y-2">
          <div class="flex items-center justify-between">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B]">
              Foto Tim Fasilitator Lapangan Resmi
            </label>
            <span class="text-[10px] text-[#8EB69B]/70">URL / Upload / Preset</span>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
            <div class="w-16 h-12 rounded-lg bg-[#0B2B26] border border-[#235347] overflow-hidden flex-shrink-0 flex items-center justify-center">
              <img id="t-team-img-preview" src="/images/about/team-fasilitator.webp" alt="Foto Tim Preview" class="w-full h-full object-cover" />
            </div>

            <div class="flex-1 w-full space-y-1.5">
              <div class="flex gap-2">
                <input
                  type="text"
                  id="t-team-img"
                  data-preview="t-team-img-preview"
                  class="img-ctrl-input flex-1 px-3 py-1.5 rounded-lg bg-[#0B2B26] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
                  value="/images/about/team-fasilitator.webp"
                />
                <label class="btn-img-upload px-3 py-1.5 rounded-lg bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-xs font-bold border border-[#235347] cursor-pointer flex items-center gap-1.5 transition-all">
                  <i class="fas fa-upload text-[11px]"></i>
                  <span>Upload</span>
                  <input type="file" accept="image/*" class="hidden img-ctrl-file" data-input="t-team-img" data-preview="t-team-img-preview" />
                </label>
              </div>

              <div class="flex flex-wrap items-center gap-1.5 text-[10px]">
                <span class="text-[#8EB69B]">Preset:</span>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="t-team-img" data-preview="t-team-img-preview" data-val="/images/about/team-fasilitator.webp">Tim Fasilitator</button>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="t-team-img" data-preview="t-team-img-preview" data-val="/images/gallery/gallery-1.webp">Galeri 1</button>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="t-team-img" data-preview="t-team-img-preview" data-val="/images/gallery/gallery-2.webp">Galeri 2</button>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="t-team-img" data-preview="t-team-img-preview" data-val="/images/gallery/gallery-3.webp">Galeri 3</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 4: 4 Pilar Mutu / Keunggulan -->
      <div class="rounded-xl bg-[#0B2B26] border border-[#235347] p-6 space-y-4 shadow-xl">
        <div class="flex items-center justify-between border-b border-[#235347] pb-3">
          <h2 class="font-heading font-bold text-base uppercase text-[#DAF1DE] tracking-wider flex items-center gap-2">
            <span>04.</span>
            <span>4 Pilar Mutu &amp; Dedikasi Provider Outbound</span>
          </h2>
          <span class="text-[10px] uppercase font-bold text-[#8EB69B] tracking-widest">4 Keunggulan</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-2 p-3.5 rounded-lg bg-[#051F20] border border-[#235347]">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#DAF1DE]">Pilar 1: Instruktur BNSP</label>
            <input type="text" id="t-pilar1-title" class="w-full px-3 py-1.5 rounded bg-[#0B2B26] border border-[#235347] text-white text-xs font-bold" value="Keamanan Terpantau" />
            <textarea id="t-pilar1-desc" rows="2" class="w-full px-3 py-1.5 rounded bg-[#0B2B26] border border-[#235347] text-white text-xs">Peralatan safety standar CE/UIAA, briefing keselamatan sebelum kegiatan, serta persiapan jalur alternatif saat kondisi cuaca pegunungan berubah.</textarea>
          </div>

          <div class="space-y-2 p-3.5 rounded-lg bg-[#051F20] border border-[#235347]">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#DAF1DE]">Pilar 2: Agenda Fleksibel</label>
            <input type="text" id="t-pilar2-title" class="w-full px-3 py-1.5 rounded bg-[#0B2B26] border border-[#235347] text-white text-xs font-bold" value="Agenda Fleksibel" />
            <textarea id="t-pilar2-desc" rows="2" class="w-full px-3 py-1.5 rounded bg-[#0B2B26] border border-[#235347] text-white text-xs">Skenario aktivitas dapat disesuaikan dengan tema internal, kapasitas fisik peserta, serta durasi acara (half day, full day, atau gathering menginap).</textarea>
          </div>

          <div class="space-y-2 p-3.5 rounded-lg bg-[#051F20] border border-[#235347]">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#DAF1DE]">Pilar 3: Fasilitator BNSP</label>
            <input type="text" id="t-pilar3-title" class="w-full px-3 py-1.5 rounded bg-[#0B2B26] border border-[#235347] text-white text-xs font-bold" value="Fasilitator BNSP" />
            <textarea id="t-pilar3-desc" rows="2" class="w-full px-3 py-1.5 rounded bg-[#0B2B26] border border-[#235347] text-white text-xs">Instruktur dan master games berlisensi resmi yang berpengalaman memandu ice breaking dinamis dan sesi debriefing yang bermakna.</textarea>
          </div>

          <div class="space-y-2 p-3.5 rounded-lg bg-[#051F20] border border-[#235347]">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#DAF1DE]">Pilar 4: Layanan All-In</label>
            <input type="text" id="t-pilar4-title" class="w-full px-3 py-1.5 rounded bg-[#0B2B26] border border-[#235347] text-white text-xs font-bold" value="Layanan All-In" />
            <textarea id="t-pilar4-desc" rows="2" class="w-full px-3 py-1.5 rounded bg-[#0B2B26] border border-[#235347] text-white text-xs">Bebas repot dengan penanganan menyeluruh: sewa lokasi, konsumsi katering prasmanan, sound system, hingga dokumentasi foto dan video.</textarea>
          </div>
        </div>

        <!-- Pilar Mutu Visual Image Control -->
        <div class="p-3.5 rounded-lg bg-[#051F20] border border-[#235347] space-y-2">
          <div class="flex items-center justify-between">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B]">
              Badge / Icon Mutu Pilar Layanan
            </label>
            <span class="text-[10px] text-[#8EB69B]/70">URL / Upload / Preset</span>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
            <div class="w-16 h-12 rounded-lg bg-[#0B2B26] border border-[#235347] overflow-hidden flex-shrink-0 flex items-center justify-center">
              <img id="t-pilar-img-preview" src="/images/logo/logo-provider-outbound.webp" alt="Pilar Preview" class="w-full h-full object-cover" />
            </div>

            <div class="flex-1 w-full space-y-1.5">
              <div class="flex gap-2">
                <input
                  type="text"
                  id="t-pilar-img"
                  data-preview="t-pilar-img-preview"
                  class="img-ctrl-input flex-1 px-3 py-1.5 rounded-lg bg-[#0B2B26] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
                  value="/images/logo/logo-provider-outbound.webp"
                />
                <label class="btn-img-upload px-3 py-1.5 rounded-lg bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-xs font-bold border border-[#235347] cursor-pointer flex items-center gap-1.5 transition-all">
                  <i class="fas fa-upload text-[11px]"></i>
                  <span>Upload</span>
                  <input type="file" accept="image/*" class="hidden img-ctrl-file" data-input="t-pilar-img" data-preview="t-pilar-img-preview" />
                </label>
              </div>

              <div class="flex flex-wrap items-center gap-1.5 text-[10px]">
                <span class="text-[#8EB69B]">Preset:</span>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="t-pilar-img" data-preview="t-pilar-img-preview" data-val="/images/logo/logo-provider-outbound.webp">Logo Badge</button>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="t-pilar-img" data-preview="t-pilar-img-preview" data-val="/images/services/team-building.webp">Team Building</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 5: Visi & Misi -->
      <div class="rounded-xl bg-[#0B2B26] border border-[#235347] p-6 space-y-4 shadow-xl">
        <div class="flex items-center justify-between border-b border-[#235347] pb-3">
          <h2 class="font-heading font-bold text-base uppercase text-[#DAF1DE] tracking-wider flex items-center gap-2">
            <span>05.</span>
            <span>Visi &amp; Misi Organisasi</span>
          </h2>
          <span class="text-[10px] uppercase font-bold text-[#8EB69B] tracking-widest">Visi Misi</span>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Visi Utama
          </label>
          <textarea
            id="t-visi"
            rows="2"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
          >Menjadi penyelenggara kegiatan alam terbuka dan pelatihan kapasitas tim terdepan di Kota Batu, Malang Raya, dan Jawa Timur yang diakui karena profesionalisme, keselamatan, dan dampak positif bagi pengembangan karakter SDM.</textarea>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Poin Misi (Pisahkan per baris baru)
          </label>
          <textarea
            id="t-misi"
            rows="4"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
          >Menyajikan program simulasi team building yang bermakna, aplikatif, dan menyenangkan.
Mengutamakan standar operasional keselamatan tinggi dalam setiap kegiatan petualangan luar ruang.
Memberikan pelayanan ramah, responsif, dan transparan bagi seluruh mitra instansi dan komunitas.</textarea>
        </div>

        <!-- Visi Misi Visual Illustration Image Control -->
        <div class="p-3.5 rounded-lg bg-[#051F20] border border-[#235347] space-y-2">
          <div class="flex items-center justify-between">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B]">
              Gambar Visual / Ilustrasi Visi Misi
            </label>
            <span class="text-[10px] text-[#8EB69B]/70">URL / Upload / Preset</span>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
            <div class="w-16 h-12 rounded-lg bg-[#0B2B26] border border-[#235347] overflow-hidden flex-shrink-0 flex items-center justify-center">
              <img id="t-visimisi-img-preview" src="/images/services/gathering.webp" alt="Visi Misi Preview" class="w-full h-full object-cover" />
            </div>

            <div class="flex-1 w-full space-y-1.5">
              <div class="flex gap-2">
                <input
                  type="text"
                  id="t-visimisi-img"
                  data-preview="t-visimisi-img-preview"
                  class="img-ctrl-input flex-1 px-3 py-1.5 rounded-lg bg-[#0B2B26] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
                  value="/images/services/gathering.webp"
                />
                <label class="btn-img-upload px-3 py-1.5 rounded-lg bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-xs font-bold border border-[#235347] cursor-pointer flex items-center gap-1.5 transition-all">
                  <i class="fas fa-upload text-[11px]"></i>
                  <span>Upload</span>
                  <input type="file" accept="image/*" class="hidden img-ctrl-file" data-input="t-visimisi-img" data-preview="t-visimisi-img-preview" />
                </label>
              </div>

              <div class="flex flex-wrap items-center gap-1.5 text-[10px]">
                <span class="text-[#8EB69B]">Preset:</span>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="t-visimisi-img" data-preview="t-visimisi-img-preview" data-val="/images/services/gathering.webp">Gathering</button>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="t-visimisi-img" data-preview="t-visimisi-img-preview" data-val="/images/hero/hero-outbound.webp">Hero Outbound</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Button Submit Bar -->
      <div class="sticky bottom-4 z-30 flex items-center justify-between p-4 rounded-xl bg-[#0B2B26]/95 border-2 border-[#8EB69B]/40 shadow-2xl backdrop-blur-md">
        <div class="text-xs text-[#8EB69B] hidden sm:block">
          <i class="fas fa-check-circle text-[#DAF1DE] mr-1"></i>
          <span>Perubahan tersimpan ke LocalStorage &amp; Cloud Database Supabase</span>
        </div>

        <button
          type="submit"
          class="w-full sm:w-auto px-7 py-3.5 rounded-lg bg-[#DAF1DE] hover:bg-white text-[#051F20] font-heading font-black text-xs uppercase tracking-wider shadow-glow-mint transition-all hover:scale-105 flex items-center justify-center gap-2"
        >
          <i class="fas fa-save text-sm"></i>
          <span>Simpan Perubahan Tentang Kami</span>
        </button>
      </div>

    </form>

  </div>

  <script>
    import { syncPageToSupabase, syncSiteSettingsToSupabase } from '../../../lib/supabaseSync';

    const form = document.getElementById('tentang-editor-form') as HTMLFormElement | null;
    const alertBox = document.getElementById('tentang-alert');
    const STORAGE_KEY = 'vo_page_tentang_kami';

    // Generic Controller for Image Inputs, File Pickers, and Presets
    function initImageControls() {
      // 1. Text input onchange updates preview
      document.querySelectorAll<HTMLInputElement>('.img-ctrl-input').forEach((input) => {
        const prevId = input.getAttribute('data-preview');
        if (prevId) {
          const prev = document.getElementById(prevId) as HTMLImageElement;
          input.addEventListener('input', () => {
            if (prev) prev.src = input.value || '';
          });
        }
      });

      // 2. Upload button triggers file picker
      document.querySelectorAll<HTMLElement>('.btn-img-upload').forEach((label) => {
        label.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).tagName !== 'INPUT') {
            const fileInput = label.querySelector<HTMLInputElement>('.img-ctrl-file');
            fileInput?.click();
          }
        });
      });

      // 3. File picker onchange converts to DataURL and updates input & preview
      document.querySelectorAll<HTMLInputElement>('.img-ctrl-file').forEach((fileInput) => {
        fileInput.addEventListener('change', () => {
          const file = fileInput.files?.[0];
          if (file) {
            const inputId = fileInput.getAttribute('data-input');
            const prevId = fileInput.getAttribute('data-preview');
            const reader = new FileReader();
            reader.onload = (e) => {
              const res = e.target?.result as string;
              if (inputId) {
                const inp = document.getElementById(inputId) as HTMLInputElement;
                if (inp) inp.value = res;
              }
              if (prevId) {
                const prev = document.getElementById(prevId) as HTMLImageElement;
                if (prev) prev.src = res;
              }
            };
            reader.readAsDataURL(file);
          }
        });
      });

      // 4. Presets buttons
      document.querySelectorAll<HTMLButtonElement>('.btn-img-preset').forEach((btn) => {
        btn.addEventListener('click', () => {
          const inputId = btn.getAttribute('data-input');
          const prevId = btn.getAttribute('data-preview');
          const val = btn.getAttribute('data-val');
          if (val) {
            if (inputId) {
              const inp = document.getElementById(inputId) as HTMLInputElement;
              if (inp) inp.value = val;
            }
            if (prevId) {
              const prev = document.getElementById(prevId) as HTMLImageElement;
              if (prev) prev.src = val;
            }
          }
        });
      });
    }

    function setFieldAndPreview(inputId: string, prevId: string, val: string) {
      const inp = document.getElementById(inputId) as HTMLInputElement;
      if (inp) inp.value = val;
      const prev = document.getElementById(prevId) as HTMLImageElement;
      if (prev && val) prev.src = val;
    }

    initImageControls();

    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      try {
        const d = JSON.parse(saved);
        if (d.seoTitle) (document.getElementById('t-seo-title') as HTMLInputElement).value = d.seoTitle;
        if (d.seoOg) setFieldAndPreview('t-seo-og', 't-seo-og-preview', d.seoOg);
        if (d.seoDesc) (document.getElementById('t-seo-desc') as HTMLTextAreaElement).value = d.seoDesc;

        if (d.eyebrow) (document.getElementById('t-eyebrow') as HTMLInputElement).value = d.eyebrow;
        if (d.h1) (document.getElementById('t-h1') as HTMLInputElement).value = d.h1;
        if (d.subheading) (document.getElementById('t-subheading') as HTMLTextAreaElement).value = d.subheading;
        if (d.heroBg) setFieldAndPreview('t-hero-bg', 't-hero-bg-preview', d.heroBg);

        if (d.narrativeTitle) (document.getElementById('t-narrative-title') as HTMLInputElement).value = d.narrativeTitle;
        if (d.narrativeP1) (document.getElementById('t-narrative-p1') as HTMLTextAreaElement).value = d.narrativeP1;
        if (d.narrativeP2) (document.getElementById('t-narrative-p2') as HTMLTextAreaElement).value = d.narrativeP2;
        if (d.teamImg) setFieldAndPreview('t-team-img', 't-team-img-preview', d.teamImg);

        if (d.pilar1Title) (document.getElementById('t-pilar1-title') as HTMLInputElement).value = d.pilar1Title;
        if (d.pilar1Desc) (document.getElementById('t-pilar1-desc') as HTMLTextAreaElement).value = d.pilar1Desc;
        if (d.pilar2Title) (document.getElementById('t-pilar2-title') as HTMLInputElement).value = d.pilar2Title;
        if (d.pilar2Desc) (document.getElementById('t-pilar2-desc') as HTMLTextAreaElement).value = d.pilar2Desc;
        if (d.pilar3Title) (document.getElementById('t-pilar3-title') as HTMLInputElement).value = d.pilar3Title;
        if (d.pilar3Desc) (document.getElementById('t-pilar3-desc') as HTMLTextAreaElement).value = d.pilar3Desc;
        if (d.pilar4Title) (document.getElementById('t-pilar4-title') as HTMLInputElement).value = d.pilar4Title;
        if (d.pilar4Desc) (document.getElementById('t-pilar4-desc') as HTMLTextAreaElement).value = d.pilar4Desc;
        if (d.pilarImg) setFieldAndPreview('t-pilar-img', 't-pilar-img-preview', d.pilarImg);

        if (d.visi) (document.getElementById('t-visi') as HTMLTextAreaElement).value = d.visi;
        if (d.misi) (document.getElementById('t-misi') as HTMLTextAreaElement).value = d.misi;
        if (d.visimisiImg) setFieldAndPreview('t-visimisi-img', 't-visimisi-img-preview', d.visimisiImg);
      } catch (e) {
        console.error(e);
      }
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const payload = {
        seoTitle: (document.getElementById('t-seo-title') as HTMLInputElement).value,
        seoOg: (document.getElementById('t-seo-og') as HTMLInputElement).value,
        seoDesc: (document.getElementById('t-seo-desc') as HTMLTextAreaElement).value,

        eyebrow: (document.getElementById('t-eyebrow') as HTMLInputElement).value,
        h1: (document.getElementById('t-h1') as HTMLInputElement).value,
        subheading: (document.getElementById('t-subheading') as HTMLTextAreaElement).value,
        heroBg: (document.getElementById('t-hero-bg') as HTMLInputElement).value,

        narrativeTitle: (document.getElementById('t-narrative-title') as HTMLInputElement).value,
        narrativeP1: (document.getElementById('t-narrative-p1') as HTMLTextAreaElement).value,
        narrativeP2: (document.getElementById('t-narrative-p2') as HTMLTextAreaElement).value,
        teamImg: (document.getElementById('t-team-img') as HTMLInputElement).value,

        pilar1Title: (document.getElementById('t-pilar1-title') as HTMLInputElement).value,
        pilar1Desc: (document.getElementById('t-pilar1-desc') as HTMLTextAreaElement).value,
        pilar2Title: (document.getElementById('t-pilar2-title') as HTMLInputElement).value,
        pilar2Desc: (document.getElementById('t-pilar2-desc') as HTMLTextAreaElement).value,
        pilar3Title: (document.getElementById('t-pilar3-title') as HTMLInputElement).value,
        pilar3Desc: (document.getElementById('t-pilar3-desc') as HTMLTextAreaElement).value,
        pilar4Title: (document.getElementById('t-pilar4-title') as HTMLInputElement).value,
        pilar4Desc: (document.getElementById('t-pilar4-desc') as HTMLTextAreaElement).value,
        pilarImg: (document.getElementById('t-pilar-img') as HTMLInputElement).value,

        visi: (document.getElementById('t-visi') as HTMLTextAreaElement).value,
        misi: (document.getElementById('t-misi') as HTMLTextAreaElement).value,
        visimisiImg: (document.getElementById('t-visimisi-img') as HTMLInputElement).value,

        updatedAt: new Date().toISOString()
      };

      localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
      window.dispatchEvent(new CustomEvent('vo_content_updated', { detail: { key: STORAGE_KEY, data: payload } }));
      window.dispatchEvent(new Event('storage'));

      try {
        const bc = new BroadcastChannel('vo_sync_channel');
        bc.postMessage({ type: 'VO_UPDATED', key: STORAGE_KEY, data: payload });
      } catch (err) {}

      // Sync to Supabase directly
      await syncPageToSupabase('/tentang-kami', 'Tentang Kami', payload, 'standard', {
        seoTitle: payload.seoTitle,
        seoDesc: payload.seoDesc,
        ogImage: payload.seoOg
      });
      await syncSiteSettingsToSupabase('tentang_kami', payload);

      if (alertBox) {
        alertBox.className = 'p-3 rounded-lg text-xs font-bold bg-[#163832] text-[#DAF1DE] border border-[#235347] block shadow-glow-mint';
        alertBox.textContent = '✓ Seluruh section & gambar Halaman Tentang Kami berhasil tersimpan & tersinkron ke Cloud Supabase!';
        setTimeout(() => alertBox.classList.add('hidden'), 4000);
      }
    });
  </script>
</AdminLayout>
