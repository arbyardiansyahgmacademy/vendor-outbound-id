---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { SITE_INFO } from '../../../data/defaultContent';
---

<AdminLayout title="Editor Halaman Kontak">
  <div class="space-y-8 text-left max-w-4xl">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#235347]">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <a href="/admin/halaman" class="text-xs text-[#DAF1DE] hover:underline">← Master Halaman</a>
          <span class="text-xs text-[#235347]">/</span>
          <span class="text-xs text-[#8EB69B]">Editor Kontak</span>
        </div>
        <h1 class="font-heading font-black text-2xl uppercase tracking-wider text-white flex items-center gap-2">
          <i class="fas fa-phone-alt text-[#8EB69B]"></i>
          <span>EDITOR HALAMAN KONTAK &amp; LOKASI</span>
        </h1>
        <p class="text-xs text-[#8EB69B] mt-1">
          Kelola nomor WhatsApp konsultasi, jam operasional, alamat kantor Batu Malang, foto basecamp, dan banner visual kontak.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/kontak"
          target="_blank"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-xs font-bold border border-[#235347] transition-colors"
        >
          <i class="fas fa-external-link-alt"></i>
          <span>Lihat Halaman Live</span>
        </a>
      </div>
    </div>

    <!-- Alert Box -->
    <div id="kontak-alert" class="hidden p-3 rounded-lg text-xs font-bold transition-all shadow-md"></div>

    <form id="kontak-editor-form" class="space-y-8">
      
      <!-- Section 1: Header Halaman Kontak -->
      <div class="rounded-xl bg-[#0B2B26] border border-[#235347] p-6 space-y-4 shadow-xl">
        <div class="flex items-center justify-between border-b border-[#235347] pb-2">
          <h2 class="font-heading font-bold text-base uppercase text-[#DAF1DE] tracking-wider flex items-center gap-2">
            <span>01.</span>
            <span>Header Halaman Kontak</span>
          </h2>
          <span class="text-[10px] uppercase font-bold text-[#8EB69B] tracking-widest">Judul Utama</span>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Eyebrow Badge
          </label>
          <input
            type="text"
            id="k-eyebrow"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
            value="Hubungi Kami"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Judul Utama (H1)
          </label>
          <input
            type="text"
            id="k-h1"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B] font-bold"
            value="KONSULTASI KEGIATAN OUTBOUND"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Subjudul / Keterangan
          </label>
          <textarea
            id="k-desc"
            rows="2"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
          >Diskusikan rencana kegiatan corporate outbound, family gathering, maupun petualangan rafting & offroad di kawasan sejuk Batu dan Malang.</textarea>
        </div>

        <!-- Hero Header Image Control -->
        <div class="p-3.5 rounded-lg bg-[#051F20] border border-[#235347] space-y-2">
          <div class="flex items-center justify-between">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B]">
              Gambar Banner / Latar Header Kontak
            </label>
            <span class="text-[10px] text-[#8EB69B]/70">URL / Upload / Preset</span>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
            <div class="w-16 h-12 rounded-lg bg-[#0B2B26] border border-[#235347] overflow-hidden flex-shrink-0 flex items-center justify-center">
              <img id="k-hero-img-preview" src="/images/hero/hero-outbound.webp" alt="Hero Kontak Preview" class="w-full h-full object-cover" />
            </div>

            <div class="flex-1 w-full space-y-1.5">
              <div class="flex gap-2">
                <input
                  type="text"
                  id="k-hero-img"
                  data-preview="k-hero-img-preview"
                  class="img-ctrl-input flex-1 px-3 py-1.5 rounded-lg bg-[#0B2B26] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
                  value="/images/hero/hero-outbound.webp"
                />
                <label class="btn-img-upload px-3 py-1.5 rounded-lg bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-xs font-bold border border-[#235347] cursor-pointer flex items-center gap-1.5 transition-all">
                  <i class="fas fa-upload text-[11px]"></i>
                  <span>Upload</span>
                  <input type="file" accept="image/*" class="hidden img-ctrl-file" data-input="k-hero-img" data-preview="k-hero-img-preview" />
                </label>
              </div>

              <div class="flex flex-wrap items-center gap-1.5 text-[10px]">
                <span class="text-[#8EB69B]">Preset:</span>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="k-hero-img" data-preview="k-hero-img-preview" data-val="/images/hero/hero-outbound.webp">Hero Outbound</button>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="k-hero-img" data-preview="k-hero-img-preview" data-val="/images/hero-bromo-sunrise.webp">Bromo Sunrise</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 2: Saluran Kontak Langsung & Basecamp -->
      <div class="rounded-xl bg-[#0B2B26] border border-[#235347] p-6 space-y-4 shadow-xl">
        <div class="flex items-center justify-between border-b border-[#235347] pb-2">
          <h2 class="font-heading font-bold text-base uppercase text-[#DAF1DE] tracking-wider flex items-center gap-2">
            <span>02.</span>
            <span>Saluran Komunikasi Langsung &amp; Foto Basecamp</span>
          </h2>
          <span class="text-[10px] uppercase font-bold text-[#8EB69B] tracking-widest">Kontak Resmi</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
              Nomor WhatsApp (Format 628...)
            </label>
            <input
              type="text"
              id="k-wa-number"
              class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
              value={SITE_INFO.whatsappNumber}
            />
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
              Tampilan Nomor WhatsApp (Display)
            </label>
            <input
              type="text"
              id="k-wa-display"
              class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
              value={SITE_INFO.whatsappDisplay}
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
              Email Resmi Informasi
            </label>
            <input
              type="email"
              id="k-email"
              class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
              value="info@provideroutbound.web.id"
            />
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
              Jam Operasional Layanan
            </label>
            <input
              type="text"
              id="k-hours"
              class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
              value="Senin – Minggu: 08.00 – 21.00 WIB"
            />
          </div>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Alamat Kantor / Basecamp Outbound
          </label>
          <input
            type="text"
            id="k-address"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
            value="Kawasan Wisata Kota Batu & Malang Raya, Jawa Timur"
          />
        </div>

        <!-- Foto Kantor / Basecamp Image Control -->
        <div class="p-3.5 rounded-lg bg-[#051F20] border border-[#235347] space-y-2">
          <div class="flex items-center justify-between">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B]">
              Foto Kantor / Basecamp Lapangan
            </label>
            <span class="text-[10px] text-[#8EB69B]/70">URL / Upload / Preset</span>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
            <div class="w-16 h-12 rounded-lg bg-[#0B2B26] border border-[#235347] overflow-hidden flex-shrink-0 flex items-center justify-center">
              <img id="k-office-img-preview" src="/images/gallery/gallery-4.webp" alt="Foto Basecamp Preview" class="w-full h-full object-cover" />
            </div>

            <div class="flex-1 w-full space-y-1.5">
              <div class="flex gap-2">
                <input
                  type="text"
                  id="k-office-img"
                  data-preview="k-office-img-preview"
                  class="img-ctrl-input flex-1 px-3 py-1.5 rounded-lg bg-[#0B2B26] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
                  value="/images/gallery/gallery-4.webp"
                />
                <label class="btn-img-upload px-3 py-1.5 rounded-lg bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-xs font-bold border border-[#235347] cursor-pointer flex items-center gap-1.5 transition-all">
                  <i class="fas fa-upload text-[11px]"></i>
                  <span>Upload</span>
                  <input type="file" accept="image/*" class="hidden img-ctrl-file" data-input="k-office-img" data-preview="k-office-img-preview" />
                </label>
              </div>

              <div class="flex flex-wrap items-center gap-1.5 text-[10px]">
                <span class="text-[#8EB69B]">Preset:</span>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="k-office-img" data-preview="k-office-img-preview" data-val="/images/gallery/gallery-4.webp">Ground Camp</button>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="k-office-img" data-preview="k-office-img-preview" data-val="/images/about/team-fasilitator.webp">Tim Fasilitator</button>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="k-office-img" data-preview="k-office-img-preview" data-val="/images/destinasi/coban-rondo.webp">Coban Rondo</button>
              </div>
            </div>
          </div>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Google Maps Embed / Link Lokasi
          </label>
          <input
            type="text"
            id="k-maps-link"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
            value="https://maps.google.com/?q=Kota+Batu+Malang"
          />
        </div>
      </div>

      <!-- Section 3: SEO Meta -->
      <div class="rounded-xl bg-[#0B2B26] border border-[#235347] p-6 space-y-4 shadow-xl">
        <div class="flex items-center justify-between border-b border-[#235347] pb-2">
          <h2 class="font-heading font-bold text-base uppercase text-[#DAF1DE] tracking-wider flex items-center gap-2">
            <span>03.</span>
            <span>Meta SEO Halaman Kontak</span>
          </h2>
          <span class="text-[10px] uppercase font-bold text-[#8EB69B] tracking-widest">SEO Meta</span>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            SEO Title
          </label>
          <input
            type="text"
            id="k-seo-title"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
            value="Kontak & Konsultasi Outbound Batu Malang | Provider Outbound"
          />
        </div>

        <!-- SEO Social Share OG Image Control -->
        <div class="p-3.5 rounded-lg bg-[#051F20] border border-[#235347] space-y-2">
          <div class="flex items-center justify-between">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B]">
              Social Share Image (OG Image) Kontak
            </label>
            <span class="text-[10px] text-[#8EB69B]/70">URL / Upload / Preset</span>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
            <div class="w-16 h-12 rounded-lg bg-[#0B2B26] border border-[#235347] overflow-hidden flex-shrink-0 flex items-center justify-center">
              <img id="k-seo-og-preview" src="/images/hero/hero-outbound.webp" alt="OG Kontak Preview" class="w-full h-full object-cover" />
            </div>

            <div class="flex-1 w-full space-y-1.5">
              <div class="flex gap-2">
                <input
                  type="text"
                  id="k-seo-og"
                  data-preview="k-seo-og-preview"
                  class="img-ctrl-input flex-1 px-3 py-1.5 rounded-lg bg-[#0B2B26] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
                  value="/images/hero/hero-outbound.webp"
                />
                <label class="btn-img-upload px-3 py-1.5 rounded-lg bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-xs font-bold border border-[#235347] cursor-pointer flex items-center gap-1.5 transition-all">
                  <i class="fas fa-upload text-[11px]"></i>
                  <span>Upload</span>
                  <input type="file" accept="image/*" class="hidden img-ctrl-file" data-input="k-seo-og" data-preview="k-seo-og-preview" />
                </label>
              </div>

              <div class="flex flex-wrap items-center gap-1.5 text-[10px]">
                <span class="text-[#8EB69B]">Preset:</span>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="k-seo-og" data-preview="k-seo-og-preview" data-val="/images/hero/hero-outbound.webp">Hero Outbound</button>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="k-seo-og" data-preview="k-seo-og-preview" data-val="/images/about/team-fasilitator.webp">Tim Fasilitator</button>
              </div>
            </div>
          </div>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            SEO Description
          </label>
          <textarea
            id="k-seo-desc"
            rows="2"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
          >Hubungi tim Provider Outbound via WhatsApp atau formulir untuk konsultasi kebutuhan outbound perusahaan, family gathering, dan wisata petualangan di Batu Malang.</textarea>
        </div>
      </div>

      <!-- Submit Bar -->
      <div class="flex items-center justify-between pt-4 border-t border-[#235347]">
        <span class="text-xs text-[#8EB69B]">
          <i class="fas fa-check-circle text-[#DAF1DE] mr-1"></i>
          <span>Sinkronisasi instan ke Cache &amp; Cloud Database Supabase</span>
        </span>
        <button
          type="submit"
          class="px-6 py-3 rounded-lg bg-[#DAF1DE] hover:bg-white text-[#051F20] font-heading font-black text-xs uppercase tracking-wider shadow-glow-mint transition-all hover:scale-105 flex items-center gap-2"
        >
          <i class="fas fa-save"></i>
          <span>Simpan Perubahan Kontak</span>
        </button>
      </div>

    </form>

  </div>

  <script>
    import { syncPageToSupabase, syncSiteSettingsToSupabase } from '../../../lib/supabaseSync';

    const form = document.getElementById('kontak-editor-form') as HTMLFormElement | null;
    const alertBox = document.getElementById('kontak-alert');
    const STORAGE_KEY = 'vo_page_kontak';

    function initImageControls() {
      // 1. Text input onchange updates preview
      document.querySelectorAll<HTMLInputElement>('.img-ctrl-input').forEach((input) => {
        const prevId = input.getAttribute('data-preview');
        if (prevId) {
          const prev = document.getElementById(prevId) as HTMLImageElement;
          input.addEventListener('input', () => {
            if (prev) prev.src = input.value || '';
          });
        }
      });

      // 2. Upload button triggers file picker
      document.querySelectorAll<HTMLElement>('.btn-img-upload').forEach((label) => {
        label.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).tagName !== 'INPUT') {
            const fileInput = label.querySelector<HTMLInputElement>('.img-ctrl-file');
            fileInput?.click();
          }
        });
      });

      // 3. File picker onchange converts to DataURL and updates input & preview
      document.querySelectorAll<HTMLInputElement>('.img-ctrl-file').forEach((fileInput) => {
        fileInput.addEventListener('change', () => {
          const file = fileInput.files?.[0];
          if (file) {
            const inputId = fileInput.getAttribute('data-input');
            const prevId = fileInput.getAttribute('data-preview');
            const reader = new FileReader();
            reader.onload = (e) => {
              const res = e.target?.result as string;
              if (inputId) {
                const inp = document.getElementById(inputId) as HTMLInputElement;
                if (inp) inp.value = res;
              }
              if (prevId) {
                const prev = document.getElementById(prevId) as HTMLImageElement;
                if (prev) prev.src = res;
              }
            };
            reader.readAsDataURL(file);
          }
        });
      });

      // 4. Presets buttons
      document.querySelectorAll<HTMLButtonElement>('.btn-img-preset').forEach((btn) => {
        btn.addEventListener('click', () => {
          const inputId = btn.getAttribute('data-input');
          const prevId = btn.getAttribute('data-preview');
          const val = btn.getAttribute('data-val');
          if (val) {
            if (inputId) {
              const inp = document.getElementById(inputId) as HTMLInputElement;
              if (inp) inp.value = val;
            }
            if (prevId) {
              const prev = document.getElementById(prevId) as HTMLImageElement;
              if (prev) prev.src = val;
            }
          }
        });
      });
    }

    function setFieldAndPreview(inputId: string, prevId: string, val: string) {
      const inp = document.getElementById(inputId) as HTMLInputElement;
      if (inp) inp.value = val;
      const prev = document.getElementById(prevId) as HTMLImageElement;
      if (prev && val) prev.src = val;
    }

    initImageControls();

    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      try {
        const d = JSON.parse(saved);
        if (d.eyebrow) (document.getElementById('k-eyebrow') as HTMLInputElement).value = d.eyebrow;
        if (d.h1) (document.getElementById('k-h1') as HTMLInputElement).value = d.h1;
        if (d.desc) (document.getElementById('k-desc') as HTMLTextAreaElement).value = d.desc;
        if (d.heroImg) setFieldAndPreview('k-hero-img', 'k-hero-img-preview', d.heroImg);

        if (d.waNumber) (document.getElementById('k-wa-number') as HTMLInputElement).value = d.waNumber;
        if (d.waDisplay) (document.getElementById('k-wa-display') as HTMLInputElement).value = d.waDisplay;
        if (d.email) (document.getElementById('k-email') as HTMLInputElement).value = d.email;
        if (d.hours) (document.getElementById('k-hours') as HTMLInputElement).value = d.hours;
        if (d.address) (document.getElementById('k-address') as HTMLInputElement).value = d.address;
        if (d.officeImg) setFieldAndPreview('k-office-img', 'k-office-img-preview', d.officeImg);
        if (d.mapsLink) (document.getElementById('k-maps-link') as HTMLInputElement).value = d.mapsLink;

        if (d.seoTitle) (document.getElementById('k-seo-title') as HTMLInputElement).value = d.seoTitle;
        if (d.seoDesc) (document.getElementById('k-seo-desc') as HTMLTextAreaElement).value = d.seoDesc;
        if (d.seoOg) setFieldAndPreview('k-seo-og', 'k-seo-og-preview', d.seoOg);
      } catch (e) {
        console.error(e);
      }
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const payload = {
        eyebrow: (document.getElementById('k-eyebrow') as HTMLInputElement).value,
        h1: (document.getElementById('k-h1') as HTMLInputElement).value,
        desc: (document.getElementById('k-desc') as HTMLTextAreaElement).value,
        heroImg: (document.getElementById('k-hero-img') as HTMLInputElement).value,

        waNumber: (document.getElementById('k-wa-number') as HTMLInputElement).value,
        waDisplay: (document.getElementById('k-wa-display') as HTMLInputElement).value,
        email: (document.getElementById('k-email') as HTMLInputElement).value,
        hours: (document.getElementById('k-hours') as HTMLInputElement).value,
        address: (document.getElementById('k-address') as HTMLInputElement).value,
        officeImg: (document.getElementById('k-office-img') as HTMLInputElement).value,
        mapsLink: (document.getElementById('k-maps-link') as HTMLInputElement).value,

        seoTitle: (document.getElementById('k-seo-title') as HTMLInputElement).value,
        seoDesc: (document.getElementById('k-seo-desc') as HTMLTextAreaElement).value,
        seoOg: (document.getElementById('k-seo-og') as HTMLInputElement).value,

        updatedAt: new Date().toISOString()
      };

      localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
      window.dispatchEvent(new CustomEvent('vo_content_updated', { detail: { key: STORAGE_KEY, data: payload } }));
      window.dispatchEvent(new Event('storage'));

      try {
        const bc = new BroadcastChannel('vo_sync_channel');
        bc.postMessage({ type: 'VO_UPDATED', key: STORAGE_KEY, data: payload });
      } catch (err) {}

      // Sync to Supabase directly
      await syncPageToSupabase('/kontak', 'Kontak & Lokasi', payload, 'standard', {
        seoTitle: payload.seoTitle,
        seoDesc: payload.seoDesc,
        ogImage: payload.seoOg
      });
      await syncSiteSettingsToSupabase('kontak', payload);

      if (alertBox) {
        alertBox.className = 'p-3 rounded-lg text-xs font-bold bg-[#163832] text-[#DAF1DE] border border-[#235347] block shadow-glow-mint';
        alertBox.textContent = '✓ Seluruh informasi & gambar Halaman Kontak tersimpan ke Cloud Supabase & Web!';
        setTimeout(() => alertBox.classList.add('hidden'), 3500);
      }
    });
  </script>
</AdminLayout>
