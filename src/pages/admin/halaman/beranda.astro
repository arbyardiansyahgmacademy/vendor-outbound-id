---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { SITE_INFO } from '../../../data/defaultContent';
---

<AdminLayout title="Editor Halaman Beranda (Section-to-Section & Gambar)">
  <div class="space-y-8 text-left max-w-5xl">
    
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#235347]">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <a href="/admin/halaman" class="text-xs text-[#DAF1DE] hover:underline">← Master Halaman</a>
          <span class="text-xs text-[#235347]">/</span>
          <span class="text-xs text-[#8EB69B]">Editor Beranda</span>
        </div>
        <h1 class="font-heading font-black text-2xl uppercase tracking-wider text-white flex items-center gap-2">
          <i class="fas fa-home text-[#8EB69B]"></i>
          <span>EDITOR SECTION &amp; GAMBAR BERANDA (HOME)</span>
        </h1>
        <p class="text-xs text-[#8EB69B] mt-1">
          Kelola teks, tombol, dan gambar untuk seluruh section Beranda: SEO, Hero, About Us, Services, Mengapa Kami, 4 Kategori, Paket, Destinasi, Galeri, Blog, Testimoni, FAQ, dan CTA Banner.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/"
          target="_blank"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-xs font-bold border border-[#235347] transition-all hover:scale-105"
        >
          <i class="fas fa-external-link-alt"></i>
          <span>Buka Beranda Live</span>
        </a>
      </div>
    </div>

    <!-- Alert Box -->
    <div id="beranda-alert" class="hidden p-3 rounded-lg text-xs font-bold transition-all shadow-md"></div>

    <!-- Quick Navigation Jump Bar -->
    <div class="p-3.5 rounded-xl bg-[#0B2B26] border border-[#235347] shadow-xl flex flex-wrap items-center gap-2 text-xs">
      <span class="text-[10px] uppercase font-bold text-[#8EB69B] tracking-wider mr-1">
        <i class="fas fa-bookmark text-[#DAF1DE] mr-1"></i> Lompat Section:
      </span>
      <a href="#sec-seo" class="px-2.5 py-1 rounded bg-[#051F20] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]">01. SEO</a>
      <a href="#sec-hero" class="px-2.5 py-1 rounded bg-[#051F20] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]">02. Hero</a>
      <a href="#sec-about" class="px-2.5 py-1 rounded bg-[#051F20] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]">03. About Us</a>
      <a href="#sec-services" class="px-2.5 py-1 rounded bg-[#051F20] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]">04. Services</a>
      <a href="#sec-why" class="px-2.5 py-1 rounded bg-[#051F20] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]">05. Mengapa Kami</a>
      <a href="#sec-categories" class="px-2.5 py-1 rounded bg-[#051F20] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]">06. 4 Kategori</a>
      <a href="#sec-packages" class="px-2.5 py-1 rounded bg-[#051F20] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]">07. Paket</a>
      <a href="#sec-destinations" class="px-2.5 py-1 rounded bg-[#051F20] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]">08. Destinasi</a>
      <a href="#sec-gallery" class="px-2.5 py-1 rounded bg-[#051F20] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]">09. Galeri</a>
      <a href="#sec-blog" class="px-2.5 py-1 rounded bg-[#051F20] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]">10. Blog</a>
      <a href="#sec-testi" class="px-2.5 py-1 rounded bg-[#051F20] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]">11. Testimoni</a>
      <a href="#sec-faq" class="px-2.5 py-1 rounded bg-[#051F20] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]">12. FAQ</a>
      <a href="#sec-cta" class="px-2.5 py-1 rounded bg-[#051F20] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]">13. CTA Banner</a>
    </div>

    <form id="beranda-editor-form" class="space-y-8">
      
      <!-- Section 01: Meta SEO Beranda -->
      <div id="sec-seo" class="rounded-xl bg-[#0B2B26] border border-[#235347] p-6 space-y-4 shadow-xl">
        <div class="flex items-center justify-between border-b border-[#235347] pb-3">
          <h2 class="font-heading font-bold text-base uppercase text-[#DAF1DE] tracking-wider flex items-center gap-2">
            <span>01.</span>
            <span>Pengaturan Head &amp; Meta SEO Beranda</span>
          </h2>
          <span class="text-[10px] uppercase font-bold text-[#8EB69B] tracking-widest">Google &amp; Social Meta</span>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            SEO Title (Tag &lt;title&gt;)
          </label>
          <input
            type="text"
            id="seo-title"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
            value="Provider Outbound Batu Malang | Spesialis Team Building & Gathering"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            SEO Meta Description
          </label>
          <textarea
            id="seo-desc"
            rows="2"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
          >Penyedia kegiatan outbound, corporate team building, family gathering, outbound edukasi sekolah, dan petualangan rafting offroad di Batu & Malang.</textarea>
        </div>

        <!-- Social Share Image (OG Image) with Live Preview & Upload -->
        <div class="p-3.5 rounded-lg bg-[#051F20] border border-[#235347] space-y-2">
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B]">
            Social Share Image URL (OG Image 1200x630)
          </label>
          <div class="flex items-center gap-3">
            <img id="seo-og-preview" src="/images/hero/hero-outbound.webp" class="w-16 h-12 object-cover rounded-lg border border-[#235347] bg-[#051F20]" alt="OG Preview" />
            <div class="flex-1 space-y-1.5">
              <input
                type="text"
                id="seo-og-image"
                data-preview="seo-og-preview"
                class="img-ctrl-input w-full px-3 py-1.5 rounded bg-[#0B2B26] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
                value="/images/hero/hero-outbound.webp"
              />
              <div class="flex items-center gap-2 flex-wrap">
                <input type="file" id="seo-og-file" accept="image/*" class="hidden img-ctrl-file" data-input="seo-og-image" data-preview="seo-og-preview" />
                <button type="button" class="btn-img-upload px-2.5 py-1 rounded bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-[10px] font-bold border border-[#235347]" data-file="seo-og-file">
                  <i class="fas fa-upload mr-1"></i>Unggah File
                </button>
                <span class="text-[10px] text-[#8EB69B]">preset:</span>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded text-[10px] bg-[#0B2B26] text-[#8EB69B] hover:text-white border border-[#235347]" data-input="seo-og-image" data-preview="seo-og-preview" data-val="/images/hero/hero-outbound.webp">Hero Outbound</button>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded text-[10px] bg-[#0B2B26] text-[#8EB69B] hover:text-white border border-[#235347]" data-input="seo-og-image" data-preview="seo-og-preview" data-val="/images/dest-batu-malang.webp">Destinasi Batu</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 02: Hero Banner -->
      <div id="sec-hero" class="rounded-xl bg-[#0B2B26] border border-[#235347] p-6 space-y-4 shadow-xl">
        <div class="flex items-center justify-between border-b border-[#235347] pb-3">
          <h2 class="font-heading font-bold text-base uppercase text-[#DAF1DE] tracking-wider flex items-center gap-2">
            <span>02.</span>
            <span>Section Hero Banner (Tampilan Pertama)</span>
          </h2>
          <span class="text-[10px] uppercase font-bold text-[#8EB69B] tracking-widest">Hero Section</span>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Eyebrow Tagline Badge
          </label>
          <input
            type="text"
            id="hero-eyebrow"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
            value="Rekomendasi Utama Outbound Batu & Malang"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Judul Utama Hero (H1)
          </label>
          <input
            type="text"
            id="hero-h1"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B] font-bold"
            value="OUTBOUND & TEAM BUILDING BATU MALANG"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Paragraf Deskripsi Hero
          </label>
          <textarea
            id="hero-desc"
            rows="3"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B] leading-relaxed"
          >Wujudkan kekompakan tim, kehangatan family gathering, serta petualangan seru rafting dan offroad 4x4 di kawasan pegunungan sejuk Kota Batu & Malang bersama fasilitator tersertifikasi.</textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
              Label Tombol CTA Utama
            </label>
            <input
              type="text"
              id="hero-cta-main"
              class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
              value="Pilihan Paket Acara"
            />
          </div>
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
              Subteks Tombol CTA Utama
            </label>
            <input
              type="text"
              id="hero-cta-sub"
              class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
              value="Corporate, Gathering & Adventure"
            />
          </div>
        </div>

        <!-- Hero Image Control with Live Preview & Upload -->
        <div class="p-3.5 rounded-lg bg-[#051F20] border border-[#235347] space-y-2">
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B]">
            Gambar Hero Banner Visual (Format WebP)
          </label>
          <div class="flex items-center gap-3">
            <img id="hero-img-preview" src="/images/hero/hero-outbound.webp" class="w-16 h-16 object-cover rounded-full border border-[#235347] bg-[#051F20]" alt="Hero Preview" />
            <div class="flex-1 space-y-1.5">
              <input
                type="text"
                id="hero-image"
                data-preview="hero-img-preview"
                class="img-ctrl-input w-full px-3 py-1.5 rounded bg-[#0B2B26] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
                value="/images/hero/hero-outbound.webp"
              />
              <div class="flex items-center gap-2 flex-wrap">
                <input type="file" id="hero-img-file" accept="image/*" class="hidden img-ctrl-file" data-input="hero-image" data-preview="hero-img-preview" />
                <button type="button" class="btn-img-upload px-2.5 py-1 rounded bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-[10px] font-bold border border-[#235347]" data-file="hero-img-file">
                  <i class="fas fa-upload mr-1"></i>Unggah Foto Hero
                </button>
                <span class="text-[10px] text-[#8EB69B]">preset:</span>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded text-[10px] bg-[#0B2B26] text-[#8EB69B] hover:text-white border border-[#235347]" data-input="hero-image" data-preview="hero-img-preview" data-val="/images/hero/hero-outbound.webp">Outbound Hero</button>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded text-[10px] bg-[#0B2B26] text-[#8EB69B] hover:text-white border border-[#235347]" data-input="hero-image" data-preview="hero-img-preview" data-val="/images/dest-batu-malang.webp">Destinasi Batu</button>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded text-[10px] bg-[#0B2B26] text-[#8EB69B] hover:text-white border border-[#235347]" data-input="hero-image" data-preview="hero-img-preview" data-val="/images/prog-glamping.webp">Glamping Camping</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 03: About Us Preview -->
      <div id="sec-about" class="rounded-xl bg-[#0B2B26] border border-[#235347] p-6 space-y-4 shadow-xl">
        <div class="flex items-center justify-between border-b border-[#235347] pb-3">
          <h2 class="font-heading font-bold text-base uppercase text-[#DAF1DE] tracking-wider flex items-center gap-2">
            <span>03.</span>
            <span>Section About Us Preview (Profil Singkat)</span>
          </h2>
          <span class="text-[10px] uppercase font-bold text-[#8EB69B] tracking-widest">About Us</span>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Judul Section About Us (H2)
          </label>
          <input
            type="text"
            id="about-heading"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B] font-bold"
            value="TENTANG KAMI"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Paragraf 1: Pengantar Pengalaman
          </label>
          <textarea
            id="about-p1"
            rows="3"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
          >Dengan pengalaman bertahun-tahun mengorganisir kegiatan luar ruang di kawasan pegunungan Batu & Malang, kami hadir sebagai mitra terpercaya untuk membangun kekompakan tim, menyegarkan semangat kerja, dan menciptakan momen kebersamaan yang berharga.</textarea>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Paragraf 2: Fasilitator & Standar Mutu
          </label>
          <textarea
            id="about-p2"
            rows="3"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
          >Setiap modul simulasi dipandu oleh fasilitator lapangan tersertifikasi dan berpengalaman, memastikan pengalaman kebersamaan yang berkesan mendalam bagi rekan kerja kantor, keluarga besar, maupun institusi pendidikan Anda.</textarea>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Teks Badge Strip Bawah About Us
          </label>
          <input
            type="text"
            id="about-strip"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
            value="Fasilitator Bersertifikat BNSP • Asuransi Resmi • 15+ Venue Batu Malang"
          />
        </div>

        <!-- About Image Control with Live Preview & Upload -->
        <div class="p-3.5 rounded-lg bg-[#051F20] border border-[#235347] space-y-2">
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B]">
            Foto Visual Tim / Fasilitator About Us
          </label>
          <div class="flex items-center gap-3">
            <img id="about-img-preview" src="/images/about/team-fasilitator.webp" class="w-16 h-16 object-cover rounded-full border border-[#235347] bg-[#051F20]" alt="About Preview" />
            <div class="flex-1 space-y-1.5">
              <input
                type="text"
                id="about-image"
                data-preview="about-img-preview"
                class="img-ctrl-input w-full px-3 py-1.5 rounded bg-[#0B2B26] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
                value="/images/about/team-fasilitator.webp"
              />
              <div class="flex items-center gap-2 flex-wrap">
                <input type="file" id="about-img-file" accept="image/*" class="hidden img-ctrl-file" data-input="about-image" data-preview="about-img-preview" />
                <button type="button" class="btn-img-upload px-2.5 py-1 rounded bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-[10px] font-bold border border-[#235347]" data-file="about-img-file">
                  <i class="fas fa-upload mr-1"></i>Unggah Foto About
                </button>
                <span class="text-[10px] text-[#8EB69B]">preset:</span>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded text-[10px] bg-[#0B2B26] text-[#8EB69B] hover:text-white border border-[#235347]" data-input="about-image" data-preview="about-img-preview" data-val="/images/about/team-fasilitator.webp">Tim Fasilitator</button>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded text-[10px] bg-[#0B2B26] text-[#8EB69B] hover:text-white border border-[#235347]" data-input="about-image" data-preview="about-img-preview" data-val="/images/team-about-malang.webp">Team Batu Malang</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 04: Our Services Showcase -->
      <div id="sec-services" class="rounded-xl bg-[#0B2B26] border border-[#235347] p-6 space-y-4 shadow-xl">
        <div class="flex items-center justify-between border-b border-[#235347] pb-3">
          <h2 class="font-heading font-bold text-base uppercase text-[#DAF1DE] tracking-wider flex items-center gap-2">
            <span>04.</span>
            <span>Section Our Services (Katalog Layanan Utama)</span>
          </h2>
          <span class="text-[10px] uppercase font-bold text-[#8EB69B] tracking-widest">Our Services</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
              Judul Utama Section (H2)
            </label>
            <input
              type="text"
              id="services-heading"
              class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B] font-bold"
              value="OUR SERVICES"
            />
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
              Label Tombol Baris Layanan
            </label>
            <input
              type="text"
              id="services-btn-text"
              class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
              value="DETAIL LAYANAN"
            />
          </div>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
            Subjudul / Deskripsi Section Services
          </label>
          <textarea
            id="services-subheading"
            rows="2"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
          >Empat pilar layanan outbound terpadu kami yang dapat dikustomisasi sesuai dengan karakteristik instansi dan target kegiatan Anda.</textarea>
        </div>

        <!-- Services Image Control -->
        <div class="p-3.5 rounded-lg bg-[#051F20] border border-[#235347] space-y-2">
          <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B]">
            Gambar Latar / Sorotan Section Layanan
          </label>
          <div class="flex items-center gap-3">
            <img id="services-img-preview" src="/images/activities/outbound-team-building.webp" class="w-16 h-12 object-cover rounded-lg border border-[#235347] bg-[#051F20]" alt="Services Preview" />
            <div class="flex-1 space-y-1.5">
              <input
                type="text"
                id="services-image"
                data-preview="services-img-preview"
                class="img-ctrl-input w-full px-3 py-1.5 rounded bg-[#0B2B26] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
                value="/images/activities/outbound-team-building.webp"
              />
              <div class="flex items-center gap-2 flex-wrap">
                <input type="file" id="services-img-file" accept="image/*" class="hidden img-ctrl-file" data-input="services-image" data-preview="services-img-preview" />
                <button type="button" class="btn-img-upload px-2.5 py-1 rounded bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-[10px] font-bold border border-[#235347]" data-file="services-img-file">
                  <i class="fas fa-upload mr-1"></i>Unggah
                </button>
                <span class="text-[10px] text-[#8EB69B]">preset:</span>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded text-[10px] bg-[#0B2B26] text-[#8EB69B] hover:text-white border border-[#235347]" data-input="services-image" data-preview="services-img-preview" data-val="/images/activities/outbound-team-building.webp">Team Building</button>
                <button type="button" class="btn-img-preset px-2 py-0.5 rounded text-[10px] bg-[#0B2B26] text-[#8EB69B] hover:text-white border border-[#235347]" data-input="services-image" data-preview="services-img-preview" data-val="/images/activities/rafting-arung-jeram.webp">Rafting</button>
              </div>
            </div>
          </div>
        </div>
      </div>

