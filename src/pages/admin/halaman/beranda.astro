  <script>
    import { syncPageToSupabase, syncSiteSettingsToSupabase } from '../../../lib/supabaseSync';

    const form = document.getElementById('beranda-editor-form') as HTMLFormElement | null;
    const alertBox = document.getElementById('beranda-alert');
    const STORAGE_KEY = 'vo_page_beranda';

    // Generic Image Control Initializer
    function initImageControls() {
      // 1. Text input live update to preview
      document.querySelectorAll<HTMLInputElement>('.img-ctrl-input').forEach((input) => {
        const updatePrev = () => {
          const prevId = input.getAttribute('data-preview');
          if (prevId) {
            const prev = document.getElementById(prevId) as HTMLImageElement;
            if (prev && input.value) {
              prev.src = input.value;
            }
          }
        };
        input.addEventListener('input', updatePrev);
        input.addEventListener('change', updatePrev);
      });

      // 2. Trigger file picker
      document.querySelectorAll<HTMLButtonElement>('.btn-img-upload').forEach((btn) => {
        btn.addEventListener('click', () => {
          const fileId = btn.getAttribute('data-file');
          if (fileId) {
            const fileInput = document.getElementById(fileId) as HTMLInputElement;
            fileInput?.click();
          }
        });
      });

      // 3. File picker onchange converts to DataURL and updates input & preview
      document.querySelectorAll<HTMLInputElement>('.img-ctrl-file').forEach((fileInput) => {
        fileInput.addEventListener('change', () => {
          const file = fileInput.files?.[0];
          if (file) {
            const inputId = fileInput.getAttribute('data-input');
            const prevId = fileInput.getAttribute('data-preview');
            const reader = new FileReader();
            reader.onload = (e) => {
              const res = e.target?.result as string;
              if (inputId) {
                const inp = document.getElementById(inputId) as HTMLInputElement;
                if (inp) inp.value = res;
              }
              if (prevId) {
                const prev = document.getElementById(prevId) as HTMLImageElement;
                if (prev) prev.src = res;
              }
            };
            reader.readAsDataURL(file);
          }
        });
      });

      // 4. Presets buttons
      document.querySelectorAll<HTMLButtonElement>('.btn-img-preset').forEach((btn) => {
        btn.addEventListener('click', () => {
          const inputId = btn.getAttribute('data-input');
          const prevId = btn.getAttribute('data-preview');
          const val = btn.getAttribute('data-val');
          if (val) {
            if (inputId) {
              const inp = document.getElementById(inputId) as HTMLInputElement;
              if (inp) inp.value = val;
            }
            if (prevId) {
              const prev = document.getElementById(prevId) as HTMLImageElement;
              if (prev) prev.src = val;
            }
          }
        });
      });
    }

    // Helper to safely set input and update its preview
    function setFieldAndPreview(inputId: string, prevId: string, val: string) {
      const inp = document.getElementById(inputId) as HTMLInputElement;
      if (inp) inp.value = val;
      const prev = document.getElementById(prevId) as HTMLImageElement;
      if (prev && val) prev.src = val;
    }

    // Load saved data
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      try {
        const d = JSON.parse(saved);
        if (d.seoTitle) (document.getElementById('seo-title') as HTMLInputElement).value = d.seoTitle;
        if (d.seoOgImage) setFieldAndPreview('seo-og-image', 'seo-og-preview', d.seoOgImage);
