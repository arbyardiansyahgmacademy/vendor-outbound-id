---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { GALLERY_ITEMS } from '../../data/defaultContent';
---

<AdminLayout title="Kelola Galeri Foto">
  <div class="space-y-6 text-left">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#163832]">
      <div>
        <h1 class="font-heading font-black text-2xl uppercase tracking-wider text-white flex items-center gap-2.5">
          <i class="fas fa-camera-retro text-[#DAF1DE]"></i>
          <span>GALERI DOKUMENTASI MEDIA</span>
        </h1>
        <p class="text-xs text-[#8EB69B] mt-1">
          Validasi format WebP wajib dan batas target ukuran &lt; 100 KB per gambar (PRD Section 10 & 11.10).
        </p>
      </div>

      <button
        id="open-upload-btn"
        type="button"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-[#DAF1DE] hover:bg-white text-[#051F20] font-bold text-xs uppercase tracking-wider shadow-glow-mint transition-all"
      >
        <span>+ Upload Foto Baru</span>
      </button>
    </div>

    <div id="gal-alert" class="hidden p-3 rounded-lg text-xs font-bold"></div>

    <!-- Media Grid -->
    <div id="gal-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Populated via script -->
    </div>

    <!-- Upload Modal -->
    <dialog id="upload-modal" class="backdrop:bg-[#051F20]/80 bg-transparent p-4 max-w-lg w-full mx-auto my-auto text-white focus:outline-none">
      <div class="rounded-2xl bg-[#163832] border border-[#235347] p-6 shadow-2xl space-y-4 text-left">
        <div class="flex items-center justify-between border-b border-[#235347] pb-3">
          <h3 class="font-heading font-black text-lg text-white uppercase tracking-wider">
            Upload Foto Galeri (Target &lt; 100 KB)
          </h3>
          <button id="close-upload-btn" type="button" class="text-[#8EB69B] hover:text-white text-lg font-bold">✕</button>
        </div>

        <form id="upload-form" class="space-y-3.5">
          <!-- Image Control & Preview -->
          <div class="space-y-2 p-3 rounded-lg bg-[#051F20] border border-[#235347]">
            <div class="flex items-center justify-between">
              <label class="block text-[11px] font-bold uppercase tracking-wider text-[#DAF1DE]">
                Preview &amp; Sumber Gambar Foto
              </label>
              <span class="text-[10px] text-[#8EB69B]">Upload / URL / Preset</span>
            </div>

            <div class="w-full h-36 rounded-lg bg-[#0B2B26] border border-[#235347] overflow-hidden flex items-center justify-center">
              <img id="g-img-preview" src="/images/gallery/gallery-1.webp" alt="Galeri Preview" class="w-full h-full object-cover" />
            </div>

            <div class="flex gap-2">
              <input
                type="text"
                id="g-image-url"
                required
                class="flex-1 px-3 py-1.5 rounded-lg bg-[#0B2B26] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
                value="/images/gallery/gallery-1.webp"
              />
              <label class="px-3 py-1.5 rounded-lg bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-xs font-bold border border-[#235347] cursor-pointer flex items-center gap-1.5 transition-all">
                <i class="fas fa-upload text-[11px]"></i>
                <span>Upload</span>
                <input
                  type="file"
                  id="file-input"
                  accept="image/*"
                  class="hidden"
                />
              </label>
            </div>

            <div id="file-size-info" class="text-[11px] text-[#DAF1DE] mt-1 hidden"></div>

            <div class="flex flex-wrap items-center gap-1.5 text-[10px] pt-1">
              <span class="text-[#8EB69B]">Preset:</span>
              <button type="button" class="btn-g-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-val="/images/gallery/gallery-1.webp">Galeri 1</button>
              <button type="button" class="btn-g-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-val="/images/gallery/gallery-2.webp">Galeri 2</button>
              <button type="button" class="btn-g-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-val="/images/gallery/gallery-3.webp">Galeri 3</button>
              <button type="button" class="btn-g-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-val="/images/gallery/gallery-4.webp">Galeri 4</button>
              <button type="button" class="btn-g-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-val="/images/gallery/gallery-5.webp">Galeri 5</button>
              <button type="button" class="btn-g-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-val="/images/gallery/gallery-6.webp">Galeri 6</button>
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#DAF1DE] mb-1">Judul Foto</label>
            <input type="text" id="g-title" required class="w-full px-3 py-2 rounded bg-[#051F20]/90 border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]" />
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#DAF1DE] mb-1">Caption / Keterangan</label>
            <textarea id="g-caption" rows="2" class="w-full px-3 py-2 rounded bg-[#051F20]/90 border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"></textarea>
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#DAF1DE] mb-1">Kategori Program</label>
            <select id="g-category" required class="w-full px-3 py-2 rounded bg-[#051F20]/90 border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]">
              <option value="Perusahaan">Perusahaan</option>
              <option value="Family Gathering">Family Gathering</option>
              <option value="Sekolah">Sekolah</option>
              <option value="Wisata & Adventure">Wisata & Adventure</option>
            </select>
          </div>

          <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#235347]">
            <button type="button" id="cancel-upload-btn" class="px-4 py-2 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#8EB69B] text-xs font-bold border border-[#235347]">Batal</button>
            <button type="submit" class="px-5 py-2 rounded bg-[#DAF1DE] hover:bg-white text-[#051F20] font-bold text-xs uppercase shadow-glow-mint">Simpan ke Galeri</button>
          </div>
        </form>
      </div>
    </dialog>

  </div>

  <script>
    import { GALLERY_ITEMS } from '../../data/defaultContent';
    import { syncGalleryItemToSupabase, deleteGalleryItemFromSupabase } from '../../lib/supabaseSync';

    const grid = document.getElementById('gal-grid');
    const modal = document.getElementById('upload-modal') as HTMLDialogElement | null;
    const form = document.getElementById('upload-form') as HTMLFormElement | null;
    const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
    const sizeInfo = document.getElementById('file-size-info');
    const alertBox = document.getElementById('gal-alert');

    function getItems() {
      const stored = localStorage.getItem('vo_gallery');
      if (stored) {
        try {
          const parsed = JSON.parse(stored);
          if (Array.isArray(parsed) && parsed.length > 0) {
            return parsed.map((item: any) => ({
              ...item,
              imageUrl: item.imageUrl || item.publicUrl || item.public_url || ''
            }));
          }
        } catch (e) {}
      }
      return GALLERY_ITEMS;
    }

    function saveItems(list: any[]) {
      localStorage.setItem('vo_gallery', JSON.stringify(list));
      window.dispatchEvent(new CustomEvent('vo_content_updated', { detail: { key: 'vo_gallery', data: list } }));
      window.dispatchEvent(new Event('storage'));
      try {
        const bc = new BroadcastChannel('vo_sync_channel');
        bc.postMessage({ type: 'VO_UPDATED', key: 'vo_gallery', data: list });
      } catch (e) {}
      renderGrid();
    }

    function renderGrid() {
      if (!grid) return;
      const list = getItems();

      grid.innerHTML = list.map((item: any, idx: number) => {
        const imgUrl = item.imageUrl || item.publicUrl || item.public_url || '';
        return `
        <div class="rounded-xl bg-[#0B2B26] border border-[#235347] overflow-hidden shadow-card p-4 space-y-3">
          <div class="aspect-4/3 w-full overflow-hidden rounded-lg bg-[#051F20] border border-[#235347]">
            <img src="${imgUrl}" alt="${item.altText || item.title}" class="w-full h-full object-cover" />
          </div>

          <div>
            <span class="text-[10px] uppercase font-bold text-[#DAF1DE]">${item.category || 'Outbound'}</span>
            <h4 class="font-bold text-white text-xs uppercase mt-0.5">${item.title}</h4>
            <p class="text-[11px] text-[#8EB69B] line-clamp-1 mt-0.5">${item.caption || ''}</p>
          </div>

          <div class="pt-2 border-t border-[#163832] flex items-center justify-between text-xs">
            <span class="text-[10px] text-[#8EB69B] font-semibold">WebP Valid</span>
            <button class="del-gal-btn px-2.5 py-1 rounded bg-[#051F20] hover:bg-rose-950 text-rose-300 text-[10px] border border-[#235347]" data-idx="${idx}">
              Hapus
            </button>
          </div>
        </div>
      `;
      }).join('');

      document.querySelectorAll<HTMLButtonElement>('.del-gal-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          if (confirm('Hapus foto ini dari galeri?')) {
            const idx = Number(btn.dataset.idx);
            const targetUrl = list[idx]?.imageUrl || list[idx]?.publicUrl || list[idx]?.public_url;
            list.splice(idx, 1);
            saveItems(list);
            if (targetUrl) {
              await deleteGalleryItemFromSupabase(targetUrl);
            }
          }
        });
      });
    }

    renderGrid();

    const imgUrlInput = document.getElementById('g-image-url') as HTMLInputElement | null;
    const imgPreview = document.getElementById('g-img-preview') as HTMLImageElement | null;

    imgUrlInput?.addEventListener('input', () => {
      if (imgPreview) imgPreview.src = imgUrlInput.value || '';
    });

    document.querySelectorAll<HTMLButtonElement>('.btn-g-preset').forEach(btn => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-val');
        if (val) {
          if (imgUrlInput) imgUrlInput.value = val;
          if (imgPreview) imgPreview.src = val;
        }
      });
    });

    fileInput?.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) {
        if (sizeInfo) {
          const kb = (file.size / 1024).toFixed(1);
          sizeInfo.classList.remove('hidden');
          if (file.size > 102400) {
            sizeInfo.className = 'text-[11px] text-amber-400 font-bold mt-1';
            sizeInfo.textContent = `⚠️ Ukuran: ${kb} KB (Melebihi target 100 KB, mohon kompresi bila memungkinkan)`;
          } else {
            sizeInfo.className = 'text-[11px] text-emerald-400 font-bold mt-1';
            sizeInfo.textContent = `✓ Ukuran: ${kb} KB (Memenuhi target < 100 KB)`;
          }
        }
        const reader = new FileReader();
        reader.onload = (e) => {
          const res = e.target?.result as string;
          if (imgUrlInput) imgUrlInput.value = res;
          if (imgPreview) imgPreview.src = res;
        };
        reader.readAsDataURL(file);
      }
    });

    document.getElementById('open-upload-btn')?.addEventListener('click', () => {
      form?.reset();
      if (imgUrlInput) imgUrlInput.value = '/images/gallery/gallery-1.webp';
      if (imgPreview) imgPreview.src = '/images/gallery/gallery-1.webp';
      if (sizeInfo) sizeInfo.classList.add('hidden');
      modal?.showModal();
    });

    document.getElementById('close-upload-btn')?.addEventListener('click', () => modal?.close());
    document.getElementById('cancel-upload-btn')?.addEventListener('click', () => modal?.close());

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const list = getItems();
      const title = (document.getElementById('g-title') as HTMLInputElement).value;
      const caption = (document.getElementById('g-caption') as HTMLTextAreaElement).value;
      const category = (document.getElementById('g-category') as HTMLSelectElement).value;
      const imageUrl = imgUrlInput?.value || '/images/gallery/gallery-1.webp';

      const newItem = {
        id: 'gal-' + Date.now(),
        title,
        caption,
        altText: title,
        category,
        imageUrl,
        width: 800,
        height: 600
      };

      list.unshift(newItem);
      saveItems(list);
      modal?.close();

      // Background Supabase Sync
      syncGalleryItemToSupabase(newItem);

      if (alertBox) {
        alertBox.className = 'p-3 rounded-lg text-xs font-bold bg-emerald-950 text-emerald-200 border border-emerald-500 block';
        alertBox.textContent = '✓ Foto berhasil diunggah ke Front-End & Supabase!';
        setTimeout(() => alertBox.classList.add('hidden'), 2500);
      }
    });
  </script>
</AdminLayout>
