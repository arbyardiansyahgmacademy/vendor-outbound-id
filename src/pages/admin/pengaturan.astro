              <div>
                <label class="block text-[10px] font-bold text-[#8EB69B] mb-1">
                  <i class="fab fa-x-twitter mr-1 text-stone-300"></i> X (Twitter) URL
                </label>
                <input
                  type="url"
                  id="soc-x"
