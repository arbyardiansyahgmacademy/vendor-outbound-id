              <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
                Wilayah / Area Layanan Utama
              </label>
              <input
                type="text"
                id="set-areas"
                value={SITE_INFO.serviceAreas}
                class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
              />
            </div>

            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
                Jam Layanan Operasional
              </label>
              <input
                type="text"
                id="set-hours"
                value={SITE_INFO.operatingHours}
                class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
              />
            </div>
