          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
                Email Resmi Kantor
              </label>
              <input
                type="email"
                id="set-email"
                value="info@provideroutbound.web.id"
                class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
              />
            </div>

            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
                Alamat Fisik Kantor
              </label>
              <input
                type="text"
                id="set-address"
                value="Jl. Raya Panderman, Oro-Oro Ombo, Kota Batu, Jawa Timur"
                class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
              />
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
              Google Maps Embed URL (Iframe src)
            </label>
            <input
              type="text"
              id="set-maps"
              placeholder="https://www.google.com/maps/embed?pb=..."
              class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
            />
          </div>
        </div>
      </div>

      <!-- Action Button Submit Bar -->
      <div class="sticky bottom-4 z-30 flex items-center justify-between p-4 rounded-xl bg-[#0B2B26]/95 border-2 border-[#8EB69B]/40 shadow-2xl backdrop-blur-md">
        <div class="text-xs text-[#8EB69B] hidden sm:block">
          <i class="fas fa-check-circle text-[#DAF1DE] mr-1"></i>
          <span>Perubahan otomatis tersimpan ke Cache Web &amp; Sinkron Cloud Supabase</span>
        </div>

        <button
          type="submit"
          class="w-full sm:w-auto px-6 py-3 rounded-lg bg-[#DAF1DE] hover:bg-white text-[#051F20] font-heading font-black text-xs uppercase tracking-wider shadow-glow-mint transition-all hover:scale-105 flex items-center justify-center gap-2"
        >
          <i class="fas fa-save text-sm"></i>
          <span>Simpan Seluruh Pengaturan &amp; Tata Letak</span>
        </button>
      </div>

    </form>

  </div>

  <script>
    import {
      syncSiteSettingsToSupabase,
      syncNavbarToSupabase,
      syncFooterToSupabase,
      syncHeadToSupabase,
      pullLatestFromSupabase
    } from '../../lib/supabaseSync';

    // TAB SWITCHING LOGIC
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanes = document.querySelectorAll('.tab-pane');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(b => {
          b.classList.remove('bg-[#DAF1DE]', 'text-[#051F20]', 'active');
          b.classList.add('bg-[#0B2B26]', 'text-[#8EB69B]');
        });
        btn.classList.add('bg-[#DAF1DE]', 'text-[#051F20]', 'active');
        btn.classList.remove('bg-[#0B2B26]', 'text-[#8EB69B]');

        const target = btn.getAttribute('data-tab');
        tabPanes.forEach(pane => {
          if (pane.id === target) {
            pane.classList.remove('hidden');
          } else {
            pane.classList.add('hidden');
          }
        });
      });
    });

    // DEFAULT NAVBAR ITEMS
    const DEFAULT_NAV_ITEMS = [
      { label: 'Beranda', url: '/', target: '_self' },
      { label: 'Tentang Kami', url: '/tentang-kami', target: '_self' },
      { label: 'Layanan', url: '/layanan', target: '_self' },
      { label: 'Paket', url: '/paket', target: '_self' },
      { label: 'Galeri', url: '/galeri', target: '_self' },
      { label: 'Blog', url: '/blog', target: '_self' },
      { label: 'Kontak', url: '/kontak', target: '_self' }
    ];

    // DEFAULT FOOTER ITEMS
    const DEFAULT_FOOT_ITEMS = [
      { label: 'Kebijakan Privasi', url: '/kebijakan-privasi' },
      { label: 'Syarat & Ketentuan', url: '/syarat-ketentuan' },
      { label: 'FAQ Lengkap', url: '/faq' },
      { label: 'Katalog Paket', url: '/paket' },
      { label: 'Official Venues', url: '/layanan#destinasi-resmi' }
    ];

    let currentNavItems = [...DEFAULT_NAV_ITEMS];
    let currentFootItems = [...DEFAULT_FOOT_ITEMS];

    function renderNavTable() {
      const tbody = document.getElementById('nav-items-tbody');
      if (!tbody) return;
      tbody.innerHTML = currentNavItems.map((item, idx) => `
        <tr class="hover:bg-[#163832]/40 transition-colors">
          <td class="py-2.5 px-3 font-mono text-[#8EB69B]">${idx + 1}</td>
          <td class="py-2.5 px-3">
            <input
              type="text"
              value="${item.label}"
              data-idx="${idx}"
              class="nav-input-label px-2.5 py-1 rounded bg-[#051F20] border border-[#235347] text-white text-xs w-full max-w-[160px] focus:outline-none focus:border-[#8EB69B]"
            />
          </td>
          <td class="py-2.5 px-3">
            <input
              type="text"
              value="${item.url}"
              data-idx="${idx}"
              class="nav-input-url px-2.5 py-1 rounded bg-[#051F20] border border-[#235347] text-[#DAF1DE] text-xs font-mono w-full focus:outline-none focus:border-[#8EB69B]"
            />
          </td>
          <td class="py-2.5 px-3">
            <select data-idx="${idx}" class="nav-select-target px-2 py-1 rounded bg-[#051F20] border border-[#235347] text-xs text-[#8EB69B]">
              <option value="_self" ${item.target === '_self' ? 'selected' : ''}>Tab Sama (_self)</option>
              <option value="_blank" ${item.target === '_blank' ? 'selected' : ''}>Tab Baru (_blank)</option>
            </select>
          </td>
          <td class="py-2.5 px-3 text-right">
            <button
              type="button"
              data-delete-nav="${idx}"
              class="px-2 py-1 rounded bg-red-950/50 hover:bg-red-800 text-red-200 text-[10px] font-bold border border-red-700/40 transition-colors"
            >
              Hapus
            </button>
          </td>
        </tr>
      `).join('');

      // Bind events
      tbody.querySelectorAll('.nav-input-label').forEach(inp => {
        inp.addEventListener('input', (e) => {
          const idx = Number((e.target as HTMLElement).getAttribute('data-idx'));
          currentNavItems[idx].label = (e.target as HTMLInputElement).value;
        });
      });

      tbody.querySelectorAll('.nav-input-url').forEach(inp => {
        inp.addEventListener('input', (e) => {
          const idx = Number((e.target as HTMLElement).getAttribute('data-idx'));
          currentNavItems[idx].url = (e.target as HTMLInputElement).value;
        });
      });

      tbody.querySelectorAll('.nav-select-target').forEach(sel => {
        sel.addEventListener('change', (e) => {
          const idx = Number((e.target as HTMLElement).getAttribute('data-idx'));
          currentNavItems[idx].target = (e.target as HTMLSelectElement).value;
        });
      });

      tbody.querySelectorAll('[data-delete-nav]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = Number((e.currentTarget as HTMLElement).getAttribute('data-delete-nav'));
          if (confirm(`Hapus menu "${currentNavItems[idx].label}"?`)) {
            currentNavItems.splice(idx, 1);
            renderNavTable();
          }
        });
      });
    }

    function renderFootTable() {
      const tbody = document.getElementById('foot-items-tbody');
      if (!tbody) return;
      tbody.innerHTML = currentFootItems.map((item, idx) => `
        <tr class="hover:bg-[#163832]/40 transition-colors">
          <td class="py-2.5 px-3 font-mono text-[#8EB69B]">${idx + 1}</td>
          <td class="py-2.5 px-3">
            <input
              type="text"
              value="${item.label}"
              data-fidx="${idx}"
              class="foot-input-label px-2.5 py-1 rounded bg-[#051F20] border border-[#235347] text-white text-xs w-full max-w-[180px] focus:outline-none focus:border-[#8EB69B]"
            />
          </td>
          <td class="py-2.5 px-3">
            <input
              type="text"
              value="${item.url}"
              data-fidx="${idx}"
              class="foot-input-url px-2.5 py-1 rounded bg-[#051F20] border border-[#235347] text-[#DAF1DE] text-xs font-mono w-full focus:outline-none focus:border-[#8EB69B]"
            />
          </td>
          <td class="py-2.5 px-3 text-right">
            <button
              type="button"
              data-delete-foot="${idx}"
              class="px-2 py-1 rounded bg-red-950/50 hover:bg-red-800 text-red-200 text-[10px] font-bold border border-red-700/40 transition-colors"
            >
              Hapus
            </button>
          </td>
        </tr>
      `).join('');

      tbody.querySelectorAll('.foot-input-label').forEach(inp => {
        inp.addEventListener('input', (e) => {
          const idx = Number((e.target as HTMLElement).getAttribute('data-fidx'));
          currentFootItems[idx].label = (e.target as HTMLInputElement).value;
        });
      });

      tbody.querySelectorAll('.foot-input-url').forEach(inp => {
        inp.addEventListener('input', (e) => {
          const idx = Number((e.target as HTMLElement).getAttribute('data-fidx'));
          currentFootItems[idx].url = (e.target as HTMLInputElement).value;
        });
      });

      tbody.querySelectorAll('[data-delete-foot]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = Number((e.currentTarget as HTMLElement).getAttribute('data-delete-foot'));
          if (confirm(`Hapus link footer "${currentFootItems[idx].label}"?`)) {
            currentFootItems.splice(idx, 1);
            renderFootTable();
          }
        });
      });
    }

    // Add new navbar item button
    document.getElementById('btn-add-nav-item')?.addEventListener('click', () => {
      const label = prompt('Nama Label Menu Baru:', 'Menu Baru');
      if (!label) return;
      const url = prompt('Tautan URL Halaman:', '/');
      if (!url) return;
      currentNavItems.push({ label, url, target: '_self' });
      renderNavTable();
    });

    // Reset navbar button
    document.getElementById('btn-reset-nav-default')?.addEventListener('click', () => {
      if (confirm('Kembalikan susunan menu navbar ke 7 menu bawaan?')) {
        currentNavItems = [...DEFAULT_NAV_ITEMS];
        renderNavTable();
      }
    });

    // Add new footer link button
    document.getElementById('btn-add-foot-item')?.addEventListener('click', () => {
      const label = prompt('Nama Tautan Footer:', 'Tautan Cepat');
      if (!label) return;
      const url = prompt('URL Tautan:', '/');
      if (!url) return;
      currentFootItems.push({ label, url });
      renderFootTable();
    });

    function initImageControls() {
      document.querySelectorAll<HTMLInputElement>('.img-ctrl-input').forEach((input) => {
        const prevId = input.getAttribute('data-preview');
        if (prevId) {
          const prev = document.getElementById(prevId) as HTMLImageElement;
          input.addEventListener('input', () => {
            if (prev) prev.src = input.value || '';
          });
        }
      });

      document.querySelectorAll<HTMLElement>('.btn-img-upload').forEach((label) => {
        label.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).tagName !== 'INPUT') {
            const fileInput = label.querySelector<HTMLInputElement>('.img-ctrl-file');
            fileInput?.click();
          }
        });
      });

      document.querySelectorAll<HTMLInputElement>('.img-ctrl-file').forEach((fileInput) => {
        fileInput.addEventListener('change', () => {
          const file = fileInput.files?.[0];
          if (file) {
            const inputId = fileInput.getAttribute('data-input');
            const prevId = fileInput.getAttribute('data-preview');
            const reader = new FileReader();
            reader.onload = (e) => {
              const res = e.target?.result as string;
              if (inputId) {
                const inp = document.getElementById(inputId) as HTMLInputElement;
                if (inp) inp.value = res;
              }
              if (prevId) {
                const prev = document.getElementById(prevId) as HTMLImageElement;
                if (prev) prev.src = res;
              }
            };
            reader.readAsDataURL(file);
          }
        });
      });

      document.querySelectorAll<HTMLButtonElement>('.btn-img-preset').forEach((btn) => {
        btn.addEventListener('click', () => {
          const inputId = btn.getAttribute('data-input');
          const prevId = btn.getAttribute('data-preview');
          const val = btn.getAttribute('data-val');
          if (val) {
            if (inputId) {
              const inp = document.getElementById(inputId) as HTMLInputElement;
              if (inp) inp.value = val;
            }
            if (prevId) {
              const prev = document.getElementById(prevId) as HTMLImageElement;
              if (prev) prev.src = val;
            }
          }
        });
      });
    }

    function setFieldAndPreview(inputId: string, prevId: string, val: string) {
      const inp = document.getElementById(inputId) as HTMLInputElement;
      if (inp) inp.value = val;
      const prev = document.getElementById(prevId) as HTMLImageElement;
      if (prev && val) prev.src = val;
    }

    initImageControls();

    // LOAD INITIAL DATA (LocalStorage & Cloud)
    function loadSavedData() {
      // 1. General Settings
      const savedGeneral = localStorage.getItem('vo_settings');
      if (savedGeneral) {
        try {
          const g = JSON.parse(savedGeneral);
          if (g.brandName) (document.getElementById('foot-brand-name') as HTMLInputElement).value = g.brandName;
          if (g.tagline) (document.getElementById('set-tagline') as HTMLInputElement).value = g.tagline;
          if (g.domain) (document.getElementById('set-domain') as HTMLInputElement).value = g.domain;
          if (g.description) (document.getElementById('set-desc') as HTMLTextAreaElement).value = g.description;
          if (g.whatsappNumber) (document.getElementById('set-wa-num') as HTMLInputElement).value = g.whatsappNumber;
          if (g.whatsappDisplay) (document.getElementById('set-wa-disp') as HTMLInputElement).value = g.whatsappDisplay;
          if (g.defaultWaMessage) (document.getElementById('set-wa-msg') as HTMLTextAreaElement).value = g.defaultWaMessage;
          if (g.serviceAreas) (document.getElementById('set-areas') as HTMLInputElement).value = g.serviceAreas;
          if (g.operatingHours) (document.getElementById('set-hours') as HTMLInputElement).value = g.operatingHours;
          if (g.email) (document.getElementById('set-email') as HTMLInputElement).value = g.email;
          if (g.officeAddress) (document.getElementById('set-address') as HTMLInputElement).value = g.officeAddress;
          if (g.mapsEmbedUrl) (document.getElementById('set-maps') as HTMLInputElement).value = g.mapsEmbedUrl;
        } catch (e) {}
      }

      // 2. Head Settings
      const savedHead = localStorage.getItem('vo_head');
      if (savedHead) {
        try {
          const h = JSON.parse(savedHead);
          if (h.tagline) (document.getElementById('set-tagline') as HTMLInputElement).value = h.tagline;
          if (h.faviconUrl) setFieldAndPreview('set-favicon', 'set-favicon-preview', h.faviconUrl);
          if (h.ogImageUrl) setFieldAndPreview('set-og-image', 'set-og-preview', h.ogImageUrl);
          if (h.customScripts) (document.getElementById('set-head-scripts') as HTMLTextAreaElement).value = h.customScripts;
          if (typeof h.indexing !== 'undefined') (document.getElementById('set-indexing') as HTMLInputElement).checked = h.indexing;
        } catch (e) {}
      }

      // 3. Navbar Settings
      const savedNav = localStorage.getItem('vo_navbar');
      if (savedNav) {
        try {
          const n = JSON.parse(savedNav);
          if (n.brand_name || n.brandName) (document.getElementById('nav-brand-name') as HTMLInputElement).value = n.brand_name || n.brandName;
          if (n.tagline) (document.getElementById('nav-brand-tagline') as HTMLInputElement).value = n.tagline;
          if (n.logo_url || n.logoUrl) setFieldAndPreview('nav-logo-url', 'nav-logo-preview', n.logo_url || n.logoUrl);
          if (n.cta_text || n.ctaText) (document.getElementById('nav-cta-text') as HTMLInputElement).value = n.cta_text || n.ctaText;
          if (n.cta_url || n.ctaUrl) (document.getElementById('nav-cta-url') as HTMLInputElement).value = n.cta_url || n.ctaUrl;
          if (Array.isArray(n.items) && n.items.length > 0) {
            currentNavItems = n.items;
          }
        } catch (e) {}
      }

      // 4. Footer Settings
      const savedFoot = localStorage.getItem('vo_footer');
      if (savedFoot) {
        try {
          const f = JSON.parse(savedFoot);
          if (f.brand_name || f.brandName) (document.getElementById('foot-brand-name') as HTMLInputElement).value = f.brand_name || f.brandName;
          if (f.brand_description || f.brandDescription) (document.getElementById('foot-desc') as HTMLTextAreaElement).value = f.brand_description || f.brandDescription;
          if (f.copyright_text || f.copyrightText) (document.getElementById('foot-copyright') as HTMLInputElement).value = f.copyright_text || f.copyrightText;
          if (f.social_links || f.socialLinks) {
            const s = f.social_links || f.socialLinks;
            if (s.instagram) (document.getElementById('soc-instagram') as HTMLInputElement).value = s.instagram;
            if (s.tiktok) (document.getElementById('soc-tiktok') as HTMLInputElement).value = s.tiktok;
            if (s.facebook) (document.getElementById('soc-facebook') as HTMLInputElement).value = s.facebook;
            if (s.youtube) (document.getElementById('soc-youtube') as HTMLInputElement).value = s.youtube;
            if (s.x) (document.getElementById('soc-x') as HTMLInputElement).value = s.x;
          }
          if (Array.isArray(f.links) && f.links.length > 0) {
            currentFootItems = f.links;
          } else if (Array.isArray(f.legal_links)) {
            currentFootItems = f.legal_links;
          }
        } catch (e) {}
      }

      renderNavTable();
      renderFootTable();
    }

    loadSavedData();

    // Pull from cloud button
    document.getElementById('btn-pull-cloud')?.addEventListener('click', async () => {
      const btn = document.getElementById('btn-pull-cloud');
      if (btn) btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Menarik Data...';
      const success = await pullLatestFromSupabase();
      if (btn) btn.innerHTML = '<i class="fas fa-cloud-download-alt text-[#8EB69B] mr-1"></i> Tarik dari Supabase';
      if (success) {
        loadSavedData();
        const alertBox = document.getElementById('settings-alert');
        if (alertBox) {
          alertBox.className = 'p-3 rounded-lg text-xs font-bold bg-[#163832] text-[#DAF1DE] border border-[#235347] block shadow-glow-mint';
          alertBox.textContent = '✓ Seluruh data konfigurasi terbaru dari Supabase berhasil disinkronkan ke dashboard!';
          setTimeout(() => alertBox.classList.add('hidden'), 3500);
        }
      }
    });

    // FORM SUBMIT HANDLER: Save to LocalStorage + Push to Supabase Cloud
    const form = document.getElementById('master-settings-form');
    const alertBox = document.getElementById('settings-alert');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      // 1. Head Payload
      const headPayload = {
        tagline: (document.getElementById('set-tagline') as HTMLInputElement).value,
        domain: (document.getElementById('set-domain') as HTMLInputElement).value,
        description: (document.getElementById('set-desc') as HTMLTextAreaElement).value,
        faviconUrl: (document.getElementById('set-favicon') as HTMLInputElement).value,
        ogImageUrl: (document.getElementById('set-og-image') as HTMLInputElement).value,
        customScripts: (document.getElementById('set-head-scripts') as HTMLTextAreaElement).value,
        indexing: (document.getElementById('set-indexing') as HTMLInputElement).checked,
        updatedAt: new Date().toISOString()
      };

      // 2. Navbar Payload
      const navPayload = {
        brand_name: (document.getElementById('nav-brand-name') as HTMLInputElement).value,
        tagline: (document.getElementById('nav-brand-tagline') as HTMLInputElement).value,
        logo_url: (document.getElementById('nav-logo-url') as HTMLInputElement).value,
        cta_text: (document.getElementById('nav-cta-text') as HTMLInputElement).value,
        cta_url: (document.getElementById('nav-cta-url') as HTMLInputElement).value,
        items: currentNavItems,
        updatedAt: new Date().toISOString()
      };

      // 3. Footer Payload
      const footPayload = {
        brand_name: (document.getElementById('foot-brand-name') as HTMLInputElement).value,
        brand_description: (document.getElementById('foot-desc') as HTMLTextAreaElement).value,
        copyright_text: (document.getElementById('foot-copyright') as HTMLInputElement).value,
        social_links: {
          instagram: (document.getElementById('soc-instagram') as HTMLInputElement).value,
          tiktok: (document.getElementById('soc-tiktok') as HTMLInputElement).value,
          facebook: (document.getElementById('soc-facebook') as HTMLInputElement).value,
          youtube: (document.getElementById('soc-youtube') as HTMLInputElement).value,
          x: (document.getElementById('soc-x') as HTMLInputElement).value,
        },
        links: currentFootItems,
        updatedAt: new Date().toISOString()
      };

      // 4. General & Contact Payload
      const generalPayload = {
        brandName: (document.getElementById('nav-brand-name') as HTMLInputElement).value,
        tagline: (document.getElementById('set-tagline') as HTMLInputElement).value,
        domain: (document.getElementById('set-domain') as HTMLInputElement).value,
        description: (document.getElementById('set-desc') as HTMLTextAreaElement).value,
        whatsappNumber: (document.getElementById('set-wa-num') as HTMLInputElement).value,
        whatsappDisplay: (document.getElementById('set-wa-disp') as HTMLInputElement).value,
        defaultWaMessage: (document.getElementById('set-wa-msg') as HTMLTextAreaElement).value,
        serviceAreas: (document.getElementById('set-areas') as HTMLInputElement).value,
        operatingHours: (document.getElementById('set-hours') as HTMLInputElement).value,
        email: (document.getElementById('set-email') as HTMLInputElement).value,
        officeAddress: (document.getElementById('set-address') as HTMLInputElement).value,
        mapsEmbedUrl: (document.getElementById('set-maps') as HTMLInputElement).value,
        updatedAt: new Date().toISOString()
      };

      // Store in LocalStorage
      localStorage.setItem('vo_head', JSON.stringify(headPayload));
      localStorage.setItem('vo_navbar', JSON.stringify(navPayload));
      localStorage.setItem('vo_footer', JSON.stringify(footPayload));
      localStorage.setItem('vo_settings', JSON.stringify(generalPayload));

      // Broadcast to all open tabs and windows
      window.dispatchEvent(new CustomEvent('vo_content_updated', {
        detail: { key: 'global_settings', head: headPayload, navbar: navPayload, footer: footPayload, general: generalPayload }
      }));
      window.dispatchEvent(new Event('storage'));
      try {
        const bc = new BroadcastChannel('vo_sync_channel');
        bc.postMessage({ type: 'VO_UPDATED', key: 'global_settings' });
      } catch (err) {}

      // Push to Supabase Cloud directly
      await syncSiteSettingsToSupabase('head', headPayload);
      await syncNavbarToSupabase(navPayload);
      await syncFooterToSupabase(footPayload);
      await syncSiteSettingsToSupabase('general', generalPayload);

      if (alertBox) {
        alertBox.className = 'p-3 rounded-lg text-xs font-bold bg-[#163832] text-[#DAF1DE] border border-[#235347] block shadow-glow-mint';
        alertBox.textContent = '✓ Seluruh perubahan Head, Navbar, Footer & WhatsApp berhasil tersimpan ke Cloud Supabase & Aktif di Web!';
        setTimeout(() => alertBox.classList.add('hidden'), 4000);
      }
    });
  </script>
</AdminLayout>
