---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { SITE_INFO } from '../../data/defaultContent';
---

<AdminLayout title="Pengaturan Global & Tata Letak">
  <div class="space-y-6 text-left max-w-5xl">
    
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#235347]">
      <div>
        <h1 class="font-heading font-black text-2xl uppercase tracking-wider text-white flex items-center gap-2.5">
          <i class="fas fa-sliders-h text-[#8EB69B]"></i>
          <span>PENGATURAN GLOBAL, TATA LETAK &amp; SEO</span>
        </h1>
        <p class="text-xs text-[#8EB69B] mt-1">
          Pusat kendali CRUD section Head (SEO &amp; Meta), Navbar (Menu Navigasi), Footer (Sosial Media &amp; Link), serta Integrasi WhatsApp &amp; Kontak.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-pull-cloud"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-xs font-bold border border-[#235347] transition-all hover:scale-105"
          title="Tarik data terbaru langsung dari Cloud Supabase"
        >
          <i class="fas fa-cloud-download-alt text-[#8EB69B]"></i>
          <span>Tarik dari Supabase</span>
        </button>
      </div>
    </div>

    <!-- Alert Box -->
    <div id="settings-alert" class="hidden p-3 rounded-lg text-xs font-bold transition-all shadow-md"></div>

    <!-- Navigation Tabs for Head, Navbar, Footer, General -->
    <div class="flex flex-wrap gap-2 border-b border-[#235347] pb-3" id="settings-tabs">
      <button
        type="button"
        class="tab-btn active px-4 py-2 rounded-lg text-xs font-heading font-bold uppercase tracking-wider bg-[#DAF1DE] text-[#051F20] shadow-sm transition-all flex items-center gap-2"
        data-tab="tab-head"
      >
        <i class="fas fa-code"></i>
        <span>01. Head &amp; SEO Global</span>
      </button>

      <button
        type="button"
        class="tab-btn px-4 py-2 rounded-lg text-xs font-heading font-bold uppercase tracking-wider bg-[#0B2B26] text-[#8EB69B] hover:text-white border border-[#235347] transition-all flex items-center gap-2"
        data-tab="tab-navbar"
      >
        <i class="fas fa-compass"></i>
        <span>02. Navbar &amp; Menu (CRUD)</span>
      </button>

      <button
        type="button"
        class="tab-btn px-4 py-2 rounded-lg text-xs font-heading font-bold uppercase tracking-wider bg-[#0B2B26] text-[#8EB69B] hover:text-white border border-[#235347] transition-all flex items-center gap-2"
        data-tab="tab-footer"
      >
        <i class="fas fa-shoe-prints"></i>
        <span>03. Footer &amp; Sosial Media</span>
      </button>

      <button
        type="button"
        class="tab-btn px-4 py-2 rounded-lg text-xs font-heading font-bold uppercase tracking-wider bg-[#0B2B26] text-[#8EB69B] hover:text-white border border-[#235347] transition-all flex items-center gap-2"
        data-tab="tab-general"
      >
        <i class="fab fa-whatsapp"></i>
        <span>04. WhatsApp &amp; Kontak</span>
      </button>
    </div>

    <form id="master-settings-form" class="space-y-6">
      
      <!-- ===================================================================== -->
      <!-- TAB 1: HEAD & SEO GLOBAL                                              -->
      <!-- ===================================================================== -->
      <div id="tab-head" class="tab-pane space-y-6">
        <div class="rounded-xl bg-[#0B2B26] border border-[#235347] p-6 space-y-5 shadow-xl">
          <div class="flex items-center justify-between border-b border-[#235347] pb-3">
            <h2 class="font-heading font-bold text-base uppercase text-[#DAF1DE] tracking-wider flex items-center gap-2">
              <i class="fas fa-search text-[#8EB69B]"></i>
              <span>Konfigurasi Tag &lt;head&gt; &amp; SEO Meta Global</span>
            </h2>
            <span class="text-[10px] uppercase font-bold text-[#8EB69B] tracking-widest">Head Section</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
                Site Tagline (Ditampilkan di Title Tab Browser)
              </label>
              <input
                type="text"
                id="set-tagline"
                value={SITE_INFO.tagline}
                class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
              />
            </div>

            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
                Canonical Base Domain URL
              </label>
              <input
                type="url"
                id="set-domain"
                value={SITE_INFO.domain}
                class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
              />
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
              Deskripsi Global (Default Meta Description)
            </label>
            <textarea
              id="set-desc"
              rows="3"
              class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B] leading-relaxed"
            >{SITE_INFO.description}</textarea>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Favicon Image Control -->
            <div class="p-3.5 rounded-lg bg-[#051F20] border border-[#235347] space-y-2">
              <div class="flex items-center justify-between">
                <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B]">
                  Favicon URL (Format WebP / PNG / SVG)
                </label>
                <span class="text-[10px] text-[#8EB69B]/70">URL / Upload</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-lg bg-[#0B2B26] border border-[#235347] overflow-hidden flex-shrink-0 flex items-center justify-center p-1">
                  <img id="set-favicon-preview" src="/images/logo/logo-provider-outbound.webp" alt="Favicon" class="w-full h-full object-contain" />
                </div>
                <div class="flex-1 space-y-1.5">
                  <div class="flex gap-2">
                    <input
                      type="text"
                      id="set-favicon"
                      data-preview="set-favicon-preview"
                      value="/images/logo/logo-provider-outbound.webp"
                      class="img-ctrl-input flex-1 px-3 py-1.5 rounded-lg bg-[#0B2B26] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
                    />
                    <label class="btn-img-upload px-3 py-1.5 rounded-lg bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-xs font-bold border border-[#235347] cursor-pointer flex items-center gap-1.5 transition-all">
                      <i class="fas fa-upload text-[11px]"></i>
                      <span>Upload</span>
                      <input type="file" accept="image/*" class="hidden img-ctrl-file" data-input="set-favicon" data-preview="set-favicon-preview" />
                    </label>
                  </div>
                  <div class="flex flex-wrap items-center gap-1.5 text-[10px]">
                    <span class="text-[#8EB69B]">Preset:</span>
                    <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="set-favicon" data-preview="set-favicon-preview" data-val="/images/logo/logo-provider-outbound.webp">Default Logo</button>
                    <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="set-favicon" data-preview="set-favicon-preview" data-val="/favicon.svg">SVG Icon</button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Global OG Image Control -->
            <div class="p-3.5 rounded-lg bg-[#051F20] border border-[#235347] space-y-2">
              <div class="flex items-center justify-between">
                <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B]">
                  Default Social Share Image (OG 1200x630)
                </label>
                <span class="text-[10px] text-[#8EB69B]/70">URL / Upload</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-16 h-12 rounded-lg bg-[#0B2B26] border border-[#235347] overflow-hidden flex-shrink-0 flex items-center justify-center">
                  <img id="set-og-preview" src="/images/hero/hero-outbound.webp" alt="OG Preview" class="w-full h-full object-cover" />
                </div>
                <div class="flex-1 space-y-1.5">
                  <div class="flex gap-2">
                    <input
                      type="text"
                      id="set-og-image"
                      data-preview="set-og-preview"
                      value="/images/hero/hero-outbound.webp"
                      class="img-ctrl-input flex-1 px-3 py-1.5 rounded-lg bg-[#0B2B26] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
                    />
                    <label class="btn-img-upload px-3 py-1.5 rounded-lg bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-xs font-bold border border-[#235347] cursor-pointer flex items-center gap-1.5 transition-all">
                      <i class="fas fa-upload text-[11px]"></i>
                      <span>Upload</span>
                      <input type="file" accept="image/*" class="hidden img-ctrl-file" data-input="set-og-image" data-preview="set-og-preview" />
                    </label>
                  </div>
                  <div class="flex flex-wrap items-center gap-1.5 text-[10px]">
                    <span class="text-[#8EB69B]">Preset:</span>
                    <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="set-og-image" data-preview="set-og-preview" data-val="/images/hero/hero-outbound.webp">Hero Outbound</button>
                    <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="set-og-image" data-preview="set-og-preview" data-val="/images/about/team-fasilitator.webp">Tim Fasilitator</button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
              Custom Header Scripts (Google Tag Manager, Google Analytics, Pixel)
            </label>
            <textarea
              id="set-head-scripts"
              rows="3"
              placeholder="<!-- Masukkan script pihak ketiga seperti Google Analytics (opsional) -->"
              class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
            ></textarea>
          </div>

          <div class="flex items-center gap-3 p-3.5 rounded-lg bg-[#051F20] border border-[#235347]">
            <input
              type="checkbox"
              id="set-indexing"
              checked
              class="w-4 h-4 rounded text-[#8EB69B] focus:ring-0 bg-[#0B2B26] border-[#235347]"
            />
            <label for="set-indexing" class="text-xs text-[#DAF1DE] font-semibold cursor-pointer">
              Izinkan Mesin Pencari Mengindeks Seluruh Halaman (Robots: index, follow)
            </label>
          </div>
        </div>
      </div>

      <!-- ===================================================================== -->
      <!-- TAB 2: NAVBAR & MENU (CRUD)                                           -->
      <!-- ===================================================================== -->
      <div id="tab-navbar" class="tab-pane hidden space-y-6">
        <div class="rounded-xl bg-[#0B2B26] border border-[#235347] p-6 space-y-5 shadow-xl">
          <div class="flex items-center justify-between border-b border-[#235347] pb-3">
            <h2 class="font-heading font-bold text-base uppercase text-[#DAF1DE] tracking-wider flex items-center gap-2">
              <i class="fas fa-compass text-[#8EB69B]"></i>
              <span>Brand &amp; Tombol Aksi Navbar</span>
            </h2>
            <span class="text-[10px] uppercase font-bold text-[#8EB69B] tracking-widest">Navbar Header</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
                Nama Brand di Navbar
              </label>
              <input
                type="text"
                id="nav-brand-name"
                value="PROVIDER OUTBOUND"
                class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B] font-bold"
              />
            </div>

            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
                Tagline Subteks Brand
              </label>
              <input
                type="text"
                id="nav-brand-tagline"
                value="Outbound &amp; Gathering Batu Malang"
                class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
              />
            </div>

            <div class="sm:col-span-3 p-3.5 rounded-lg bg-[#051F20] border border-[#235347] space-y-2">
              <div class="flex items-center justify-between">
                <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B]">
                  Logo Brand Image Navbar &amp; Footer
                </label>
                <span class="text-[10px] text-[#8EB69B]/70">URL / Upload / Preset</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-lg bg-[#0B2B26] border border-[#235347] overflow-hidden flex-shrink-0 flex items-center justify-center p-1">
                  <img id="nav-logo-preview" src="/images/logo/logo-provider-outbound.webp" alt="Logo Preview" class="w-full h-full object-contain" />
                </div>
                <div class="flex-1 space-y-1.5">
                  <div class="flex gap-2">
                    <input
                      type="text"
                      id="nav-logo-url"
                      data-preview="nav-logo-preview"
                      value="/images/logo/logo-provider-outbound.webp"
                      class="img-ctrl-input flex-1 px-3 py-1.5 rounded-lg bg-[#0B2B26] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
                    />
                    <label class="btn-img-upload px-3 py-1.5 rounded-lg bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-xs font-bold border border-[#235347] cursor-pointer flex items-center gap-1.5 transition-all">
                      <i class="fas fa-upload text-[11px]"></i>
                      <span>Upload</span>
                      <input type="file" accept="image/*" class="hidden img-ctrl-file" data-input="nav-logo-url" data-preview="nav-logo-preview" />
                    </label>
                  </div>
                  <div class="flex flex-wrap items-center gap-1.5 text-[10px]">
                    <span class="text-[#8EB69B]">Preset:</span>
                    <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="nav-logo-url" data-preview="nav-logo-preview" data-val="/images/logo/logo-provider-outbound.webp">Default Logo WebP</button>
                    <button type="button" class="btn-img-preset px-2 py-0.5 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#DAF1DE] border border-[#235347]" data-input="nav-logo-url" data-preview="nav-logo-preview" data-val="/images/logo/logo.webp">Logo Alt</button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-3 border-t border-[#235347]/60">
            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
                Teks Tombol CTA Navbar (Kanan)
              </label>
              <input
                type="text"
                id="nav-cta-text"
                value="Chat WhatsApp"
                class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
              />
            </div>

            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
                URL Tombol CTA Navbar
              </label>
              <input
                type="text"
                id="nav-cta-url"
                value="https://wa.me/6282211221909?text=Halo%20Provider%20Outbound%2C%20saya%20ingin%20konsultasi%20paket%20kegiatan"
                class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
              />
            </div>
          </div>
        </div>

        <!-- Navbar Menu Items CRUD Section -->
        <div class="rounded-xl bg-[#0B2B26] border border-[#235347] p-6 space-y-4 shadow-xl">
          <div class="flex items-center justify-between border-b border-[#235347] pb-3">
            <div>
              <h3 class="font-heading font-bold text-sm uppercase text-[#DAF1DE] tracking-wider flex items-center gap-2">
                <i class="fas fa-list text-[#8EB69B]"></i>
                <span>CRUD DAFTAR MENU NAVIGASI (NAVBAR LINKS)</span>
              </h3>
              <p class="text-[11px] text-[#8EB69B] mt-0.5">
                Tambahkan, ubah nama label, sesuaikan target tautan URL, atau hapus menu navigasi.
              </p>
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-add-nav-item"
                class="px-3 py-1.5 rounded-lg bg-[#DAF1DE] hover:bg-white text-[#051F20] font-bold text-xs uppercase tracking-wider transition-all flex items-center gap-1.5"
              >
                <i class="fas fa-plus"></i>
                <span>Tambah Link</span>
              </button>

              <button
                type="button"
                id="btn-reset-nav-default"
                class="px-3 py-1.5 rounded-lg bg-[#051F20] hover:bg-[#163832] text-[#8EB69B] hover:text-white border border-[#235347] text-xs font-semibold transition-all"
              >
                Reset Default
              </button>
            </div>
          </div>

          <!-- Table of Nav Items -->
          <div class="overflow-x-auto">
            <table class="w-full text-xs text-left">
              <thead class="bg-[#072522] text-[10px] uppercase font-bold text-[#8EB69B] border-b border-[#235347]">
                <tr>
                  <th class="py-2.5 px-3">No.</th>
                  <th class="py-2.5 px-3">Label Menu</th>
                  <th class="py-2.5 px-3">Tautan URL</th>
                  <th class="py-2.5 px-3">Target</th>
                  <th class="py-2.5 px-3 text-right">Aksi</th>
                </tr>
              </thead>
              <tbody id="nav-items-tbody" class="divide-y divide-[#235347]/50 text-white">
                <!-- Injected via script -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ===================================================================== -->
      <!-- TAB 3: FOOTER & SOSIAL MEDIA                                          -->
      <!-- ===================================================================== -->
      <div id="tab-footer" class="tab-pane hidden space-y-6">
        <div class="rounded-xl bg-[#0B2B26] border border-[#235347] p-6 space-y-5 shadow-xl">
          <div class="flex items-center justify-between border-b border-[#235347] pb-3">
            <h2 class="font-heading font-bold text-base uppercase text-[#DAF1DE] tracking-wider flex items-center gap-2">
              <i class="fas fa-shoe-prints text-[#8EB69B]"></i>
              <span>Brand, Narasi &amp; Legalitas Footer</span>
            </h2>
            <span class="text-[10px] uppercase font-bold text-[#8EB69B] tracking-widest">Footer Section</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
                Nama Brand di Footer
              </label>
              <input
                type="text"
                id="foot-brand-name"
                value={SITE_INFO.brandName}
                class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
              />
            </div>

            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
                Teks Hak Cipta (Copyright Notice)
              </label>
              <input
                type="text"
                id="foot-copyright"
                value="Provider Outbound. Hak Cipta Dilindungi."
                class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
              />
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
              Deskripsi Brand Kolom Footer
            </label>
            <textarea
              id="foot-desc"
              rows="3"
              class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B] leading-relaxed"
            >{SITE_INFO.description} Fasilitator tersertifikasi BNSP berpengalaman mengawal ratusan instansi korporat, BUMN, lembaga pendidikan, dan paguyuban keluarga di Jawa Timur.</textarea>
          </div>

          <!-- Social Media Channels Section -->
          <div class="pt-3 border-t border-[#235347]/60 space-y-3">
            <span class="text-xs uppercase font-bold text-[#DAF1DE] tracking-wider flex items-center gap-2">
              <i class="fas fa-share-nodes text-[#8EB69B]"></i>
              <span>Kanal Media Sosial Resmi (Ditampilkan di Footer &amp; Floating)</span>
            </span>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              <div>
                <label class="block text-[10px] font-bold text-[#8EB69B] mb-1">
                  <i class="fab fa-instagram mr-1 text-pink-400"></i> Instagram URL
                </label>
                <input
                  type="url"
                  id="soc-instagram"
                  value="https://instagram.com"
                  class="w-full px-3 py-2 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
                />
              </div>

              <div>
                <label class="block text-[10px] font-bold text-[#8EB69B] mb-1">
                  <i class="fab fa-tiktok mr-1 text-cyan-400"></i> TikTok URL
                </label>
                <input
                  type="url"
                  id="soc-tiktok"
                  value="https://tiktok.com"
                  class="w-full px-3 py-2 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"
                />
              </div>

              <div>
                <label class="block text-[10px] font-bold text-[#8EB69B] mb-1">
                  <i class="fab fa-facebook mr-1 text-blue-400"></i> Facebook URL
                </label>
                <input
                  type="url"
                  id="soc-facebook"
