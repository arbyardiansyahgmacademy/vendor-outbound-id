        </div>
      </div>

      <!-- ===================================================================== -->
      <!-- TAB 4: WHATSAPP & KONTAK                                              -->
      <!-- ===================================================================== -->
      <div id="tab-general" class="tab-pane hidden space-y-6">
        <div class="rounded-xl bg-[#0B2B26] border border-[#235347] p-6 space-y-5 shadow-xl">
          <div class="flex items-center justify-between border-b border-[#235347] pb-3">
            <h2 class="font-heading font-bold text-base uppercase text-[#DAF1DE] tracking-wider flex items-center gap-2">
              <i class="fab fa-whatsapp text-[#8EB69B]"></i>
              <span>Integrasi Nomor WhatsApp &amp; Operasional Kantor</span>
            </h2>
            <span class="text-[10px] uppercase font-bold text-[#8EB69B] tracking-widest">Kontak Resmi</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
                Nomor WhatsApp Resmi (Internasional: 628...)
              </label>
              <input
                type="text"
                id="set-wa-num"
                value={SITE_INFO.whatsappNumber}
                required
                class="w-full px-3.5 py-2.5 rounded-lg bg-[#051F20] border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
              />
            </div>

            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-[#8EB69B] mb-1">
                Display Nomor WhatsApp
              </label>
              <input
                type="text"
                id="set-wa-disp"
                value={SITE_INFO.whatsappDisplay}
