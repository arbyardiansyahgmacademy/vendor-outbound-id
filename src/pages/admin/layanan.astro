---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { SERVICES } from '../../data/defaultContent';
---

<AdminLayout title="Kelola Layanan Outbound">
  <div class="space-y-6 text-left">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-rose-900/40">
      <div>
        <h1 class="font-heading font-black text-2xl uppercase tracking-wider text-white flex items-center gap-2.5">
          <i class="fas fa-briefcase text-amber-400"></i>
          <span>KELOLA LAYANAN UTAMA</span>
        </h1>
        <p class="text-xs text-rose-300/80 mt-1">
          Atur informasi 4 layanan utama, manfaat, dan daftar aktivitas (PRD Section 11.8).
        </p>
      </div>

      <button
        id="add-service-btn"
        type="button"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold text-xs uppercase tracking-wider transition-all shadow"
      >
        <span>+ Tambah Layanan</span>
      </button>
    </div>

    <div id="service-alert" class="hidden p-3 rounded-lg text-xs font-bold"></div>

    <!-- Services Table -->
    <div class="rounded-2xl bg-[#300205]/90 border border-rose-700/40 overflow-hidden shadow-2xl">
      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left">
          <thead class="bg-[#240104] text-[10px] uppercase font-bold text-rose-300/80 border-b border-rose-900/60">
            <tr>
              <th class="py-3 px-4">Urutan</th>
              <th class="py-3 px-4">Gambar</th>
              <th class="py-3 px-4">Nama Layanan</th>
              <th class="py-3 px-4">Slug URL</th>
              <th class="py-3 px-4">Sasaran Peserta</th>
              <th class="py-3 px-4">Status</th>
              <th class="py-3 px-4 text-right">Tindakan</th>
            </tr>
          </thead>
          <tbody id="services-tbody" class="divide-y divide-rose-900/30 text-rose-100">
            <!-- Populated via script -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Modal Form (Native HTML5 Dialog) -->
    <dialog id="service-modal" class="backdrop:bg-stone-950/80 bg-transparent p-4 max-w-xl w-full mx-auto my-auto text-white focus:outline-none">
      <div class="rounded-2xl bg-[#330206] border border-rose-600/50 p-6 shadow-2xl space-y-4">
        <div class="flex items-center justify-between border-b border-rose-900/50 pb-3">
          <h3 id="modal-title" class="font-heading font-black text-lg text-white uppercase tracking-wider">
            Tambah / Edit Layanan
          </h3>
          <button id="close-modal-btn" type="button" class="text-rose-300 hover:text-white text-lg font-bold">✕</button>
        </div>

        <form id="service-form" class="space-y-3.5 text-left">
          <input type="hidden" id="service-id" />

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-rose-200 mb-1">Nama Layanan</label>
            <input type="text" id="svc-title" required class="w-full px-3 py-2 rounded bg-stone-950/70 border border-rose-800 text-white text-xs focus:outline-none focus:border-amber-400" />
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-rose-200 mb-1">Slug URL</label>
            <input type="text" id="svc-slug" required class="w-full px-3 py-2 rounded bg-stone-950/70 border border-rose-800 text-white text-xs focus:outline-none focus:border-amber-400" />
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-rose-200 mb-1">Ringkasan Singkat</label>
            <textarea id="svc-excerpt" rows="2" required class="w-full px-3 py-2 rounded bg-stone-950/70 border border-rose-800 text-white text-xs focus:outline-none focus:border-amber-400"></textarea>
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-rose-200 mb-1">Sasaran Peserta</label>
            <input type="text" id="svc-target" class="w-full px-3 py-2 rounded bg-stone-950/70 border border-rose-800 text-white text-xs focus:outline-none focus:border-amber-400" />
          </div>

          <div class="flex items-center justify-end gap-3 pt-3 border-t border-rose-900/50">
            <button type="button" id="cancel-btn" class="px-4 py-2 rounded bg-stone-900 text-rose-300 text-xs font-bold">Batal</button>
            <button type="submit" class="px-5 py-2 rounded bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold text-xs uppercase">Simpan Layanan</button>
          </div>
        </form>
      </div>
    </dialog>

  </div>

  <script>
    import { SERVICES } from '../../data/defaultContent';

    const tbody = document.getElementById('services-tbody');
    const modal = document.getElementById('service-modal') as HTMLDialogElement | null;
    const form = document.getElementById('service-form') as HTMLFormElement | null;
    const alertBox = document.getElementById('service-alert');

    function getServices() {
      const stored = localStorage.getItem('vo_services');
      return stored ? JSON.parse(stored) : SERVICES;
    }

    function saveServices(list: any[]) {
      localStorage.setItem('vo_services', JSON.stringify(list));
      renderTable();
    }

    function renderTable() {
      if (!tbody) return;
      const list = getServices();

      tbody.innerHTML = list.map((s: any, idx: number) => `
        <tr class="hover:bg-rose-950/40 transition-colors">
          <td class="py-3 px-4 font-bold text-amber-400">${idx + 1}</td>
          <td class="py-3 px-4">
            <img src="${s.imageUrl}" alt="${s.title}" class="w-12 h-8 object-cover rounded bg-stone-950" />
          </td>
          <td class="py-3 px-4 font-bold text-white">${s.title}</td>
          <td class="py-3 px-4 text-rose-300 font-mono text-[11px]">/layanan/${s.slug}</td>
          <td class="py-3 px-4 text-xs text-rose-200/80">${s.targetAudience || '-'}</td>
          <td class="py-3 px-4">
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-300">Published</span>
          </td>
          <td class="py-3 px-4 text-right space-x-2">
            <button class="edit-svc-btn px-2.5 py-1 rounded bg-amber-500/20 hover:bg-amber-500 hover:text-stone-950 text-amber-300 text-[10px] font-bold border border-amber-500/40" data-idx="${idx}">
              Edit
            </button>
            <button class="del-svc-btn px-2.5 py-1 rounded bg-rose-950 hover:bg-rose-900 text-rose-300 text-[10px] border border-rose-800/40" data-idx="${idx}">
              Hapus
            </button>
          </td>
        </tr>
      `).join('');

      // Attach edit handlers
      document.querySelectorAll<HTMLButtonElement>('.edit-svc-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.dataset.idx);
          const item = list[idx];
          if (item && modal) {
            (document.getElementById('service-id') as HTMLInputElement).value = String(idx);
            (document.getElementById('svc-title') as HTMLInputElement).value = item.title;
            (document.getElementById('svc-slug') as HTMLInputElement).value = item.slug;
            (document.getElementById('svc-excerpt') as HTMLTextAreaElement).value = item.excerpt;
            (document.getElementById('svc-target') as HTMLInputElement).value = item.targetAudience || '';
            modal.showModal();
          }
        });
      });

      // Attach delete handlers
      document.querySelectorAll<HTMLButtonElement>('.del-svc-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          if (confirm('Hapus item layanan ini?')) {
            const idx = Number(btn.dataset.idx);
            list.splice(idx, 1);
            saveServices(list);
          }
        });
      });
    }

    renderTable();

    document.getElementById('add-service-btn')?.addEventListener('click', () => {
      form?.reset();
      (document.getElementById('service-id') as HTMLInputElement).value = '-1';
      modal?.showModal();
    });

    document.getElementById('close-modal-btn')?.addEventListener('click', () => modal?.close());
    document.getElementById('cancel-btn')?.addEventListener('click', () => modal?.close());

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const list = getServices();
      const idx = Number((document.getElementById('service-id') as HTMLInputElement).value);
      const title = (document.getElementById('svc-title') as HTMLInputElement).value;
      const slug = (document.getElementById('svc-slug') as HTMLInputElement).value;
      const excerpt = (document.getElementById('svc-excerpt') as HTMLTextAreaElement).value;
      const targetAudience = (document.getElementById('svc-target') as HTMLInputElement).value;

      if (idx >= 0) {
        list[idx] = { ...list[idx], title, slug, excerpt, targetAudience };
      } else {
        list.push({
          id: 'svc-' + Date.now(),
          title,
          slug,
          excerpt,
          overview: excerpt,
          targetAudience,
          benefits: ['Kekompakan tim', 'Peningkatan komunikasi'],
          activities: ['Ice Breaking', 'Team Simulation'],
          locationNote: 'Kawasan Batu Malang',
          imageUrl: '/images/services/outbound-perusahaan.webp',
          featured: true,
          sortOrder: list.length + 1
        });
      }

      saveServices(list);
      modal?.close();

      if (alertBox) {
        alertBox.className = 'p-3 rounded-lg text-xs font-bold bg-emerald-950 text-emerald-200 border border-emerald-500 block';
        alertBox.textContent = '✓ Data layanan berhasil disimpan!';
        setTimeout(() => alertBox.classList.add('hidden'), 2500);
      }
    });
  </script>
</AdminLayout>
