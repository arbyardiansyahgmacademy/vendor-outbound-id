---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { SERVICES } from '../../data/defaultContent';
---

<AdminLayout title="Kelola Layanan Outbound">
  <div class="space-y-6 text-left">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#163832]">
      <div>
        <h1 class="font-heading font-black text-2xl uppercase tracking-wider text-white flex items-center gap-2.5">
          <i class="fas fa-briefcase text-[#DAF1DE]"></i>
          <span>KELOLA LAYANAN UTAMA</span>
        </h1>
        <p class="text-xs text-[#8EB69B] mt-1">
          Atur informasi 4 layanan utama, manfaat, dan daftar aktivitas (PRD Section 11.8).
        </p>
      </div>

      <button
        id="add-service-btn"
        type="button"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-[#DAF1DE] hover:bg-white text-[#051F20] font-bold text-xs uppercase tracking-wider transition-all shadow-glow-mint"
      >
        <span>+ Tambah Layanan</span>
      </button>
    </div>

    <div id="service-alert" class="hidden p-3 rounded-lg text-xs font-bold"></div>

    <!-- Services Table -->
    <div class="rounded-2xl bg-[#0B2B26] border border-[#235347] overflow-hidden shadow-2xl">
      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left">
          <thead class="bg-[#072522] text-[10px] uppercase font-bold text-[#8EB69B] border-b border-[#163832]">
            <tr>
              <th class="py-3 px-4">Urutan</th>
              <th class="py-3 px-4">Gambar</th>
              <th class="py-3 px-4">Nama Layanan</th>
              <th class="py-3 px-4">Slug URL</th>
              <th class="py-3 px-4">Sasaran Peserta</th>
              <th class="py-3 px-4">Status</th>
              <th class="py-3 px-4 text-right">Tindakan</th>
            </tr>
          </thead>
          <tbody id="services-tbody" class="divide-y divide-[#163832] text-[#DAF1DE]/90">
            <!-- Populated via script -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Modal Form (Native HTML5 Dialog) -->
    <dialog id="service-modal" class="backdrop:bg-[#051F20]/80 bg-transparent p-4 max-w-xl w-full mx-auto my-auto text-white focus:outline-none">
      <div class="rounded-2xl bg-[#163832] border border-[#235347] p-6 shadow-2xl space-y-4">
        <div class="flex items-center justify-between border-b border-[#235347] pb-3">
          <h3 id="modal-title" class="font-heading font-black text-lg text-white uppercase tracking-wider">
            Tambah / Edit Layanan
          </h3>
          <button id="close-modal-btn" type="button" class="text-[#8EB69B] hover:text-white text-lg font-bold">✕</button>
        </div>

        <form id="service-form" class="space-y-3.5 text-left">
          <input type="hidden" id="service-id" />

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#DAF1DE] mb-1">Nama Layanan</label>
            <input type="text" id="svc-title" required class="w-full px-3 py-2 rounded bg-[#051F20]/90 border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]" />
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#DAF1DE] mb-1">Slug URL</label>
            <input type="text" id="svc-slug" required class="w-full px-3 py-2 rounded bg-[#051F20]/90 border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]" />
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#DAF1DE] mb-1">Ringkasan Singkat</label>
            <textarea id="svc-excerpt" rows="2" required class="w-full px-3 py-2 rounded bg-[#051F20]/90 border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]"></textarea>
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#DAF1DE] mb-1">Sasaran Peserta</label>
            <input type="text" id="svc-target" class="w-full px-3 py-2 rounded bg-[#051F20]/90 border border-[#235347] text-white text-xs focus:outline-none focus:border-[#8EB69B]" />
          </div>

          <!-- Gambar Layanan Section -->
          <div class="space-y-2 pt-1 border-t border-[#235347]/60">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-[#DAF1DE]">
              Gambar / Foto Layanan
            </label>
            <div class="flex items-center gap-3">
              <img id="svc-img-preview" src="/images/services/outbound-perusahaan.webp" alt="Pratinjau Layanan" class="w-16 h-12 object-cover rounded-lg border border-[#235347] bg-[#051F20]" />
              <div class="flex-1 space-y-1.5">
                <input
                  type="text"
                  id="svc-image"
                  class="w-full px-3 py-1.5 rounded bg-[#051F20]/90 border border-[#235347] text-white text-xs font-mono focus:outline-none focus:border-[#8EB69B]"
                  placeholder="/images/services/..."
                />
                <div class="flex items-center gap-2">
                  <input type="file" id="svc-file-input" accept="image/*" class="hidden" />
                  <button type="button" id="svc-upload-btn" class="px-2.5 py-1 rounded bg-[#0B2B26] hover:bg-[#235347] text-[#DAF1DE] text-[10px] font-bold border border-[#235347] flex items-center gap-1.5">
                    <i class="fas fa-upload text-[10px]"></i>
                    <span>Unggah File</span>
                  </button>
                  <span class="text-[10px] text-[#8EB69B]">atau pilih preset:</span>
                  <div class="flex items-center gap-1">
                    <button type="button" class="preset-svc-btn px-2 py-0.5 rounded text-[10px] bg-[#051F20] text-[#8EB69B] hover:text-white border border-[#235347]" data-src="/images/services/outbound-perusahaan.webp">Perusahaan</button>
                    <button type="button" class="preset-svc-btn px-2 py-0.5 rounded text-[10px] bg-[#051F20] text-[#8EB69B] hover:text-white border border-[#235347]" data-src="/images/services/family-gathering.webp">Family</button>
                    <button type="button" class="preset-svc-btn px-2 py-0.5 rounded text-[10px] bg-[#051F20] text-[#8EB69B] hover:text-white border border-[#235347]" data-src="/images/services/outbound-sekolah.webp">Sekolah</button>
                    <button type="button" class="preset-svc-btn px-2 py-0.5 rounded text-[10px] bg-[#051F20] text-[#8EB69B] hover:text-white border border-[#235347]" data-src="/images/services/wisata-adventure.webp">Adventure</button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#235347]">
            <button type="button" id="cancel-btn" class="px-4 py-2 rounded bg-[#0B2B26] hover:bg-[#163832] text-[#8EB69B] border border-[#235347] text-xs font-bold">Batal</button>
            <button type="submit" class="px-5 py-2 rounded bg-[#DAF1DE] hover:bg-white text-[#051F20] font-bold text-xs uppercase shadow-glow-mint">Simpan Layanan</button>
          </div>
        </form>
      </div>
    </dialog>

  </div>

  <script>
    import { SERVICES } from '../../data/defaultContent';
    import { syncServiceToSupabase, deleteServiceFromSupabase } from '../../lib/supabaseSync';

    const tbody = document.getElementById('services-tbody');
    const modal = document.getElementById('service-modal') as HTMLDialogElement | null;
    const form = document.getElementById('service-form') as HTMLFormElement | null;
    const alertBox = document.getElementById('service-alert');

    function getServices() {
      const stored = localStorage.getItem('vo_services');
      return stored ? JSON.parse(stored) : SERVICES;
    }

    function saveServices(list: any[]) {
      localStorage.setItem('vo_services', JSON.stringify(list));
      window.dispatchEvent(new CustomEvent('vo_content_updated', { detail: { key: 'vo_services', data: list } }));
      window.dispatchEvent(new Event('storage'));
      try {
        const bc = new BroadcastChannel('vo_sync_channel');
        bc.postMessage({ type: 'VO_UPDATED', key: 'vo_services', data: list });
      } catch (e) {}
      renderTable();
    }

    function renderTable() {
      if (!tbody) return;
      const list = getServices();

      tbody.innerHTML = list.map((s: any, idx: number) => `
        <tr class="hover:bg-[#163832]/50 transition-colors">
          <td class="py-3 px-4 font-bold text-[#DAF1DE]">${idx + 1}</td>
          <td class="py-3 px-4">
            <img src="${s.imageUrl}" alt="${s.title}" class="w-12 h-8 object-cover rounded bg-[#051F20] border border-[#235347]" />
          </td>
          <td class="py-3 px-4 font-bold text-white">${s.title}</td>
          <td class="py-3 px-4 text-[#8EB69B] font-mono text-[11px]">/layanan/${s.slug}</td>
          <td class="py-3 px-4 text-xs text-[#DAF1DE]/80">${s.targetAudience || '-'}</td>
          <td class="py-3 px-4">
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#235347]/60 text-[#DAF1DE] border border-[#8EB69B]/40">Published</span>
          </td>
          <td class="py-3 px-4 text-right space-x-2">
            <button class="edit-svc-btn px-2.5 py-1 rounded bg-[#163832] hover:bg-[#235347] text-[#DAF1DE] text-[10px] font-bold border border-[#235347]" data-idx="${idx}">
              Edit
            </button>
            <button class="del-svc-btn px-2.5 py-1 rounded bg-[#051F20] hover:bg-rose-950 text-rose-300 text-[10px] border border-[#235347]" data-idx="${idx}">
              Hapus
            </button>
          </td>
        </tr>
      `).join('');

      // Attach edit handlers
      document.querySelectorAll<HTMLButtonElement>('.edit-svc-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.dataset.idx);
          const item = list[idx];
          if (item && modal) {
            (document.getElementById('service-id') as HTMLInputElement).value = String(idx);
            (document.getElementById('svc-title') as HTMLInputElement).value = item.title;
            (document.getElementById('svc-slug') as HTMLInputElement).value = item.slug;
            (document.getElementById('svc-excerpt') as HTMLTextAreaElement).value = item.excerpt;
            (document.getElementById('svc-target') as HTMLInputElement).value = item.targetAudience || '';
            const imgInput = document.getElementById('svc-image') as HTMLInputElement;
            const imgPreview = document.getElementById('svc-img-preview') as HTMLImageElement;
            const imgUrl = item.imageUrl || '/images/services/outbound-perusahaan.webp';
            if (imgInput) imgInput.value = imgUrl;
            if (imgPreview) imgPreview.src = imgUrl;
            modal.showModal();
          }
        });
      });

      // Attach delete handlers
      document.querySelectorAll<HTMLButtonElement>('.del-svc-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          if (confirm('Hapus item layanan ini?')) {
            const idx = Number(btn.dataset.idx);
            const targetSlug = list[idx]?.slug;
            list.splice(idx, 1);
            saveServices(list);
            if (targetSlug) {
              await deleteServiceFromSupabase(targetSlug);
            }
          }
        });
      });
    }

    renderTable();

    document.getElementById('add-service-btn')?.addEventListener('click', () => {
      form?.reset();
      (document.getElementById('service-id') as HTMLInputElement).value = '-1';
      const imgInput = document.getElementById('svc-image') as HTMLInputElement;
      const imgPreview = document.getElementById('svc-img-preview') as HTMLImageElement;
      if (imgInput) imgInput.value = '/images/services/outbound-perusahaan.webp';
      if (imgPreview) imgPreview.src = '/images/services/outbound-perusahaan.webp';
      modal?.showModal();
    });

    document.getElementById('close-modal-btn')?.addEventListener('click', () => modal?.close());
    document.getElementById('cancel-btn')?.addEventListener('click', () => modal?.close());

    // Image preview & upload listeners
    const svcImageInput = document.getElementById('svc-image') as HTMLInputElement | null;
    const svcImagePreview = document.getElementById('svc-img-preview') as HTMLImageElement | null;
    const svcFileInput = document.getElementById('svc-file-input') as HTMLInputElement | null;
    const svcUploadBtn = document.getElementById('svc-upload-btn');

    svcImageInput?.addEventListener('input', () => {
      if (svcImagePreview && svcImageInput.value) {
        svcImagePreview.src = svcImageInput.value;
      }
    });

    svcUploadBtn?.addEventListener('click', () => {
      svcFileInput?.click();
    });

    svcFileInput?.addEventListener('change', () => {
      const file = svcFileInput.files?.[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (ev) => {
          const res = ev.target?.result as string;
          if (svcImageInput) svcImageInput.value = res;
          if (svcImagePreview) svcImagePreview.src = res;
        };
        reader.readAsDataURL(file);
      }
    });

    document.querySelectorAll<HTMLButtonElement>('.preset-svc-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const src = btn.dataset.src;
        if (src) {
          if (svcImageInput) svcImageInput.value = src;
          if (svcImagePreview) svcImagePreview.src = src;
        }
      });
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const list = getServices();
      const idx = Number((document.getElementById('service-id') as HTMLInputElement).value);
      const title = (document.getElementById('svc-title') as HTMLInputElement).value;
      const slug = (document.getElementById('svc-slug') as HTMLInputElement).value;
      const excerpt = (document.getElementById('svc-excerpt') as HTMLTextAreaElement).value;
      const targetAudience = (document.getElementById('svc-target') as HTMLInputElement).value;
      const imageUrl = (document.getElementById('svc-image') as HTMLInputElement)?.value || '/images/services/outbound-perusahaan.webp';

      let savedItem: any;
      if (idx >= 0) {
        list[idx] = { ...list[idx], title, slug, excerpt, targetAudience, imageUrl };
        savedItem = list[idx];
      } else {
        savedItem = {
          id: 'svc-' + Date.now(),
          title,
          slug,
          excerpt,
          overview: excerpt,
          targetAudience,
          benefits: ['Kekompakan tim', 'Peningkatan komunikasi'],
          activities: ['Ice Breaking', 'Team Simulation'],
          locationNote: 'Kawasan Batu Malang',
          imageUrl,
          featured: true,
          sortOrder: list.length + 1
        };
        list.push(savedItem);
      }

      saveServices(list);
      modal?.close();

      // Background Supabase Sync
      syncServiceToSupabase(savedItem);

      if (alertBox) {
        alertBox.className = 'p-3 rounded-lg text-xs font-bold bg-emerald-950 text-emerald-200 border border-emerald-500 block';
        alertBox.textContent = '✓ Data layanan berhasil disimpan ke Front-End & Supabase!';
        setTimeout(() => alertBox.classList.add('hidden'), 2500);
      }
    });
  </script>
</AdminLayout>
