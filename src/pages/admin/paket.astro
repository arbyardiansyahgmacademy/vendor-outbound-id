---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { PACKAGES } from '../../data/defaultContent';
---

<AdminLayout title="Kelola Paket Outbound">
  <div class="space-y-6 text-left">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-rose-900/40">
      <div>
        <h1 class="font-heading font-black text-2xl uppercase tracking-wider text-white flex items-center gap-2.5">
          <i class="fas fa-box-open text-amber-400"></i>
          <span>KELOLA PAKET PILIHAN OUTBOUND</span>
        </h1>
        <p class="text-xs text-rose-300/80 mt-1">
          Daftar paket pilihan outbound dalam 4 kategori (Perusahaan, Family, Sekolah, Adventure).
        </p>
      </div>

      <div class="flex items-center gap-3">
        <select id="pkg-cat-filter" class="px-3 py-2 rounded-lg bg-[#2D0206] border border-rose-800 text-white text-xs">
          <option value="all">Semua Kategori</option>
          <option value="perusahaan">Perusahaan</option>
          <option value="family-gathering">Family Gathering</option>
          <option value="sekolah">Sekolah</option>
          <option value="wisata-adventure">Wisata & Adventure</option>
        </select>
        <button
          id="add-pkg-btn"
          type="button"
          class="px-4 py-2 rounded-lg bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold text-xs uppercase tracking-wider shadow"
        >
          + Tambah Paket
        </button>
      </div>
    </div>

    <div id="pkg-alert" class="hidden p-3 rounded-lg text-xs font-bold"></div>

    <!-- Table -->
    <div class="rounded-2xl bg-[#300205]/90 border border-rose-700/40 overflow-hidden shadow-2xl">
      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left">
          <thead class="bg-[#240104] text-[10px] uppercase font-bold text-rose-300/80 border-b border-rose-900/60">
            <tr>
              <th class="py-3 px-4">Nama Paket</th>
              <th class="py-3 px-4">Kategori</th>
              <th class="py-3 px-4">Durasi</th>
              <th class="py-3 px-4">Estimasi Harga</th>
              <th class="py-3 px-4">Status</th>
              <th class="py-3 px-4 text-right">Tindakan</th>
            </tr>
          </thead>
          <tbody id="packages-tbody" class="divide-y divide-rose-900/30 text-rose-100">
            <!-- Populated via script -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Modal Form -->
    <dialog id="pkg-modal" class="backdrop:bg-stone-950/80 bg-transparent p-4 max-w-xl w-full mx-auto my-auto text-white focus:outline-none">
      <div class="rounded-2xl bg-[#330206] border border-rose-600/50 p-6 shadow-2xl space-y-4 text-left">
        <div class="flex items-center justify-between border-b border-rose-900/50 pb-3">
          <h3 id="modal-pkg-title" class="font-heading font-black text-lg text-white uppercase tracking-wider">
            Tambah / Edit Paket
          </h3>
          <button id="close-pkg-modal-btn" type="button" class="text-rose-300 hover:text-white text-lg font-bold">✕</button>
        </div>

        <form id="pkg-form" class="space-y-3.5">
          <input type="hidden" id="pkg-idx" />

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-rose-200 mb-1">Nama Paket</label>
            <input type="text" id="p-title" required class="w-full px-3 py-2 rounded bg-stone-950/70 border border-rose-800 text-white text-xs focus:outline-none focus:border-amber-400" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-rose-200 mb-1">Kategori</label>
              <select id="p-category" required class="w-full px-3 py-2 rounded bg-stone-950/70 border border-rose-800 text-white text-xs">
                <option value="perusahaan">Perusahaan</option>
                <option value="family-gathering">Family Gathering</option>
                <option value="sekolah">Sekolah</option>
                <option value="wisata-adventure">Wisata & Adventure</option>
              </select>
            </div>
            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-rose-200 mb-1">Durasi</label>
              <input type="text" id="p-duration" placeholder="Contoh: 1 Hari" class="w-full px-3 py-2 rounded bg-stone-950/70 border border-rose-800 text-white text-xs focus:outline-none focus:border-amber-400" />
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-rose-200 mb-1">Ringkasan / Excerpt</label>
            <textarea id="p-excerpt" rows="2" required class="w-full px-3 py-2 rounded bg-stone-950/70 border border-rose-800 text-white text-xs focus:outline-none focus:border-amber-400"></textarea>
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-rose-200 mb-1">Label Harga / Status</label>
            <input type="text" id="p-price" value="Konsultasikan kebutuhan paket" class="w-full px-3 py-2 rounded bg-stone-950/70 border border-rose-800 text-white text-xs focus:outline-none focus:border-amber-400" />
          </div>

          <div class="flex items-center justify-end gap-3 pt-3 border-t border-rose-900/50">
            <button type="button" id="cancel-pkg-btn" class="px-4 py-2 rounded bg-stone-900 text-rose-300 text-xs font-bold">Batal</button>
            <button type="submit" class="px-5 py-2 rounded bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold text-xs uppercase">Simpan Paket</button>
          </div>
        </form>
      </div>
    </dialog>

  </div>

  <script>
    import { PACKAGES } from '../../data/defaultContent';

    const tbody = document.getElementById('packages-tbody');
    const modal = document.getElementById('pkg-modal') as HTMLDialogElement | null;
    const form = document.getElementById('pkg-form') as HTMLFormElement | null;
    const filter = document.getElementById('pkg-cat-filter') as HTMLSelectElement | null;
    const alertBox = document.getElementById('pkg-alert');

    function getPackages() {
      const stored = localStorage.getItem('vo_packages');
      return stored ? JSON.parse(stored) : PACKAGES;
    }

    function savePackages(list: any[]) {
      localStorage.setItem('vo_packages', JSON.stringify(list));
      renderTable();
    }

    function renderTable() {
      if (!tbody) return;
      let list = getPackages();
      const catVal = filter?.value || 'all';

      if (catVal !== 'all') {
        list = list.filter((p: any) => p.categorySlug === catVal);
      }

      tbody.innerHTML = list.map((p: any, idx: number) => `
        <tr class="hover:bg-rose-950/40 transition-colors">
          <td class="py-3 px-4 font-bold text-white">${p.title}</td>
          <td class="py-3 px-4 text-amber-300 font-semibold">${p.categoryName}</td>
          <td class="py-3 px-4 text-rose-200/80">${p.duration}</td>
          <td class="py-3 px-4 text-[11px] text-rose-300/70">${p.priceLabel}</td>
          <td class="py-3 px-4">
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-300">Published</span>
          </td>
          <td class="py-3 px-4 text-right space-x-2">
            <button class="edit-p-btn px-2.5 py-1 rounded bg-amber-500/20 hover:bg-amber-500 hover:text-stone-950 text-amber-300 text-[10px] font-bold border border-amber-500/40" data-idx="${idx}">
              Edit
            </button>
            <button class="del-p-btn px-2.5 py-1 rounded bg-rose-950 hover:bg-rose-900 text-rose-300 text-[10px] border border-rose-800/40" data-idx="${idx}">
              Hapus
            </button>
          </td>
        </tr>
      `).join('');

      document.querySelectorAll<HTMLButtonElement>('.edit-p-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.dataset.idx);
          const item = list[idx];
          if (item && modal) {
            (document.getElementById('pkg-idx') as HTMLInputElement).value = String(idx);
            (document.getElementById('p-title') as HTMLInputElement).value = item.title;
            (document.getElementById('p-category') as HTMLSelectElement).value = item.categorySlug;
            (document.getElementById('p-duration') as HTMLInputElement).value = item.duration;
            (document.getElementById('p-excerpt') as HTMLTextAreaElement).value = item.excerpt;
            (document.getElementById('p-price') as HTMLInputElement).value = item.priceLabel;
            modal.showModal();
          }
        });
      });

      document.querySelectorAll<HTMLButtonElement>('.del-p-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          if (confirm('Hapus paket ini?')) {
            const idx = Number(btn.dataset.idx);
            list.splice(idx, 1);
            savePackages(list);
          }
        });
      });
    }

    renderTable();

    filter?.addEventListener('change', renderTable);

    document.getElementById('add-pkg-btn')?.addEventListener('click', () => {
      form?.reset();
      (document.getElementById('pkg-idx') as HTMLInputElement).value = '-1';
      modal?.showModal();
    });

    document.getElementById('close-pkg-modal-btn')?.addEventListener('click', () => modal?.close());
    document.getElementById('cancel-pkg-btn')?.addEventListener('click', () => modal?.close());

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const list = getPackages();
      const idx = Number((document.getElementById('pkg-idx') as HTMLInputElement).value);
      const title = (document.getElementById('p-title') as HTMLInputElement).value;
      const categorySlug = (document.getElementById('p-category') as HTMLSelectElement).value;
      const duration = (document.getElementById('p-duration') as HTMLInputElement).value;
      const excerpt = (document.getElementById('p-excerpt') as HTMLTextAreaElement).value;
      const priceLabel = (document.getElementById('p-price') as HTMLInputElement).value;

      const categoryName = categorySlug === 'perusahaan' ? 'Perusahaan' :
        categorySlug === 'family-gathering' ? 'Family Gathering' :
        categorySlug === 'sekolah' ? 'Sekolah' : 'Wisata & Adventure';

      if (idx >= 0) {
        list[idx] = { ...list[idx], title, categorySlug, categoryName, duration, excerpt, priceLabel };
      } else {
        list.push({
          id: 'pkg-' + Date.now(),
          categorySlug,
          categoryName,
          title,
          slug: title.toLowerCase().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-'),
          excerpt,
          imageUrl: '/images/packages/team-building.webp',
          activities: ['Aktivitas Tim Terpilih'],
          features: ['Instruktur & Fasilitator', 'Air Mineral', 'P3K'],
          duration,
          priceLabel,
          featured: false,
          sortOrder: list.length + 1
        });
      }

      savePackages(list);
      modal?.close();

      if (alertBox) {
        alertBox.className = 'p-3 rounded-lg text-xs font-bold bg-emerald-950 text-emerald-200 border border-emerald-500 block';
        alertBox.textContent = '✓ Data paket berhasil disimpan!';
        setTimeout(() => alertBox.classList.add('hidden'), 2500);
      }
    });
  </script>
</AdminLayout>
