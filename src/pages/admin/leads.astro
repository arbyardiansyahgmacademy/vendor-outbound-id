---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Kelola Leads Masuk">
  <div class="space-y-6 text-left">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#163832]">
      <div>
        <h1 class="font-heading font-black text-2xl uppercase tracking-wider text-white flex items-center gap-2.5">
          <i class="fas fa-inbox text-[#DAF1DE]"></i>
          <span>LEADS &amp; KONSULTASI MASUK</span>
        </h1>
        <p class="text-xs text-[#8EB69B] mt-1">
          Daftar seluruh calon pelanggan yang mengisi formulir konsultasi website.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <input
          type="text"
          id="lead-search-input"
          placeholder="Cari nama / WhatsApp..."
          class="px-3.5 py-2 rounded-lg bg-[#051F20]/90 border border-[#235347] text-[#DAF1DE] placeholder-[#8EB69B]/40 text-xs focus:outline-none focus:border-[#8EB69B]"
        />
        <select
          id="lead-status-filter"
          class="px-3 py-2 rounded-lg bg-[#0B2B26] border border-[#235347] text-[#DAF1DE] text-xs focus:outline-none focus:border-[#8EB69B]"
        >
          <option value="all">Semua Status</option>
          <option value="Baru">Baru</option>
          <option value="Dihubungi">Dihubungi</option>
          <option value="Follow-up">Follow-up</option>
          <option value="Selesai">Selesai</option>
          <option value="Spam">Spam</option>
        </select>
      </div>
    </div>

    <!-- Leads Table Container -->
    <div class="rounded-2xl bg-[#0B2B26] border border-[#235347] overflow-hidden shadow-2xl">
      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left">
          <thead class="bg-[#072522] text-[10px] uppercase font-bold text-[#8EB69B] border-b border-[#163832]">
            <tr>
              <th class="py-3 px-4">Tanggal Masuk</th>
              <th class="py-3 px-4">Nama &amp; Instansi</th>
              <th class="py-3 px-4">Kontak WhatsApp</th>
              <th class="py-3 px-4">Program</th>
              <th class="py-3 px-4">Est. Peserta &amp; Lokasi</th>
              <th class="py-3 px-4">Pesan Konsultasi</th>
              <th class="py-3 px-4">Status</th>
              <th class="py-3 px-4 text-right">Tindakan</th>
            </tr>
          </thead>
          <tbody id="leads-table-body" class="divide-y divide-[#163832] text-[#DAF1DE]/90">
            <!-- Populated via script -->
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <script>
    import { DEFAULT_LEADS } from '../../lib/adminStore';

    const tbody = document.getElementById('leads-table-body');
    const searchInput = document.getElementById('lead-search-input') as HTMLInputElement | null;
    const filterSelect = document.getElementById('lead-status-filter') as HTMLSelectElement | null;

    function getLeads() {
      const stored = localStorage.getItem('vo_leads');
      return stored ? JSON.parse(stored) : DEFAULT_LEADS;
    }

    function saveLeads(leads: any[]) {
      localStorage.setItem('vo_leads', JSON.stringify(leads));
      renderTable();
    }

    function renderTable() {
      if (!tbody) return;
      let leads = getLeads();

      const query = searchInput?.value.toLowerCase().trim() || '';
      const statusFilter = filterSelect?.value || 'all';

      if (query) {
        leads = leads.filter((l: any) => 
          l.name.toLowerCase().includes(query) ||
          l.whatsapp.includes(query) ||
          (l.organization && l.organization.toLowerCase().includes(query))
        );
      }

      if (statusFilter !== 'all') {
        leads = leads.filter((l: any) => l.status === statusFilter);
      }

      if (leads.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" class="py-8 text-center text-[#8EB69B]">Tidak ada leads yang sesuai filter.</td></tr>`;
        return;
      }

      tbody.innerHTML = leads.map((l: any, idx: number) => {
        const waClean = l.whatsapp.replace(/[^0-9]/g, '');
        const waUrl = `https://wa.me/${waClean}?text=${encodeURIComponent(`Halo ${l.name}, kami dari tim Provider Outbound Batu Malang ingin mengonfirmasi permintaan konsultasi program ${l.service_type}.`)}`;

        return `
          <tr class="hover:bg-[#163832]/50 transition-colors">
            <td class="py-3.5 px-4 text-[11px] text-[#8EB69B]/70 whitespace-nowrap">
              ${new Date(l.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}
            </td>
            <td class="py-3.5 px-4">
              <div class="font-bold text-white text-xs">${l.name}</div>
              <div class="text-[11px] text-[#8EB69B]">${l.organization || '-'}</div>
            </td>
            <td class="py-3.5 px-4 font-mono text-[#DAF1DE]">
              ${l.whatsapp}
            </td>
            <td class="py-3.5 px-4 font-semibold text-white">
              ${l.service_type}
            </td>
            <td class="py-3.5 px-4 text-[11px]">
              <div>${l.participant_count ? l.participant_count + ' Peserta' : '-'}</div>
              <div class="text-[#8EB69B]">${l.preferred_location || 'Batu/Malang'}</div>
            </td>
            <td class="py-3.5 px-4 max-w-xs">
              <div class="text-xs text-[#DAF1DE]/80 line-clamp-2" title="${l.message}">
                ${l.message}
              </div>
            </td>
            <td class="py-3.5 px-4 whitespace-nowrap">
              <select
                class="status-changer px-2 py-1 rounded text-[11px] font-bold bg-[#051F20] border border-[#235347] text-[#DAF1DE]"
                data-lead-idx="${idx}"
              >
                <option value="Baru" ${l.status === 'Baru' ? 'selected' : ''}>Baru</option>
                <option value="Dihubungi" ${l.status === 'Dihubungi' ? 'selected' : ''}>Dihubungi</option>
                <option value="Follow-up" ${l.status === 'Follow-up' ? 'selected' : ''}>Follow-up</option>
                <option value="Selesai" ${l.status === 'Selesai' ? 'selected' : ''}>Selesai</option>
                <option value="Spam" ${l.status === 'Spam' ? 'selected' : ''}>Spam</option>
              </select>
            </td>
            <td class="py-3.5 px-4 text-right space-x-1.5 whitespace-nowrap">
              <a
                href="${waUrl}"
                target="_blank"
                class="px-2.5 py-1.5 rounded bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-[10px] inline-flex items-center gap-1 shadow"
              >
                <span>Chat WA</span>
              </a>
              <button
                type="button"
                class="delete-lead-btn px-2 py-1.5 rounded bg-[#163832] hover:bg-rose-950 text-rose-300 text-[10px] border border-[#235347]"
                data-lead-idx="${idx}"
              >
                Hapus
              </button>
            </td>
          </tr>
        `;
      }).join('');

      // Attach event listeners for status change
      document.querySelectorAll<HTMLSelectElement>('.status-changer').forEach(sel => {
        sel.addEventListener('change', (e) => {
          const target = e.target as HTMLSelectElement;
          const idx = Number(target.dataset.leadIdx);
          const allLeads = getLeads();
          if (allLeads[idx]) {
            allLeads[idx].status = target.value;
            saveLeads(allLeads);
          }
        });
      });

      // Attach event listeners for delete
      document.querySelectorAll<HTMLButtonElement>('.delete-lead-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          if (confirm('Hapus data lead ini?')) {
            const idx = Number(btn.dataset.leadIdx);
            const allLeads = getLeads();
            allLeads.splice(idx, 1);
            saveLeads(allLeads);
          }
        });
      });
    }

    renderTable();

    searchInput?.addEventListener('input', renderTable);
    filterSelect?.addEventListener('change', renderTable);
  </script>
</AdminLayout>
