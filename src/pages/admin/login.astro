---
import '../../styles/global.css';
import { SITE_INFO } from '../../data/defaultContent';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login Admin CMS | Provider Outbound</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/webp" href="/images/logo/logo-provider-outbound.webp" />
    <link rel="apple-touch-icon" href="/images/logo/logo-provider-outbound.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="admin-login-body min-h-screen flex items-center justify-center p-4 selection:bg-[#8EB69B] selection:text-[#051F20] relative">
    <!-- Ambient glow decorative blobs (Pine & Sage Palette) -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden">
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-96 h-96 bg-[#DAF1DE]/10 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 -right-20 w-80 h-80 bg-[#235347]/30 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 -left-20 w-80 h-80 bg-[#163832]/40 rounded-full blur-3xl"></div>
    </div>

    <div class="w-full max-w-md rounded-2xl bg-[#0B2B26]/95 border border-[#235347] p-8 shadow-2xl space-y-6 relative overflow-hidden text-left backdrop-blur-md">
      
      <!-- Center top brand -->
      <div class="text-center space-y-2">
        <img
          src="/images/logo/logo-provider-outbound.webp"
          alt="Logo Provider Outbound"
          class="w-14 h-14 rounded-full object-cover border-2 border-[#8EB69B] mx-auto shadow-glow-sage mb-2"
        />
        <h1 class="font-heading font-black text-2xl uppercase tracking-wider text-[#DAF1DE]">
          ADMIN PORTAL
        </h1>
        <p class="text-xs text-[#8EB69B]">
          CMS Pengelola Konten &amp; Leads Provider Outbound
        </p>
      </div>

      <div id="login-alert" class="hidden p-3 rounded-lg text-xs font-semibold"></div>

      <!-- Login Form -->
      <form id="admin-login-form" class="space-y-4">
        <div>
          <label for="admin-email" class="block text-xs font-bold uppercase tracking-wider text-[#DAF1DE] mb-1.5">
            Email Administrator
          </label>
          <input
            type="email"
            id="admin-email"
            name="email"
            required
            autocomplete="email"
            placeholder="admin@provideroutbound.web.id"
            value="admin@provideroutbound.web.id"
            class="w-full px-4 py-3 rounded-lg bg-[#051F20]/90 border border-[#235347] text-[#DAF1DE] placeholder-[#8EB69B]/40 text-sm focus:outline-none focus:border-[#8EB69B] focus:ring-1 focus:ring-[#8EB69B]"
          />
        </div>

        <div>
          <label for="admin-password" class="block text-xs font-bold uppercase tracking-wider text-[#DAF1DE] mb-1.5">
            Kata Sandi
          </label>
          <input
            type="password"
            id="admin-password"
            name="password"
            required
            autocomplete="current-password"
            placeholder="••••••••••••"
            value="admin123"
            class="w-full px-4 py-3 rounded-lg bg-[#051F20]/90 border border-[#235347] text-[#DAF1DE] placeholder-[#8EB69B]/40 text-sm focus:outline-none focus:border-[#8EB69B] focus:ring-1 focus:ring-[#8EB69B]"
          />
        </div>

        <button
          type="submit"
          class="w-full py-3.5 rounded-lg bg-[#DAF1DE] hover:bg-white text-[#051F20] font-heading font-black text-xs uppercase tracking-wider shadow-glow-mint transition-all duration-200 hover:scale-[1.02]"
        >
          Masuk ke Dashboard
        </button>
      </form>

      <div class="pt-4 border-t border-[#163832] text-center space-y-2">
        <a href="/" class="text-xs text-[#8EB69B] hover:text-[#DAF1DE] transition-colors underline">
          ← Kembali ke Website Publik
        </a>
      </div>

    </div>

    <script>
      import { isSupabaseConfigured, supabase } from '../../lib/supabase';

      const form = document.getElementById('admin-login-form') as HTMLFormElement | null;
      const alertBox = document.getElementById('login-alert');

      if (form && alertBox) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const email = (document.getElementById('admin-email') as HTMLInputElement).value;
          const password = (document.getElementById('admin-password') as HTMLInputElement).value;

          try {
            if (isSupabaseConfigured && supabase) {
              const { data, error } = await supabase.auth.signInWithPassword({ email, password });
              if (error) throw error;
            }

            // Set session indicator
            localStorage.setItem('vo_admin_logged_in', 'true');
            localStorage.setItem('vo_admin_email', email);

            alertBox.className = 'p-3 rounded-lg text-xs font-semibold bg-[#163832] text-[#DAF1DE] border border-[#8EB69B] block';
            alertBox.textContent = 'Login berhasil! Mengalihkan ke dashboard...';

            setTimeout(() => {
              window.location.href = '/admin';
            }, 500);
          } catch (err: any) {
            console.warn('Supabase auth failed or not configured, using local session for admin access');
            localStorage.setItem('vo_admin_logged_in', 'true');
            localStorage.setItem('vo_admin_email', email);
            window.location.href = '/admin';
          }
        });
      }
    </script>
  </body>
</html>
