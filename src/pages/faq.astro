---
import PublicLayout from '../layouts/PublicLayout.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import CTASection from '../components/sections/CTASection.astro';
import { FAQS } from '../data/defaultContent';

const breadcrumbs = [
  { name: 'FAQ & Pusat Bantuan' }
];
---

<PublicLayout
  title="Pusat Bantuan & FAQ Outbound Batu Malang | Provider Outbound"
  description="Pertanyaan yang sering diajukan seputar paket outbound, lokasi di Kota Batu & Malang, SOP keselamatan fasilitator BNSP, dan prosedur pemesanan gathering."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section -->
  <section class="py-16 sm:py-24 relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/15 border border-amber-400/30 text-amber-300 text-xs font-bold uppercase tracking-widest">
        <i class="fas fa-question-circle text-[10px]"></i> Pusat Informasi &amp; Jawaban Cepat
      </span>
      <h1 class="font-heading font-black text-3xl sm:text-5xl uppercase tracking-[0.14em] text-white">
        PERTANYAAN SERING DIAJUKAN (FAQ)
      </h1>
      <p class="text-base sm:text-lg text-rose-100/85 max-w-3xl mx-auto leading-relaxed">
        Temukan jawaban lengkap seputar teknis simulasi outbound, pilihan venue di Batu Malang, skema anggaran all-in, serta SOP cuaca darurat di alam bebas.
      </p>

      <!-- Instant FAQ Search Box -->
      <div class="max-w-xl mx-auto pt-4">
        <div class="relative">
          <input
            type="text"
            id="faq-search-input"
            placeholder="Ketik kata kunci (misal: cuaca, venue, bujet, kapasitas)..."
            class="w-full px-5 py-3.5 pl-12 rounded-xl bg-[#350206] border border-rose-700/50 text-white placeholder-rose-300/60 text-xs sm:text-sm focus:outline-none focus:border-amber-400 shadow-xl transition-all"
          />
          <i class="fas fa-search absolute left-4.5 top-1/2 -translate-y-1/2 text-amber-400 text-sm"></i>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Accordion Container -->
  <section class="py-8 border-t border-rose-900/40">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div id="page-faq-accordion-list" class="space-y-3.5 faq-accordion-container">
        {FAQS.map((faq, index) => (
          <details
            name="faq-page"
            class="faq-card-item group rounded-xl bg-[#480308]/60 border border-rose-700/35 p-5 transition-colors open:bg-[#5C060E]/80 open:border-amber-400/50"
            open={index === 0}
          >
            <summary class="flex items-center justify-between gap-4 font-heading font-bold text-base sm:text-lg text-white cursor-pointer select-none list-none group-open:text-amber-300">
              <span class="faq-q-text">{faq.question}</span>
              <div class="w-7 h-7 rounded-full bg-rose-950/80 border border-rose-700/50 flex items-center justify-center text-amber-400 flex-shrink-0 group-open:rotate-180 transition-transform duration-200">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </summary>
            <div class="pt-4 mt-3 border-t border-rose-800/40 text-xs sm:text-sm text-rose-100/85 leading-relaxed">
              <p class="faq-a-text">{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
      <div id="faq-not-found" class="hidden text-center py-12 text-rose-300/80">
        <i class="fas fa-info-circle text-2xl text-amber-400 mb-2"></i>
        <p class="text-sm font-semibold">Tidak ditemukan pertanyaan yang cocok dengan pencarian Anda.</p>
        <p class="text-xs text-rose-400/70 mt-1">Silakan tanyakan langsung melalui WhatsApp tim konsultan kami.</p>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <CTASection />

  <!-- FAQ Live Filter & Hydration Script -->
  <script is:inline>
    (function() {
      var searchInput = document.getElementById('faq-search-input');
      var notFoundEl = document.getElementById('faq-not-found');

      function filterFaqs() {
        var term = (searchInput ? searchInput.value : '').toLowerCase().trim();
        var items = document.querySelectorAll('.faq-card-item');
        var matched = 0;

        items.forEach(function(item) {
          var q = (item.querySelector('.faq-q-text')?.textContent || '').toLowerCase();
          var a = (item.querySelector('.faq-a-text')?.textContent || '').toLowerCase();
          if (!term || q.indexOf(term) !== -1 || a.indexOf(term) !== -1) {
            item.style.display = '';
            matched++;
          } else {
            item.style.display = 'none';
          }
        });

        if (notFoundEl) {
          notFoundEl.classList.toggle('hidden', matched > 0);
        }
      }

      if (searchInput) {
        searchInput.addEventListener('input', filterFaqs);
      }

      function hydratePageFaqs() {
        var raw = localStorage.getItem('vo_faqs');
        if (!raw) return;
        try {
          var list = JSON.parse(raw);
          if (!Array.isArray(list) || list.length === 0) return;
          var container = document.getElementById('page-faq-accordion-list');
          if (!container) return;

          container.innerHTML = list.map(function(faq, index) {
            return (
              '<details name="faq-page" class="faq-card-item group rounded-xl bg-[#480308]/60 border border-rose-700/35 p-5 transition-colors open:bg-[#5C060E]/80 open:border-amber-400/50"' + (index === 0 ? ' open' : '') + '>' +
                '<summary class="flex items-center justify-between gap-4 font-heading font-bold text-base sm:text-lg text-white cursor-pointer select-none list-none group-open:text-amber-300">' +
                  '<span class="faq-q-text">' + faq.question + '</span>' +
                  '<div class="w-7 h-7 rounded-full bg-rose-950/80 border border-rose-700/50 flex items-center justify-center text-amber-400 flex-shrink-0 group-open:rotate-180 transition-transform duration-200">' +
                    '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>' +
                  '</div>' +
                '</summary>' +
                '<div class="pt-4 mt-3 border-t border-rose-800/40 text-xs sm:text-sm text-rose-100/85 leading-relaxed">' +
                  '<p class="faq-a-text">' + faq.answer + '</p>' +
                '</div>' +
              '</details>'
            );
          }).join('');

          filterFaqs();
        } catch (e) {
          console.error('Hydrate FAQ page error:', e);
        }
      }

      hydratePageFaqs();
      document.addEventListener('DOMContentLoaded', hydratePageFaqs);
      window.addEventListener('storage', function(e) {
        if (e.key === 'vo_faqs') hydratePageFaqs();
      });
      window.addEventListener('vo_content_updated', function(e) {
        if (!e.detail || e.detail.key === 'vo_faqs') hydratePageFaqs();
      });
      try {
        var bc = new BroadcastChannel('vo_sync_channel');
        bc.onmessage = function(e) {
          if (!e.data || e.data.key === 'vo_faqs') {
            hydratePageFaqs();
          }
        };
      } catch (err) {}
    })();
  </script>
</PublicLayout>
