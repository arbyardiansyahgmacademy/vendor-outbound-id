---
interface Props {
  headings: { id: string; text: string; level: number }[];
}

const { headings } = Astro.props;
---

{headings.length > 0 && (
  <nav aria-label="Daftar Isi Artikel" class="rounded-xl bg-[#450308]/60 border border-rose-700/40 p-5 my-6 shadow-md">
    <div class="flex items-center gap-2 mb-3 text-amber-400 font-heading font-black text-sm uppercase tracking-wider">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h7" />
      </svg>
      <span>Daftar Isi Panduan</span>
    </div>

    <ul class="space-y-2 text-xs sm:text-sm">
      {headings.map((h) => (
        <li class={h.level === 3 ? 'pl-4' : ''}>
          <a
            href={`#${h.id}`}
            class="text-rose-200/85 hover:text-amber-400 transition-colors flex items-center gap-1.5"
          >
            <span class="text-amber-500/60 font-bold">•</span>
            <span>{h.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
