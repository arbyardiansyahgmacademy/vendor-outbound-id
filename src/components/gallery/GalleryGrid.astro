---
import { GALLERY_ITEMS } from '../../data/defaultContent';

const categories = ['Semua', 'Perusahaan', 'Family Gathering', 'Sekolah', 'Wisata & Adventure'];
---

<div class="space-y-8">
  
  <!-- Category Filter Pills -->
  <div class="flex flex-wrap items-center justify-center gap-2" role="tablist" aria-label="Filter Galeri">
    {categories.map((cat, idx) => (
      <button
        type="button"
        class={`gallery-filter-btn px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-200 ${
          idx === 0
            ? 'bg-amber-500 text-stone-950 shadow-glow-amber'
            : 'bg-brand-950/70 text-rose-200 border border-rose-800/40 hover:bg-rose-900/60 hover:text-white'
        }`}
        data-filter={cat === 'Semua' ? 'all' : cat}
      >
        {cat}
      </button>
    ))}
  </div>

  <!-- Gallery Image Grid -->
  <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {GALLERY_ITEMS.map((item, index) => (
      <div
        class="gallery-item group relative rounded-xl overflow-hidden bg-[#450307] border border-rose-700/35 cursor-pointer shadow-card hover:border-amber-400/60 transition-all duration-300 w-full"
        data-category={item.category}
        data-index={index}
        data-src={item.imageUrl}
        data-title={item.title}
        data-caption={item.caption}
        style="aspect-ratio: 3 / 2;"
      >
        <img
          src={item.imageUrl}
          alt={item.altText}
          width={item.width}
          height={item.height}
          class="w-full h-full object-cover object-center group-hover:scale-108 transition-transform duration-500 block"
          loading="lazy"
        />

        <!-- Hover Overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-stone-950/95 via-stone-950/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-5 flex flex-col justify-end text-left">
          <span class="text-[10px] uppercase font-bold text-amber-400 tracking-wider">
            {item.category}
          </span>
          <h3 class="text-base font-heading font-black text-white uppercase tracking-wider mt-1">
            {item.title}
          </h3>
          <p class="text-xs text-rose-200/80 mt-1 line-clamp-2">
            {item.caption}
          </p>
          <div class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold text-amber-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
            </svg>
            <span>Klik untuk memperbesar</span>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Native HTML5 Dialog Lightbox (accessible, handles Esc natively, top layer) -->
  <dialog
    id="gallery-lightbox"
    class="backdrop:bg-stone-950/90 bg-transparent p-4 sm:p-6 max-w-4xl w-full mx-auto my-auto text-white focus:outline-none"
    aria-label="Tampilan Foto Penuh"
  >
    <div class="relative rounded-2xl bg-[#300104] border border-rose-700/50 p-4 sm:p-6 shadow-2xl overflow-hidden flex flex-col items-center">
      
      <!-- Close button -->
      <button
        id="lightbox-close"
        type="button"
        class="absolute top-4 right-4 z-20 w-10 h-10 rounded-full bg-stone-950/80 hover:bg-amber-500 hover:text-stone-950 text-white border border-rose-500/40 flex items-center justify-center transition-all focus:outline-none focus:ring-2 focus:ring-amber-400"
        aria-label="Tutup foto"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Navigation buttons -->
      <button
        id="lightbox-prev"
        type="button"
        class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-stone-950/80 hover:bg-amber-500 hover:text-stone-950 text-white border border-rose-500/40 flex items-center justify-center transition-all focus:outline-none focus:ring-2 focus:ring-amber-400"
        aria-label="Foto sebelumnya"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button
        id="lightbox-next"
        type="button"
        class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-stone-950/80 hover:bg-amber-500 hover:text-stone-950 text-white border border-rose-500/40 flex items-center justify-center transition-all focus:outline-none focus:ring-2 focus:ring-amber-400"
        aria-label="Foto berikutnya"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Large Image View -->
      <div class="w-full max-h-[65vh] flex items-center justify-center overflow-hidden rounded-lg bg-black/40">
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="max-w-full max-h-[65vh] object-contain rounded"
        />
      </div>

      <!-- Caption & Metadata -->
      <div class="w-full mt-4 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-2 px-2">
        <div>
          <h4 id="lightbox-title" class="font-heading font-black text-lg text-white uppercase tracking-wider"></h4>
          <p id="lightbox-caption" class="text-xs text-rose-200/80 mt-0.5"></p>
        </div>
        <div id="lightbox-counter" class="text-xs font-bold text-amber-400 bg-amber-500/10 px-3 py-1 rounded-full border border-amber-400/30"></div>
      </div>

    </div>
  </dialog>

</div>

<script is:inline>
  (function() {
    var dialog = document.getElementById('gallery-lightbox');
    var lbImg = document.getElementById('lightbox-img');
    var lbTitle = document.getElementById('lightbox-title');
    var lbCaption = document.getElementById('lightbox-caption');
    var lbCounter = document.getElementById('lightbox-counter');
    var closeBtn = document.getElementById('lightbox-close');
    var prevBtn = document.getElementById('lightbox-prev');
    var nextBtn = document.getElementById('lightbox-next');

    var currentIndex = 0;

    function getVisibleItems() {
      var all = document.querySelectorAll('.gallery-item');
      return Array.prototype.filter.call(all, function(item) {
        return !item.classList.contains('hidden');
      });
    }

    function updateLightbox(idx) {
      var activeList = getVisibleItems();
      if (activeList.length === 0) return;

      currentIndex = (idx + activeList.length) % activeList.length;
      var target = activeList[currentIndex];

      if (lbImg && lbTitle && lbCaption && lbCounter) {
        var targetImg = target.querySelector('img');
        var targetSrc = target.getAttribute('data-src') || (targetImg ? targetImg.getAttribute('src') : '') || '';
        lbImg.src = targetSrc;
        lbImg.alt = target.getAttribute('data-title') || '';
        lbTitle.textContent = target.getAttribute('data-title') || '';
        lbCaption.textContent = target.getAttribute('data-caption') || '';
        lbCounter.textContent = (currentIndex + 1) + ' / ' + activeList.length;
      }
    }

    function bindItemClicks() {
      var allItems = document.querySelectorAll('.gallery-item');
      allItems.forEach(function(item) {
        item.onclick = function() {
          var activeList = getVisibleItems();
          var idx = activeList.indexOf(item);
          if (idx !== -1 && dialog) {
            updateLightbox(idx);
            dialog.showModal();
          }
        };
      });
    }

    function bindFilterButtons() {
      var filterBtns = document.querySelectorAll('.gallery-filter-btn');
      filterBtns.forEach(function(btn) {
        btn.onclick = function() {
          var filter = btn.getAttribute('data-filter') || 'all';

          filterBtns.forEach(function(b) {
            b.classList.remove('bg-amber-500', 'text-stone-950', 'shadow-glow-amber');
            b.classList.add('bg-brand-950/70', 'text-rose-200');
          });
          btn.classList.add('bg-amber-500', 'text-stone-950', 'shadow-glow-amber');
          btn.classList.remove('bg-brand-950/70', 'text-rose-200');

          var allItems = document.querySelectorAll('.gallery-item');
          allItems.forEach(function(card) {
            var cat = card.getAttribute('data-category');
            if (filter === 'all' || cat === filter) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          });
        };
      });
    }

    function hydrateGalleryGrid() {
      var raw = localStorage.getItem('vo_gallery');
      if (!raw) {
        bindItemClicks();
        bindFilterButtons();
        return;
      }
      try {
        var list = JSON.parse(raw);
        if (!Array.isArray(list) || list.length === 0) {
          bindItemClicks();
          bindFilterButtons();
          return;
        }

        var needsResave = false;
        list.forEach(function(item) {
          if (!item.imageUrl && (item.publicUrl || item.public_url)) {
            item.imageUrl = item.publicUrl || item.public_url;
            needsResave = true;
          }
        });
        if (needsResave) {
          try {
            localStorage.setItem('vo_gallery', JSON.stringify(list));
          } catch(err) {}
        }

        var grid = document.getElementById('gallery-grid');
        if (!grid) return;

        grid.innerHTML = list.map(function(item, index) {
          var imgUrl = item.imageUrl || item.publicUrl || item.public_url || '';
          return (
            '<div class="gallery-item group relative rounded-xl overflow-hidden bg-[#450307] border border-rose-700/35 cursor-pointer shadow-card hover:border-amber-400/60 transition-all duration-300 w-full" ' +
              'data-category="' + (item.category || 'Outbound') + '" ' +
              'data-index="' + index + '" ' +
              'data-src="' + imgUrl + '" ' +
              'data-title="' + (item.title || '') + '" ' +
              'data-caption="' + (item.caption || '') + '" ' +
              'style="aspect-ratio: 3 / 2;">' +
              '<img src="' + imgUrl + '" alt="' + (item.altText || item.title || 'Foto Galeri') + '" width="600" height="400" class="w-full h-full object-cover object-center group-hover:scale-108 transition-transform duration-500 block" loading="lazy" />' +
              '<div class="absolute inset-0 bg-gradient-to-t from-stone-950/95 via-stone-950/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-5 flex flex-col justify-end text-left">' +
                '<span class="text-[10px] uppercase font-bold text-amber-400 tracking-wider">' +
                  (item.category || 'Outbound') +
                '</span>' +
                '<h3 class="text-base font-heading font-black text-white uppercase tracking-wider mt-1">' +
                  (item.title || '') +
                '</h3>' +
                '<p class="text-xs text-rose-200/80 mt-1 line-clamp-2">' +
                  (item.caption || '') +
                '</p>' +
                '<div class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold text-amber-400">' +
                  '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" /></svg>' +
                  '<span>Klik untuk memperbesar</span>' +
                '</div>' +
              '</div>' +
            '</div>'
          );
        }).join('');

        bindItemClicks();
        bindFilterButtons();
      } catch(e) {
        console.error('Gallery hydration error:', e);
      }
    }

    hydrateGalleryGrid();
    document.addEventListener('DOMContentLoaded', hydrateGalleryGrid);

    window.addEventListener('storage', function(e) {
      if (e.key === 'vo_gallery') hydrateGalleryGrid();
    });
    window.addEventListener('vo_content_updated', function(e) {
      if (!e.detail || e.detail.key === 'vo_gallery') hydrateGalleryGrid();
    });
    try {
      var bc = new BroadcastChannel('vo_sync_channel');
      bc.onmessage = function(e) {
        if (!e.data || e.data.key === 'vo_gallery') hydrateGalleryGrid();
      };
    } catch(err) {}

    // Lightbox Controls
    if (closeBtn && dialog) {
      closeBtn.onclick = function() { dialog.close(); };
      dialog.onclick = function(e) { if (e.target === dialog) dialog.close(); };
    }
    if (prevBtn) {
      prevBtn.onclick = function() { updateLightbox(currentIndex - 1); };
    }
    if (nextBtn) {
      nextBtn.onclick = function() { updateLightbox(currentIndex + 1); };
    }
    window.addEventListener('keydown', function(e) {
      if (dialog && dialog.open) {
        if (e.key === 'ArrowLeft') updateLightbox(currentIndex - 1);
        if (e.key === 'ArrowRight') updateLightbox(currentIndex + 1);
      }
    });
  })();
</script>
