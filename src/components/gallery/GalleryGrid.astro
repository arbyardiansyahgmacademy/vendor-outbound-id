---
import { GALLERY_ITEMS } from '../../data/defaultContent';

const categories = ['Semua', 'Perusahaan', 'Family Gathering', 'Sekolah', 'Wisata & Adventure'];
---

<div class="space-y-8">
  
  <!-- Category Filter Pills -->
  <div class="flex flex-wrap items-center justify-center gap-2" role="tablist" aria-label="Filter Galeri">
    {categories.map((cat, idx) => (
      <button
        type="button"
        class={`gallery-filter-btn px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-200 ${
          idx === 0
            ? 'bg-amber-500 text-stone-950 shadow-glow-amber'
            : 'bg-brand-950/70 text-rose-200 border border-rose-800/40 hover:bg-rose-900/60 hover:text-white'
        }`}
        data-filter={cat === 'Semua' ? 'all' : cat}
      >
        {cat}
      </button>
    ))}
  </div>

  <!-- Gallery Image Grid -->
  <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {GALLERY_ITEMS.map((item, index) => (
      <div
        class="gallery-item group relative rounded-xl overflow-hidden bg-[#450307] border border-rose-700/35 cursor-pointer shadow-card hover:border-amber-400/60 transition-all duration-300"
        data-category={item.category}
        data-index={index}
        data-src={item.imageUrl}
        data-title={item.title}
        data-caption={item.caption}
      >
        <div class="aspect-4/3 w-full overflow-hidden bg-brand-950">
          <img
            src={item.imageUrl}
            alt={item.altText}
            width={item.width}
            height={item.height}
            class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-500"
            loading="lazy"
          />
        </div>

        <!-- Hover Overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-stone-950/95 via-stone-950/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-5 flex flex-col justify-end text-left">
          <span class="text-[10px] uppercase font-bold text-amber-400 tracking-wider">
            {item.category}
          </span>
          <h3 class="text-base font-heading font-black text-white uppercase tracking-wider mt-1">
            {item.title}
          </h3>
          <p class="text-xs text-rose-200/80 mt-1 line-clamp-2">
            {item.caption}
          </p>
          <div class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold text-amber-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
            </svg>
            <span>Klik untuk memperbesar</span>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Native HTML5 Dialog Lightbox (accessible, handles Esc natively, top layer) -->
  <dialog
    id="gallery-lightbox"
    class="backdrop:bg-stone-950/90 bg-transparent p-4 sm:p-6 max-w-4xl w-full mx-auto my-auto text-white focus:outline-none"
    aria-label="Tampilan Foto Penuh"
  >
    <div class="relative rounded-2xl bg-[#300104] border border-rose-700/50 p-4 sm:p-6 shadow-2xl overflow-hidden flex flex-col items-center">
      
      <!-- Close button -->
      <button
        id="lightbox-close"
        type="button"
        class="absolute top-4 right-4 z-20 w-10 h-10 rounded-full bg-stone-950/80 hover:bg-amber-500 hover:text-stone-950 text-white border border-rose-500/40 flex items-center justify-center transition-all focus:outline-none focus:ring-2 focus:ring-amber-400"
        aria-label="Tutup foto"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Navigation buttons -->
      <button
        id="lightbox-prev"
        type="button"
        class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-stone-950/80 hover:bg-amber-500 hover:text-stone-950 text-white border border-rose-500/40 flex items-center justify-center transition-all focus:outline-none focus:ring-2 focus:ring-amber-400"
        aria-label="Foto sebelumnya"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button
        id="lightbox-next"
        type="button"
        class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-stone-950/80 hover:bg-amber-500 hover:text-stone-950 text-white border border-rose-500/40 flex items-center justify-center transition-all focus:outline-none focus:ring-2 focus:ring-amber-400"
        aria-label="Foto berikutnya"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Large Image View -->
      <div class="w-full max-h-[65vh] flex items-center justify-center overflow-hidden rounded-lg bg-black/40">
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="max-w-full max-h-[65vh] object-contain rounded"
        />
      </div>

      <!-- Caption & Metadata -->
      <div class="w-full mt-4 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-2 px-2">
        <div>
          <h4 id="lightbox-title" class="font-heading font-black text-lg text-white uppercase tracking-wider"></h4>
          <p id="lightbox-caption" class="text-xs text-rose-200/80 mt-0.5"></p>
        </div>
        <div id="lightbox-counter" class="text-xs font-bold text-amber-400 bg-amber-500/10 px-3 py-1 rounded-full border border-amber-400/30"></div>
      </div>

    </div>
  </dialog>

</div>

<script>
  // Filter Functionality
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.gallery-filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.gallery-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter || 'all';

      // Update button styles
      filterBtns.forEach(b => {
        b.classList.remove('bg-amber-500', 'text-stone-950', 'shadow-glow-amber');
        b.classList.add('bg-brand-950/70', 'text-rose-200');
      });
      btn.classList.add('bg-amber-500', 'text-stone-950', 'shadow-glow-amber');
      btn.classList.remove('bg-brand-950/70', 'text-rose-200');

      // Filter gallery cards
      items.forEach(card => {
        if (filter === 'all' || card.dataset.category === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });

  // Lightbox Functionality
  const dialog = document.getElementById('gallery-lightbox') as HTMLDialogElement | null;
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lbTitle = document.getElementById('lightbox-title');
  const lbCaption = document.getElementById('lightbox-caption');
  const lbCounter = document.getElementById('lightbox-counter');
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');

  let currentIndex = 0;
  const visibleItems = () => Array.from(items).filter(item => !item.classList.contains('hidden'));

  function updateLightbox(idx: number) {
    const activeList = visibleItems();
    if (activeList.length === 0) return;
    
    currentIndex = (idx + activeList.length) % activeList.length;
    const target = activeList[currentIndex];

    if (lbImg && lbTitle && lbCaption && lbCounter) {
      lbImg.src = target.dataset.src || '';
      lbImg.alt = target.dataset.title || '';
      lbTitle.textContent = target.dataset.title || '';
      lbCaption.textContent = target.dataset.caption || '';
      lbCounter.textContent = `${currentIndex + 1} / ${activeList.length}`;
    }
  }

  items.forEach(item => {
    item.addEventListener('click', () => {
      const activeList = visibleItems();
      const idx = activeList.indexOf(item);
      if (idx !== -1 && dialog) {
        updateLightbox(idx);
        dialog.showModal();
      }
    });
  });

  if (closeBtn && dialog) {
    closeBtn.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }

  if (prevBtn) {
    prevBtn.addEventListener('click', () => updateLightbox(currentIndex - 1));
  }
  if (nextBtn) {
    nextBtn.addEventListener('click', () => updateLightbox(currentIndex + 1));
  }

  // Keyboard navigation
  window.addEventListener('keydown', (e) => {
    if (dialog && dialog.open) {
      if (e.key === 'ArrowLeft') updateLightbox(currentIndex - 1);
      if (e.key === 'ArrowRight') updateLightbox(currentIndex + 1);
    }
  });
</script>
