---
import PublicLayout from '../../layouts/PublicLayout.astro';
import FAQAccordion from '../sections/FAQAccordion.astro';
import CTASection from '../sections/CTASection.astro';
import { SERVICES, PACKAGES, DESTINATIONS, SITE_INFO } from '../../data/defaultContent';
import { generateServiceSchema } from '../../lib/seo';
import { getWhatsAppUrl } from '../../lib/utils';

interface Props {
  serviceSlug: string;
}

const { serviceSlug } = Astro.props;

// Normalizing service slug
const canonicalSlug = serviceSlug === 'outbound-wisata' ? 'wisata-adventure' : serviceSlug;
const service = SERVICES.find(s => s.slug === canonicalSlug) || SERVICES[0];

// Category slug mapping for packages
const categorySlugMap: Record<string, string> = {
  'outbound-perusahaan': 'perusahaan',
  'family-gathering': 'family-gathering',
  'outbound-sekolah': 'sekolah',
  'wisata-adventure': 'wisata-adventure',
  'outbound-wisata': 'wisata-adventure'
};

const pkgCategorySlug = categorySlugMap[serviceSlug] || 'perusahaan';
const relatedPackages = PACKAGES.filter(p => p.categorySlug === pkgCategorySlug);

// Other services for sidebar navigation
const otherServices = SERVICES.filter(s => s.slug !== canonicalSlug);

// Recommended destinations mapped by service
const venueMap: Record<string, string[]> = {
  'outbound-perusahaan': ["coban-rondo", "hotel-jambuluwuk-resort", "coban-talun", "coban-rais"],
  'family-gathering': ["kusuma-agrowisata", "taman-rekreasi-selecta", "coban-rais", "tirta-nirwana-songgoriti"],
  'outbound-sekolah': ["coban-rais", "coban-talun", "bumi-perkemahan-bedengan", "taman-rekreasi-selecta"],
  'wisata-adventure': ["kaliwatu-rafting", "coban-talun", "coban-putri", "gunung-bromo"],
  'outbound-wisata': ["kaliwatu-rafting", "coban-talun", "coban-putri", "gunung-bromo"]
};

const venueSlugs = venueMap[serviceSlug] || ["coban-rondo", "coban-talun", "coban-rais", "hotel-jambuluwuk-resort"];
const recommendedDestinations = DESTINATIONS.filter(d => venueSlugs.includes(d.slug));

// Service-specific custom metadata
const serviceMetas: Record<string, {
  badge: string;
  subtitle: string;
  capacityText: string;
  formatText: string;
  targetRole: string;
  methodologyOverview: string;
  frameworkSteps: { step: string; title: string; desc: string; icon: string }[];
  faqs: { question: string; answer: string }[];
}> = {
  'outbound-perusahaan': {
    badge: 'Pilar Solusi Korporat & BUMN',
    subtitle: 'Program pengembangan kapasitas sumber daya manusia berbasis Experiential Learning Cycle untuk memperkuat sinergi tim, kepemimpinan adaptif, dan budaya kinerja unggul di alam sejuk Batu Malang.',
    capacityText: '20 hingga 1.500+ Karyawan',
    formatText: '1 Hari, 2D1N, hingga 3D2N Retret',
    targetRole: 'Perusahaan Swasta, BUMN, Instansi Pemerintah & Lembaga Negara',
    methodologyOverview: 'Pendekatan kami mengintegrasikan 4 siklus Experiential Learning (Do, Reflect, Conceptualize, Apply) yang menjamin setiap simulasi luar ruang memiliki korelasi langsung dengan tantangan nyata di lingkungan kerja kantor.',
    frameworkSteps: [
      {
        step: '01',
        title: 'Needs Assessment & Analisis Objektif',
        desc: 'Wawancara pendahuluan dengan tim HR/Manajemen untuk memetakan pain point tim, kesenjangan komunikasi, dan target perilaku yang ingin diwujudkan paska kegiatan.',
        icon: 'fas fa-search-dollar'
      },
      {
        step: '02',
        title: 'Desain Modul & Skenario Custom',
        desc: 'Penyusunan modul simulasi problem solving dan team dynamic yang diselaraskan dengan core values perusahaan dan estimasi bujet yang dialokasikan.',
        icon: 'fas fa-drafting-compass'
      },
      {
        step: '03',
        title: 'Eksekusi Lapangan Berstandar Zero Accident',
        desc: 'Fasilitasi langsung oleh Master Trainer bersertifikasi BNSP RI dengan rasio fasilitator ideal, didukung SOP medis paramedis dan peralatan berstandar internasional.',
        icon: 'fas fa-shield-alt'
      },
      {
        step: '04',
        title: 'Debriefing Filosofis & Executive Report',
        desc: 'Sesi penarikan makna (insight sharing) di akhir sesi, penyerahan laporan evaluasi dinamika kelompok paska event, serta dokumentasi foto dan video reels 4K.',
        icon: 'fas fa-clipboard-check'
      }
    ],
    faqs: [
      {
        question: 'Berapa jumlah peserta minimal dan maksimal untuk program outbound perusahaan di Batu Malang?',
        answer: 'Kami melayani rombongan mulai dari skala divisi kecil minimal 20 orang hingga korporasi besar berskala 1.500+ orang. Untuk peserta skala ratusan hingga ribuan, kegiatan diorganisir dengan sistem multi-cluster dan koordinasi sub-master trainer berpengalaman.'
      },
      {
        question: 'Apakah tema dan games simulasi outbound bisa disesuaikan dengan nilai budaya perusahaan kami?',
        answer: 'Sangat bisa. Kami menerapkan pendekatan customized program di mana jenis permainan, skenario simulasi, dan materi debriefing diselaraskan secara akurat dengan Core Values (seperti AKHLAK BUMN, Service Excellence, Leadership Agility, dll).'
      },
      {
        question: 'Apakah Provider Outbound bisa memfasilitasi kebutuhan akomodasi resort bintang 5, meeting room, dan gala dinner?',
        answer: 'Ya, kami menyediakan paket all-in terpadu mulai dari ground outbound, sewa ballroom hotel/resort bintang 5 di Batu Malang, konsumsi buffet, sound system, panggung megah, hingga hiburan live music untuk malam keakraban/gala dinner.'
      },
      {
        question: 'Bagaimana prosedur administrasi, proposal penawaran, invoice, dan faktur pajak untuk instansi pemerintah atau korporasi?',
        answer: 'Kami beroperasi dengan legalitas badan usaha resmi dan tertib administrasi. Kami siap menerbitkan proposal resmi, SPK, invoice bermaterai, kuitansi bermaterai, dan faktur pajak sesuai regulasi pengadaan barang/jasa perusahaan Anda.'
      }
    ]
  },
  'family-gathering': {
    badge: 'Pilar Rekreasi Keluarga & Komunitas',
    subtitle: 'Program kebersamaan hangat dan menyenangkan yang mempererat tali silaturahmi antar keluarga besar karyawan, komunitas, maupun ikatan alumni di lanskap pegunungan asri Kota Wisata Batu.',
    capacityText: '30 hingga 2.000+ Peserta',
    formatText: 'Half Day, 1 Hari Penuh, hingga 2D1N Menginap',
    targetRole: 'Keluarga Besar Karyawan, Paguyuban, Komunitas Warga & Ikatan Alumni',
    methodologyOverview: 'Dirancang dengan konsep inclusive fun games yang merangkul seluruh spektrum usia—mulai dari balita, anak-anak, remaja, dewasa hingga kakek-nenek—tanpa beban fisik berlebih dan mengutamakan sukacita kebersamaan.',
    frameworkSteps: [
      {
        step: '01',
        title: 'Pemetaan Komposisi Usia Rombongan',
        desc: 'Mendata profil rombongan (jumlah anak-anak, lansia, dan pasangan) untuk memastikan seluruh rancangan aktivitas ramah dan aman bagi seluruh anggota keluarga.',
        icon: 'fas fa-users'
      },
      {
        step: '02',
        title: 'Pemilihan Venue Ramah Keluarga',
        desc: 'Memilih venue di Kota Batu dengan akses mudah tanpa tangga terjal, fasilitas toilet bersih melimpah, dan area rumput hijau teduh yang nyaman untuk bersantai.',
        icon: 'fas fa-tree'
      },
      {
        step: '03',
        title: 'Penyelenggaraan Fun Games Multi-Generasi',
        desc: 'Aktivitas interaktif seru seperti Kids Corner edukatif, Family Relay Games, dan ice breaking ceria yang dipandu fasilitator ramah keluarga.',
        icon: 'fas fa-smile-beam'
      },
      {
        step: '04',
        title: 'Panggung Doorprize & Dokumentasi Keluarga',
        desc: 'Pengundian doorprize meriah, makan bersama dengan menu nusantara lezat, serta sesi foto bersama per keluarga dan rombongan besar.',
        icon: 'fas fa-gift'
      }
    ],
    faqs: [
      {
        question: 'Apakah aktivitas family gathering aman untuk balita dan orang tua lansia?',
        answer: 'Sangat aman. Program Family Gathering didesain khusus non-fisik berat. Kami menyediakan Kids Zone dengan permainan edukatif untuk anak-anak serta seating area teduh yang nyaman bagi orang tua lansia.'
      },
      {
        question: 'Apakah bus pariwisata ukuran besar (SHD/HDD) bisa parkir langsung di lokasi kegiatan?',
        answer: 'Ya, seluruh venue rekomendasi family gathering kami (seperti Selecta, Coban Rais, Kusuma Agrowisata) memiliki area parkir bus sangat luas dan akses jalan mulus tanpa perlu oper kendaraan kecil.'
      },
      {
        question: 'Bisakah kami menambahkan agenda panggung hiburan, organ tunggal, dan pembagian doorprize?',
        answer: 'Tentu bisa. Kami menyediakan paket lengkap panggung pementasan, MC profesional berbahasa santai komunikatif, sound system berdaya tinggi, serta teknisi multimedia untuk mendukung jalannya acara hiburan Anda.'
      },
      {
        question: 'Bagaimana jika saat kegiatan berlangsung terjadi hujan di Kota Batu?',
        answer: 'Seluruh venue resmi pilihan kami memiliki fasilitas aula pertemuan (indoor shelter / pendopo) berkapasitas besar. Jika cuaca hujan, rundown dialihkan secara mulus ke skenario indoor fun games tanpa mengurangi keceriaan.'
      }
    ]
  },
  'outbound-sekolah': {
    badge: 'Pilar Edukasi Karakter & Generasi Muda',
    subtitle: 'Program pendidikan luar ruang terpadu untuk membentuk kemandirian, kepemimpinan siswa (LDKS), kedisiplinan, dan kesadaran lingkungan bagi pelajar SD, SMP, SMA, hingga mahasiswa.',
    capacityText: '30 hingga 1.200+ Siswa',
    formatText: '1 Hari (Edukasi Karakter) atau 2D1N (Camping / LDKS)',
    targetRole: 'Siswa SD, Pelajar SMP/SMA/SMK, Pengurus OSIS/MPK & Mahasiswa',
    methodologyOverview: 'Menggabungkan metode Outdoor Experiential Education dengan penanaman nilai budi pekerti luhur, mengasah daya juang (adversity quotient), serta melatih kepekaan sosial kawan sebaya di alam terbuka.',
    frameworkSteps: [
      {
        step: '01',
        title: 'Sinkronisasi Kurikulum & Nilai Sekolah',
        desc: 'Koordinasi bersama dewan guru dan kesiswaan untuk menyelaraskan modul outbound dengan tema Projek Penguatan Profil Pelajar Pancasila (P5) atau silabus LDKS.',
        icon: 'fas fa-graduation-cap'
      },
      {
        step: '02',
        title: 'Manajemen Lokasi Bumi Perkemahan Terproteksi',
        desc: 'Pemilihan camping ground aman dengan batas perimeter jelas, penerangan memadai, sumber air higienis, serta jauh dari tebing curam berbahaya.',
        icon: 'fas fa-campground'
      },
      {
        step: '03',
        title: 'Simulasi Kepemimpinan & Ketangkasan',
        desc: 'Rangkaian simulasi survival dasar, character building games, navigasi kelompok, dan uji kekompakan regu di bawah pengawasan instruktur bersertifikat.',
        icon: 'fas fa-compass'
      },
      {
        step: '04',
        title: 'Refleksi Moral & Ikrar Siswa',
        desc: 'Sesi perenungan malam atau penutupan untuk menumbuhkan rasa syukur, hormat kepada guru dan orang tua, serta komitmen menjadi pribadi berintegritas.',
        icon: 'fas fa-heart'
      }
    ],
    faqs: [
      {
        question: 'Apakah instruktur outbound sekolah bersertifikasi dan berpengalaman menangani pelajar?',
        answer: 'Ya, seluruh trainer kami tersertifikasi BNSP RI di bidang kepanduan dan outbound training. Tim kami terlatih dalam psikologi perkembangan anak dan remaja, menciptakan suasana disiplin namun tetap bersahabat.'
      },
      {
        question: 'Bagaimana rasio fasilitator pendamping terhadap jumlah murid?',
        answer: 'Kami menerapkan rasio ketat yakni 1 fasilitator mendampingi 10 hingga 12 siswa. Hal ini memastikan setiap siswa termonitor keselamatannya secara penuh selama rangkaian kegiatan berlangsung.'
      },
      {
        question: 'Apakah tersedia fasilitas camping dengan tenda, matras, dan katering yang higienis?',
        answer: 'Ya, kami menyediakan tenda dome berkualitas waterproof lengkap dengan matras tebal, sleeping bag, penerangan ground, serta sajian makanan sehat bergizi yang disukai para pelajar.'
      },
      {
        question: 'Apakah guru pendamping dan kepala sekolah dikenakan biaya yang sama dengan siswa?',
        answer: 'Kami memberikan penawaran khusus dan fasilitas komplementer (FOC) bagi sejumlah guru pendamping sekolah sesuai dengan kuota rombongan siswa yang didaftarkan.'
      }
    ]
  },
  'wisata-adventure': {
    badge: 'Pilar Petualangan & Adrenalin Alam',
    subtitle: 'Sinergi paket outbound kreatif dengan eksplorasi wisata petualangan spektakuler: arung jeram Kaliwatu, safari jeep offroad 4x4, camping ground, dan eksplorasi alam Kota Batu & Malang Raya.',
    capacityText: '15 hingga 800+ Petualang',
    formatText: 'Full Day Adventure hingga 3D2N Overland Bromo',
    targetRole: 'Komunitas Pecinta Alam, Perusahaan Progresif, Rombongan Wisatawan & Agen Wisata',
    methodologyOverview: 'Mengintegrasikan sensasi pemacu adrenalin yang aman (safe adventure) dengan dinamika tim, melatih keberanian mengambil risiko terukur, dan menghadirkan kepuasan rekreasi yang tak terlupakan.',
    frameworkSteps: [
      {
        step: '01',
        title: 'Screening Kondisi Fisik & Safety Briefing',
        desc: 'Pemeriksaan awal kesiapan peserta dan penjelasan komprehensif mengenai prosedur keselamatan di air (water rescue) maupun di medan offroad berlumpur.',
        icon: 'fas fa-heartbeat'
      },
      {
        step: '02',
        title: 'Fitting Perlengkapan Bersertifikat CE/UIAA',
        desc: 'Setiap peserta dilengkapi helm pelindung berstandar internasional, life jacket berdaya apung tinggi, dan didampingi skipper atau driver berpengalaman.',
        icon: 'fas fa-vest'
      },
      {
        step: '03',
        title: 'Ekspedisi Petualangan Arung Jeram & Safari Jeep',
        desc: 'Mengarungi jeram Kaliwatu atau melibas jalur ekstrem lereng Gunung Arjuno-Panderman dengan armada jeep 4x4 Land Rover terawat prima.',
        icon: 'fas fa-water'
      },
      {
        step: '04',
        title: 'Pembersihan Diri, Sajian Kuliner & Dokumentasi Aksi',
        desc: 'Bilas air hangat, menikmati sajian kuliner khas tradisional Batu (jagung bakar, kopi panas), serta penyerahan foto/video aksi saat menerjang rintangan.',
        icon: 'fas fa-camera'
      }
    ],
    faqs: [
      {
        question: 'Apakah aman bagi peserta yang tidak bisa berenang untuk ikut arung jeram Rafting Kaliwatu?',
        answer: 'Sangat aman. Setiap peserta wajib mengenakan Life Jacket berkekuatan apung tinggi serta helm pengaman. Setiap perahu rafting dikemudikan oleh Guide/Skipper profesional bersertifikasi rescue air yang siap siaga.'
      },
      {
        question: 'Berapa batas usia yang diperbolehkan untuk mengikuti kegiatan rafting dan offroad jeep 4x4?',
        answer: 'Untuk rafting Kaliwatu, usia minimal adalah 7 tahun dan maksimal 65 tahun dalam kondisi sehat jasmani. Untuk offroad jeep, dapat diikuti mulai usia 5 tahun hingga lansia berjiwa muda.'
      },
      {
        question: 'Apakah perlengkapan keselamatan offroad jeep memenuhi standar?',
        answer: 'Ya, seluruh armada 4x4 kami dilengkapi roll bar pelindung kokoh, sabuk pengaman di setiap kursi, sopir berpengalaman medan terjal, serta asuransi resmi perlindungan penumpang.'
      },
      {
        question: 'Apakah asuransi keselamatan sudah termasuk dalam paket outbound wisata adventure?',
        answer: 'Seluruh paket petualangan Provider Outbound sudah mencakup perlindungan asuransi kecelakaan diri dari awal aktivitas penjemputan hingga rangkaian petualangan selesai.'
      }
    ]
  }
};

const meta = serviceMetas[canonicalSlug] || serviceMetas['outbound-perusahaan'];
const serviceSchema = generateServiceSchema(service);

const breadcrumbs = [
  { name: 'Layanan', url: '/layanan' },
  { name: service.title }
];

const waConsultUrl = getWhatsAppUrl(
  `Halo Provider Outbound, saya ingin konsultasi kebutuhan layanan "${service.title}" di Batu Malang untuk rombongan kami. Mohon info ketersediaan tanggal dan proposal penawarannya.`
);
---

<PublicLayout
  title={`${service.title} Batu Malang | Solusi Resmi Provider Outbound`}
  description={`${service.excerpt} Dapatkan proposal resmi, fasilitator BNSP, jaminan zero accident, dan rekomendasi venue terbaik di Kota Batu Malang.`}
  breadcrumbs={breadcrumbs}
>
  <!-- Schema.org Service Metadata -->
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <!-- ========================================================================= -->
  <!-- 1. HERO SECTION: Strategic Master Service Header (Clean & Tanpa Tombol WA) -->
  <!-- ========================================================================= -->
  <section class="py-14 sm:py-20 relative overflow-hidden border-b border-rose-900/50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      
      <!-- Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/15 border border-amber-400/35 text-amber-300 text-xs font-bold uppercase tracking-wider">
        <i class="fas fa-layer-group text-[11px]"></i>
        <span>{meta.badge}</span>
      </div>

      <!-- Main Title -->
      <h1 class="font-heading font-black text-3xl sm:text-5xl lg:text-6xl uppercase tracking-[0.12em] text-white leading-tight">
        {service.title} <span class="text-amber-400">BATU MALANG</span>
      </h1>

      <!-- Executive Subtitle -->
      <p class="text-base sm:text-lg text-rose-100/85 max-w-3xl mx-auto leading-relaxed font-sans">
        {meta.subtitle}
      </p>

      <!-- 4 Strategic Specs Badges (Sleek, Clean, Tanpa Tombol Konsultasi) -->
      <div class="pt-2 flex flex-wrap items-center justify-center gap-2.5 sm:gap-3 text-xs text-rose-200">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-stone-900/80 border border-rose-800/40">
          <i class="fas fa-users text-amber-400 text-[11px]"></i>
          <span>Kapasitas: <strong class="text-white">{meta.capacityText}</strong></span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-stone-900/80 border border-rose-800/40">
          <i class="fas fa-certificate text-amber-400 text-[11px]"></i>
          <span>Instruktur: <strong class="text-white">BNSP RI</strong></span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-stone-900/80 border border-rose-800/40">
          <i class="fas fa-shield-alt text-amber-400 text-[11px]"></i>
          <span>SOP: <strong class="text-white">Zero Accident</strong></span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-stone-900/80 border border-rose-800/40">
          <i class="fas fa-map-marker-alt text-amber-400 text-[11px]"></i>
          <span>Area: <strong class="text-white">Batu &amp; Malang</strong></span>
        </span>
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. MAIN CONTENT + SIDEBAR LAYOUT                                          -->
  <!-- ========================================================================= -->
  <section class="py-12 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
      
      <!-- ===================================================================== -->
      <!-- LEFT COLUMN: Master Service Architecture (8 COLS)                     -->
      <!-- ===================================================================== -->
      <div class="lg:col-span-8 space-y-12 text-left">
        
        <!-- Large Visual Banner Showcase (Single Heroic Frame, Distinct from 3-Mosaic) -->
        <div class="relative rounded-2xl overflow-hidden aspect-16/9 bg-stone-950 border border-rose-700/40 shadow-2xl group">
          <img
            src={service.imageUrl}
            alt={`${service.title} di Batu Malang`}
            width="900"
            height="500"
            class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-700"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/90 via-stone-950/20 to-transparent"></div>
          
          <div class="absolute bottom-4 left-4 right-4 sm:bottom-6 sm:left-6 sm:right-6 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
            <div>
              <span class="px-2.5 py-1 rounded bg-amber-500 text-stone-950 font-heading font-black text-[10px] uppercase tracking-wider">
                Dokumentasi Kegiatan Resmi
              </span>
              <p class="text-white font-heading font-bold text-base sm:text-xl mt-1.5">
                Pengalaman Nyata Berstandar Profesional di Kota Batu
              </p>
            </div>
            <span class="inline-flex items-center gap-1.5 text-xs text-rose-200/90 font-medium sm:text-right">
              <i class="fas fa-map-marker-alt text-amber-400 text-xs shrink-0"></i>
              <span>{service.locationNote}</span>
            </span>
          </div>
        </div>

        <!-- Section A: Metodologi 4-Tahap Penyelenggaraan (Service Lifecycle) -->
        <div class="rounded-2xl bg-[#480308]/60 border border-rose-700/35 p-6 sm:p-8 space-y-6 shadow-card">
          <div class="space-y-2 border-b border-rose-800/40 pb-4">
            <span class="text-xs font-bold uppercase tracking-widest text-amber-400">
              Metodologi Penyelenggaraan Teruji
            </span>
            <h2 class="font-heading font-black text-2xl sm:text-3xl uppercase tracking-wider text-white">
              ALUR 4 TAHAP PENYELENGGARAAN LAYANAN
            </h2>
            <p class="text-sm text-rose-100/80 leading-relaxed">
              {meta.methodologyOverview}
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {meta.frameworkSteps.map((step) => (
              <div class="p-4 sm:p-5 rounded-xl bg-stone-950/50 border border-rose-800/35 space-y-2.5 hover:border-amber-400/50 transition-colors">
                <div class="flex items-center justify-between">
                  <span class="w-8 h-8 rounded-lg bg-amber-500/20 border border-amber-400/30 text-amber-400 font-heading font-black text-xs flex items-center justify-center">
                    {step.step}
                  </span>
                  <i class={`${step.icon} text-rose-400/70 text-sm`}></i>
                </div>
                <h3 class="font-heading font-bold text-base text-white uppercase">
                  {step.title}
                </h3>
                <p class="text-xs text-rose-100/75 leading-relaxed">
                  {step.desc}
                </p>
              </div>
            ))}
          </div>
        </div>

        <!-- Section B: Gambaran Solusi & Nilai Tambah Terukur -->
        <div class="rounded-2xl bg-[#480308]/60 border border-rose-700/35 p-6 sm:p-8 space-y-6 shadow-card">
          <div class="space-y-2 border-b border-rose-800/40 pb-4">
            <span class="text-xs font-bold uppercase tracking-widest text-amber-400">
              Solusi &amp; Objektif Program
