---
import { SITE_INFO } from '../../data/defaultContent';
import { getWhatsAppUrl } from '../../lib/utils';

const currentYear = new Date().getFullYear();
const waUrl = getWhatsAppUrl('Halo Vendor Outbound, saya ingin konsultasi kebutuhan kegiatan.');

const networkWebsites = [
  'provideroutbound.web.id',
  'outboundbatumalang.web.id',
  'outboundmalang.web.id',
  'paketoutboundmalang.web.id',
  'vendoroutboundmalang.web.id',
  'offroad.web.id',
  'paintball.web.id',
  'rafting.web.id',
  'outboundpantai.web.id',
  'paintballbatumalang.web.id',
  'cobanrondo.web.id',
  'malangtraveler.web.id',
  'outboundkediri.web.id',
  'pantaimalangselatan.web.id',
  'jasaoutboundmalang.web.id',
  'outboundindonesia.web.id',
  'gemilangkatunoutbound.web.id',
  'outboundjatim.web.id'
];
---

<footer class="w-full bg-[#180103] border-t border-rose-900/60 pt-16 pb-10 text-rose-100/80 relative overflow-hidden">
  <!-- Subtle ambient decorative glow -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-brand-600/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Main 4-Column Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10 pb-12 border-b border-rose-900/40">
      
      <!-- Col 1: Brand Info & Social Media (lg:col-span-4) -->
      <div class="lg:col-span-4 space-y-5">
        <a href="/" class="inline-flex items-center gap-3 group">
          <img
            src="/images/logo/logo-fix.webp"
            alt="Logo Vendor Outbound"
            class="w-11 h-11 rounded-full object-cover border-2 border-amber-400 shadow-md group-hover:scale-105 transition-transform"
            width="44"
            height="44"
          />
          <div class="leading-tight">
            <span class="font-heading font-black text-xl text-white tracking-wider uppercase block">
              {SITE_INFO.brandName}
            </span>
            <span class="text-[11px] text-amber-400 font-semibold tracking-widest uppercase">
              Batu &amp; Malang Raya
            </span>
          </div>
        </a>

        <p class="text-xs sm:text-sm leading-relaxed text-rose-200/75">
          {SITE_INFO.description} Fasilitator tersertifikasi BNSP berpengalaman mengawal ratusan instansi korporat, BUMN, lembaga pendidikan, dan paguyuban keluarga di Jawa Timur.
        </p>

        <!-- Social Media Buttons (Unified Harmonious Palette) -->
        <div class="pt-2">
          <div class="text-[11px] font-bold uppercase tracking-wider text-amber-400/90 mb-3 flex items-center gap-2">
            <i class="fas fa-share-nodes text-xs text-amber-400"></i> Ikuti Media Sosial Kami:
          </div>
          <div class="flex items-center flex-wrap gap-2.5">
            <a
              href="https://instagram.com"
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-white/10 hover:bg-amber-500 hover:text-stone-950 text-white/85 border border-white/15 hover:border-amber-400 flex items-center justify-center transition-all duration-300 shadow-md group"
              aria-label="Instagram Vendor Outbound"
              title="Instagram"
            >
              <i class="fab fa-instagram text-base group-hover:scale-110 transition-transform"></i>
            </a>
            <a
              href="https://tiktok.com"
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-white/10 hover:bg-amber-500 hover:text-stone-950 text-white/85 border border-white/15 hover:border-amber-400 flex items-center justify-center transition-all duration-300 shadow-md group"
              aria-label="TikTok Vendor Outbound"
              title="TikTok"
            >
              <i class="fab fa-tiktok text-base group-hover:scale-110 transition-transform"></i>
            </a>
            <a
              href="https://facebook.com"
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-white/10 hover:bg-amber-500 hover:text-stone-950 text-white/85 border border-white/15 hover:border-amber-400 flex items-center justify-center transition-all duration-300 shadow-md group"
              aria-label="Facebook Vendor Outbound"
              title="Facebook"
            >
              <i class="fab fa-facebook-f text-base group-hover:scale-110 transition-transform"></i>
            </a>
            <a
              href="https://x.com"
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-white/10 hover:bg-amber-500 hover:text-stone-950 text-white/85 border border-white/15 hover:border-amber-400 flex items-center justify-center transition-all duration-300 shadow-md group"
              aria-label="X Twitter Vendor Outbound"
              title="X (Twitter)"
            >
              <i class="fab fa-x-twitter text-base group-hover:scale-110 transition-transform"></i>
            </a>
            <a
              href="https://youtube.com"
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-white/10 hover:bg-amber-500 hover:text-stone-950 text-white/85 border border-white/15 hover:border-amber-400 flex items-center justify-center transition-all duration-300 shadow-md group"
              aria-label="YouTube Vendor Outbound"
              title="YouTube"
            >
              <i class="fab fa-youtube text-base group-hover:scale-110 transition-transform"></i>
            </a>
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-white/10 hover:bg-amber-500 hover:text-stone-950 text-white/85 border border-white/15 hover:border-amber-400 flex items-center justify-center transition-all duration-300 shadow-md group"
              aria-label="WhatsApp Vendor Outbound"
              title="WhatsApp"
            >
              <i class="fab fa-whatsapp text-base group-hover:scale-110 transition-transform"></i>
            </a>
          </div>
        </div>


      </div>

      <!-- Col 2: Navigasi Cepat (lg:col-span-2) -->
      <div class="lg:col-span-2 space-y-4">
        <h4 class="font-heading font-black text-white uppercase tracking-wider text-xs sm:text-sm flex items-center gap-2 border-b border-rose-900/50 pb-2">
          <i class="fas fa-compass text-amber-400"></i> Navigasi
        </h4>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li>
            <a href="/" class="hover:text-amber-400 transition-colors flex items-center gap-2">
              <i class="fas fa-chevron-right text-[10px] text-amber-400/70"></i> Beranda
            </a>
          </li>
          <li>
            <a href="/tentang-kami" class="hover:text-amber-400 transition-colors flex items-center gap-2">
              <i class="fas fa-chevron-right text-[10px] text-amber-400/70"></i> Tentang Kami
            </a>
          </li>
          <li>
            <a href="/layanan" class="hover:text-amber-400 transition-colors flex items-center gap-2">
              <i class="fas fa-chevron-right text-[10px] text-amber-400/70"></i> Program Layanan
            </a>
          </li>
          <li>
            <a href="/paket" class="hover:text-amber-400 transition-colors flex items-center gap-2">
              <i class="fas fa-chevron-right text-[10px] text-amber-400/70"></i> Pilihan Paket
            </a>
          </li>
          <li>
            <a href="/galeri" class="hover:text-amber-400 transition-colors flex items-center gap-2">
              <i class="fas fa-chevron-right text-[10px] text-amber-400/70"></i> Galeri Dokumentasi
            </a>
          </li>
          <li>
            <a href="/blog" class="hover:text-amber-400 transition-colors flex items-center gap-2">
              <i class="fas fa-chevron-right text-[10px] text-amber-400/70"></i> Blog &amp; Panduan
            </a>
          </li>
          <li>
            <a href="/kontak" class="hover:text-amber-400 transition-colors flex items-center gap-2">
              <i class="fas fa-chevron-right text-[10px] text-amber-400/70"></i> Kontak Resmi
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Layanan Unggulan (lg:col-span-3) -->
      <div class="lg:col-span-3 space-y-4">
        <h4 class="font-heading font-black text-white uppercase tracking-wider text-xs sm:text-sm flex items-center gap-2 border-b border-rose-900/50 pb-2">
          <i class="fas fa-layer-group text-amber-400"></i> Layanan Utama
        </h4>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li>
            <a href="/layanan/outbound-perusahaan" class="hover:text-amber-400 transition-colors flex items-center gap-2">
              <i class="fas fa-chevron-right text-[10px] text-amber-400/70"></i> Outbound Perusahaan &amp; Team Building
            </a>
          </li>
          <li>
            <a href="/layanan/family-gathering" class="hover:text-amber-400 transition-colors flex items-center gap-2">
              <i class="fas fa-chevron-right text-[10px] text-amber-400/70"></i> Family Gathering Perusahaan
            </a>
          </li>
          <li>
            <a href="/layanan/outbound-sekolah" class="hover:text-amber-400 transition-colors flex items-center gap-2">
              <i class="fas fa-chevron-right text-[10px] text-amber-400/70"></i> Outbound Sekolah &amp; LDKS Siswa
            </a>
          </li>
          <li>
            <a href="/layanan/wisata-adventure" class="hover:text-amber-400 transition-colors flex items-center gap-2">
              <i class="fas fa-chevron-right text-[10px] text-amber-400/70"></i> Wisata Adventure, Rafting &amp; Jeep
            </a>
          </li>
          <li>
            <a href="/paket/perusahaan" class="hover:text-amber-400 transition-colors flex items-center gap-2">
              <i class="fas fa-chevron-right text-[10px] text-amber-400/70"></i> Paket Corporate All-In
            </a>
          </li>
          <li>
            <a href="/paket/wisata-adventure" class="hover:text-amber-400 transition-colors flex items-center gap-2">
              <i class="fas fa-chevron-right text-[10px] text-amber-400/70"></i> Rafting Arung Jeram &amp; Offroad
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Kontak & Operasional (lg:col-span-3) -->
      <div class="lg:col-span-3 space-y-4">
        <h4 class="font-heading font-black text-white uppercase tracking-wider text-xs sm:text-sm flex items-center gap-2 border-b border-rose-900/50 pb-2">
          <i class="fas fa-headset text-amber-400"></i> Kontak Kami
        </h4>
        
        <div class="space-y-3.5 text-xs sm:text-sm">
          <!-- WhatsApp Item -->
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-amber-500/15 border border-amber-400/30 text-amber-400 flex items-center justify-center flex-shrink-0 mt-0.5">
              <i class="fab fa-whatsapp text-sm"></i>
            </div>
            <div>
              <div class="text-[11px] uppercase tracking-wide text-rose-300 font-bold">WhatsApp (Fast Response)</div>
              <a href={waUrl} target="_blank" rel="noopener noreferrer" class="text-white hover:text-amber-400 font-bold">
                {SITE_INFO.whatsappDisplay}
              </a>
            </div>
          </div>

          <!-- Location Item -->
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-amber-500/15 border border-amber-400/30 text-amber-400 flex items-center justify-center flex-shrink-0 mt-0.5">
              <i class="fas fa-map-marker-alt text-sm"></i>
            </div>
            <div>
              <div class="text-[11px] uppercase tracking-wide text-rose-300 font-bold">Area Layanan</div>
              <p class="text-rose-100/80 leading-relaxed text-xs">
                Kota Wisata Batu, Malang Raya, Pujon, Kasembon, Bromo &amp; Sekitarnya, Jawa Timur
              </p>
            </div>
          </div>

          <!-- Hours Item -->
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-amber-500/15 border border-amber-400/30 text-amber-400 flex items-center justify-center flex-shrink-0 mt-0.5">
              <i class="fas fa-clock text-sm"></i>
            </div>
            <div>
              <div class="text-[11px] uppercase tracking-wide text-rose-300 font-bold">Jam Layanan</div>
              <p class="text-rose-100/80 text-xs">
                Senin – Minggu: 08.00 – 21.00 WIB
              </p>
            </div>
          </div>

          <!-- Email Item -->
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-amber-500/15 border border-amber-400/30 text-amber-400 flex items-center justify-center flex-shrink-0 mt-0.5">
              <i class="fas fa-envelope text-sm"></i>
            </div>
            <div>
              <div class="text-[11px] uppercase tracking-wide text-rose-300 font-bold">Email Informasi</div>
              <a href="mailto:info@vendoroutbound.id" class="text-white hover:text-amber-400 text-xs">
                info@vendoroutbound.id
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Legal & Copyright Bar -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-rose-300/60">
      <p>
        &copy; {currentYear} {SITE_INFO.brandName}. Hak Cipta Dilindungi. — <a href="/" class="text-amber-400 hover:underline">vendoroutbound.id</a>
      </p>
      <div class="flex items-center gap-6">
        <a href="/kebijakan-privasi" class="hover:text-amber-400 transition-colors">
          Kebijakan Privasi
        </a>
        <a href="/syarat-ketentuan" class="hover:text-amber-400 transition-colors">
          Syarat &amp; Ketentuan
        </a>
        <a href="/kontak" class="hover:text-amber-400 transition-colors">
          Hubungi Kami
        </a>
        <a href="/admin/login" class="hover:text-rose-100 transition-colors opacity-40 hover:opacity-100 text-[11px]">
          Admin Portal
        </a>
      </div>
    </div>

  </div>
</footer>
