---
import { SITE_INFO } from '../../data/defaultContent';
import { getWhatsAppUrl } from '../../lib/utils';

interface Props {
  pageTitle?: string;
}

const { pageTitle = 'Layanan' } = Astro.props;

const customMsg = `Halo Vendor Outbound, saya tertarik berkonsultasi seputar ${pageTitle} di area Batu - Malang.`;
const waUrl = getWhatsAppUrl(customMsg);
---

<div class="fixed bottom-6 right-6 z-40 flex flex-col items-center gap-3">
  
  <!-- Back to Top Button -->
  <button
    id="back-to-top"
    type="button"
    class="w-12 h-12 rounded-full bg-[#4a0308]/90 hover:bg-brand-600 text-rose-100 border border-rose-700/50 shadow-xl flex items-center justify-center opacity-0 pointer-events-none translate-y-3 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-amber-400 group"
    aria-label="Kembali ke atas halaman"
  >
    <svg class="w-5 h-5 transition-transform group-hover:-translate-y-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7" />
    </svg>
  </button>

  <!-- Floating WhatsApp Button -->
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="relative w-14 h-14 rounded-full bg-emerald-500 hover:bg-emerald-400 text-white shadow-2xl flex items-center justify-center transition-all duration-300 hover:scale-110 focus:outline-none focus:ring-4 focus:ring-emerald-300/40 group"
    aria-label={`Hubungi WhatsApp Resmi ${SITE_INFO.whatsappDisplay}`}
  >
    <!-- Ripple ring animation -->
    <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75 animate-ping group-hover:hidden"></span>
    
    <svg class="w-8 h-8 fill-current relative z-10" viewBox="0 0 24 24">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
    </svg>

    <!-- Tooltip label on desktop hover -->
    <span class="absolute right-16 px-3 py-1.5 rounded-lg bg-stone-900 text-white text-xs font-semibold whitespace-nowrap shadow-xl opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-opacity duration-200 hidden sm:block">
      Chat WhatsApp (+62 822-1122-1909)
    </span>
  </a>

</div>

<script>
  const backToTopBtn = document.getElementById('back-to-top');

  if (backToTopBtn) {
    const handleScroll = () => {
      if (window.scrollY > 350) {
        backToTopBtn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
        backToTopBtn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      } else {
        backToTopBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
        backToTopBtn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });

    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    });
  }
</script>
