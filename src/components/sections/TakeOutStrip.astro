---
import { SITE_INFO } from '../../data/defaultContent';
import { getWhatsAppUrl } from '../../lib/utils';

const waUrl = getWhatsAppUrl('Halo Vendor Outbound, saya ingin konsultasi langsung agenda outbound di Batu Malang.');
---

<section class="py-10 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <!-- White Card Banner Strip (Replicating TAKE - OUT SERVICE bottom banner from reference) -->
    <div class="bg-white text-stone-950 rounded-md p-6 sm:p-7 shadow-2xl flex flex-col sm:flex-row items-center justify-between gap-6 border-b-4 border-amber-500">
      
      <div class="text-center sm:text-left space-y-1">
        <h3 class="font-heading font-black text-xl sm:text-2xl uppercase tracking-[0.16em] text-brand-950">
          KONSULTASI OUTBOUND
        </h3>
        <div class="flex items-center justify-center sm:justify-start gap-3 text-xs font-bold text-stone-700 tracking-wider uppercase">
          <span class="text-amber-600">TERSEDIA SETIAP HARI</span>
          <span class="w-1.5 h-1.5 rounded-full bg-stone-400"></span>
          <span>{SITE_INFO.operatingHours}</span>
        </div>
      </div>

      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-6 py-3 rounded-md bg-amber-500 hover:bg-amber-400 text-stone-950 font-heading font-black text-xs uppercase tracking-wider shadow-md hover:scale-105 transition-all flex-shrink-0"
      >
        <span>Hubungi Kami</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

    </div>

  </div>
</section>
