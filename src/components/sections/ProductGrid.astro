---
import { PACKAGES } from '../../data/defaultContent';
import { getWhatsAppUrl } from '../../lib/utils';

// Pick 4 featured packages matching reference image layout (4 vertical cards)
const featuredPackages = PACKAGES.filter(p => p.featured).slice(0, 4);
---

<section class="py-16 sm:py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Title (Uppercase with wide tracking matching reference) -->
    <div class="text-center mb-12 sm:mb-16">
      <h2 id="pkg-grid-heading" class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl uppercase tracking-[0.18em] text-white">
        PAKET PILIHAN
      </h2>
      <p id="pkg-grid-subheading" class="text-xs sm:text-sm uppercase tracking-widest text-amber-400 mt-2 font-semibold">
        Pilihan Paket Outbound &amp; Petualangan Paling Diminati di Batu Malang
      </p>
    </div>

    <!-- 4 Cards Grid (Enlarged Cards and Photos) -->
    <div id="homepage-pkg-cards-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      {featuredPackages.map((pkg) => {
        const pkgWaUrl = getWhatsAppUrl(`Halo Provider Outbound, saya ingin konsultasi paket ${pkg.title} (${pkg.categoryName}).`);

        return (
          <div class="rounded-2xl bg-[#52050B]/75 border border-rose-700/40 hover:border-amber-400/70 p-6 sm:p-7 flex flex-col items-center text-center shadow-card transition-all duration-300 hover:-translate-y-2 group h-full justify-between">
            
            <div class="flex flex-col items-center w-full">
              <!-- Enlarged Circular Image Top -->
              <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-full p-1.5 bg-gradient-to-tr from-brand-700 to-amber-500/50 border-2 border-rose-400/40 mb-5 shadow-xl group-hover:scale-105 transition-transform shrink-0">
                <img
                  src={pkg.imageUrl}
                  alt={pkg.title}
                  width="200"
                  height="200"
                  class="w-full h-full object-cover rounded-full"
                  loading="lazy"
                />
              </div>

              <!-- Title (Uppercase) -->
              <h3 class="font-heading font-black text-base sm:text-lg uppercase tracking-wider text-white group-hover:text-amber-400 transition-colors">
                {pkg.title}
              </h3>

              <!-- Category tag -->
              <span class="text-xs uppercase tracking-wider text-rose-300/85 mt-1 font-semibold">
                {pkg.categoryName}
              </span>

              <!-- Rating Stars (Reference yellow star row) -->
              <div class="flex items-center gap-1.5 text-amber-400 text-sm sm:text-base my-3" aria-label="Rating 5 bintang">
                <span>★</span>
                <span>★</span>
                <span>★</span>
                <span>★</span>
                <span>★</span>
              </div>
            </div>

            <!-- Action Buttons: Konsultasi Paket Ini (atas) & Detail Paket (bawah) -->
            <div class="w-full pt-4 mt-4 border-t border-rose-800/40 flex flex-col gap-2.5">
              <a
                href={pkgWaUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 font-heading font-black text-xs uppercase tracking-wider shadow-glow-amber transition-all hover:scale-[1.02] active:scale-[0.98]"
                aria-label={`Konsultasi paket ${pkg.title} via WhatsApp`}
              >
                <i class="fab fa-whatsapp text-base"></i>
                <span>Konsultasi Paket Ini</span>
              </a>
              <a
                href={`/paket/${pkg.categorySlug}/${pkg.slug}`}
                class="w-full inline-flex items-center justify-center gap-2 py-2 px-3 rounded-xl bg-brand-950/80 hover:bg-brand-900 border border-amber-400/40 text-amber-300 hover:text-white font-heading font-bold text-xs uppercase tracking-wider transition-all hover:scale-[1.01] active:scale-[0.98]"
                aria-label={`Detail paket ${pkg.title}`}
              >
                <i class="fas fa-eye text-xs text-amber-400"></i>
                <span>Detail Paket</span>
              </a>
            </div>

          </div>
        );
      })}
    </div>

    <!-- 3-Dot Indicators (Exact Match with Reference image below product grid) -->
    <div class="flex items-center justify-center gap-2 mt-8">
      <span class="w-2 h-2 rounded-full bg-amber-400"></span>
      <span class="w-2 h-2 rounded-full bg-rose-700/60"></span>
      <span class="w-2 h-2 rounded-full bg-rose-700/60"></span>
    </div>

  </div>
</section>

<script is:inline>
  (function() {
    function hydratePkgGridSection() {
      // 1. Text headings from vo_page_beranda
      var raw = localStorage.getItem('vo_page_beranda');
      if (raw) {
        try {
          var data = JSON.parse(raw);
          var heading = document.getElementById('pkg-grid-heading');
          var subheading = document.getElementById('pkg-grid-subheading');
          if (data.pkgHeading && heading) heading.textContent = data.pkgHeading;
          if (data.pkgSubheading && subheading) subheading.textContent = data.pkgSubheading;
        } catch (e) {
          console.error(e);
        }
      }

      // 2. Package cards from vo_packages
      var pkgRaw = localStorage.getItem('vo_packages');
      if (pkgRaw) {
        try {
          var list = JSON.parse(pkgRaw);
          if (Array.isArray(list) && list.length > 0) {
            var grid = document.getElementById('homepage-pkg-cards-grid');
            if (grid) {
              var featured = list.slice(0, 4);
              grid.innerHTML = featured.map(function(pkg) {
                var waMsg = encodeURIComponent('Halo Provider Outbound, saya ingin konsultasi paket ' + pkg.title + ' (' + (pkg.categoryName || '') + ').');
                var waLink = 'https://wa.me/6282211221909?text=' + waMsg;
                return (
                  '<div class="rounded-2xl bg-[#52050B]/75 border border-rose-700/40 hover:border-amber-400/70 p-6 sm:p-7 flex flex-col items-center text-center shadow-card transition-all duration-300 hover:-translate-y-2 group h-full justify-between">' +
                    '<div class="flex flex-col items-center w-full">' +
                      '<div class="w-36 h-36 sm:w-44 sm:h-44 rounded-full p-1.5 bg-gradient-to-tr from-brand-700 to-amber-500/50 border-2 border-rose-400/40 mb-5 shadow-xl group-hover:scale-105 transition-transform shrink-0">' +
                        '<img src="' + (pkg.imageUrl || '/images/hero/hero-outbound.webp') + '" alt="' + pkg.title + '" width="200" height="200" class="w-full h-full object-cover rounded-full" loading="lazy" />' +
                      '</div>' +
                      '<h3 class="font-heading font-black text-base sm:text-lg uppercase tracking-wider text-white group-hover:text-amber-400 transition-colors">' +
                        pkg.title +
                      '</h3>' +
                      '<span class="text-xs uppercase tracking-wider text-rose-300/85 mt-1 font-semibold">' +
                        (pkg.categoryName || 'Paket Outbound') +
                      '</span>' +
                      '<div class="flex items-center gap-1.5 text-amber-400 text-sm sm:text-base my-3" aria-label="Rating 5 bintang">' +
                        '<span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>' +
                      '</div>' +
                    '</div>' +
                    '<div class="w-full pt-4 mt-4 border-t border-rose-800/40 flex flex-col gap-2.5">' +
                      '<a href="' + waLink + '" target="_blank" rel="noopener noreferrer" class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 font-heading font-black text-xs uppercase tracking-wider shadow-glow-amber transition-all hover:scale-[1.02] active:scale-[0.98]" aria-label="Konsultasi paket ' + pkg.title + ' via WhatsApp">' +
                        '<i class="fab fa-whatsapp text-base"></i>' +
                        '<span>Konsultasi Paket Ini</span>' +
                      '</a>' +
                      '<a href="/paket/' + (pkg.categorySlug || 'perusahaan') + '/' + pkg.slug + '" class="w-full inline-flex items-center justify-center gap-2 py-2 px-3 rounded-xl bg-brand-950/80 hover:bg-brand-900 border border-amber-400/40 text-amber-300 hover:text-white font-heading font-bold text-xs uppercase tracking-wider transition-all hover:scale-[1.01] active:scale-[0.98]" aria-label="Detail paket ' + pkg.title + '">' +
                        '<i class="fas fa-eye text-xs text-amber-400"></i>' +
                        '<span>Detail Paket</span>' +
                      '</a>' +
                    '</div>' +
                  '</div>'
                );
              }).join('');
            }
          }
        } catch(e) {}
      }
    }

    hydratePkgGridSection();
    document.addEventListener('DOMContentLoaded', hydratePkgGridSection);
    window.addEventListener('storage', function(e) {
      if (e.key === 'vo_page_beranda' || e.key === 'vo_packages') hydratePkgGridSection();
    });
    window.addEventListener('vo_content_updated', hydratePkgGridSection);

    try {
      var bc = new BroadcastChannel('vo_sync_channel');
      bc.onmessage = function(e) {
        if (!e.data || e.data.key === 'vo_page_beranda' || e.data.key === 'vo_packages') {
          hydratePkgGridSection();
        }
      };
    } catch(err) {}
  })();
</script>
