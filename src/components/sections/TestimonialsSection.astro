---
// Testimonials Section with 3 Verified Client Review Cards
const testimonials = [
  {
    id: 1,
    name: 'Hendro Wicaksono, S.T.',
    role: 'HR Director',
    company: 'PT Astra Graphia Tbk',
    avatar: '/images/testimonials/client-1.webp',
    rating: 5,
    tag: 'Corporate Gathering • 150 Peserta',
    review: 'Penyelenggaraan corporate gathering dan team building 150 staf kami di resort Batu berjalan luar biasa tertib, presisi waktu, dan sangat berkesan. Fasilitator BNSP sangat komunikatif membimbing simulasi tim, dan sesi debrief-nya berhasil menyegarkan kembali komitmen kerja lintas divisi.',
    date: 'September 2026'
  },
  {
    id: 2,
    name: 'Dra. Hj. Siti Nurhaliza, M.Pd',
    role: 'Kepala Sekolah',
    company: 'SMAN 3 Surabaya',
    avatar: '/images/testimonials/client-2.webp',
    rating: 5,
    tag: 'LDKS & Karakter Siswa • 220 Pelajar',
    review: 'Latihan Dasar Kepemimpinan Siswa (LDKS) di Coban Rondo terlaksana sangat aman, edukatif, dan sarat nilai kedisiplinan. Fasilitator Provider Outbound sangat sigap mengawal SOP keselamatan anak didik kami dengan pendekatan yang persuasif dan inspiratif. Luar biasa!',
    date: 'Oktober 2026'
  },
  {
    id: 3,
    name: 'Ir. Bambang Priyambodo',
    role: 'Ketua Panitia Gathering',
    company: 'Paguyuban Alumni ITS Surabaya',
    avatar: '/images/testimonials/client-3.webp',
    rating: 5,
    tag: 'Family Gathering • 85 Keluarga',
    review: 'Family gathering tahunan kami berjalan sangat meriah tanpa ada peserta yang jenuh. Variasi fun games-nya ramah untuk balita hingga lansia. Tim logistik dan konsumsinya sigap, plus dokumentasi foto dan drone-nya berkualitas studio. Pasti repeat order tahun depan!',
    date: 'Agustus 2026'
  }
];
---

<section class="py-16 sm:py-24 relative overflow-hidden" id="testimoni">
  <!-- Ambient backdrop glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-brand-600/15 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center mb-12 sm:mb-16">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/15 border border-amber-400/30 text-amber-300 text-xs font-bold uppercase tracking-widest">
        <i class="fas fa-star text-[10px]"></i> Testimoni Klien &amp; Ulasan Nyata
      </span>
      <h2 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl uppercase tracking-[0.16em] text-white mt-3" id="testi-section-heading">
        KEPERCAYAAN &amp; KEPUASAN KLIEN KAMI
      </h2>
      <p class="text-xs sm:text-sm text-rose-200/80 mt-2 max-w-2xl mx-auto" id="testi-section-subheading">
        Kisah sukses penyelenggaraan program outbound korporat, gathering keluarga besar, dan edukasi kepemimpinan pelajar di Malang Raya.
      </p>
    </div>

    <!-- 3 Review Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8" id="testimonials-cards-grid">
      {testimonials.map((item) => (
        <div class="rounded-2xl bg-[#440308]/75 backdrop-blur-md border border-rose-700/40 hover:border-amber-400/60 p-6 sm:p-7 flex flex-col justify-between shadow-2xl transition-all duration-300 hover:-translate-y-2 group">
          
          <div>
            <!-- Top Row: Rating & Tag -->
            <div class="flex items-center justify-between gap-2 mb-4 pb-3 border-b border-rose-900/40">
              <div class="flex items-center gap-1 text-amber-400 text-sm" aria-label="Rating 5 Bintang">
                {Array.from({ length: item.rating }).map(() => (
                  <i class="fas fa-star"></i>
                ))}
              </div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-amber-300/90 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20">
                {item.date}
              </span>
            </div>

            <!-- Activity Badge -->
            <div class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-rose-200/90 mb-3 bg-brand-950/60 px-2.5 py-1 rounded-md border border-rose-800/30">
              <i class="fas fa-check-circle text-emerald-400 text-[10px]"></i>
              <span>{item.tag}</span>
            </div>

            <!-- Quote Text -->
            <div class="relative">
              <i class="fas fa-quote-left text-amber-500/20 text-3xl absolute -top-2 -left-1 pointer-events-none"></i>
              <p class="text-xs sm:text-sm text-rose-100/90 leading-relaxed italic relative z-10 pl-2">
                "{item.review}"
              </p>
            </div>
          </div>

          <!-- Bottom: Client Info -->
          <div class="flex items-center gap-3.5 pt-5 mt-5 border-t border-rose-900/40">
            <div class="relative w-12 h-12 rounded-full p-0.5 bg-gradient-to-tr from-amber-400 to-brand-600 flex-shrink-0 shadow-md">
              <img
                src={item.avatar}
                alt={item.name}
                width="80"
                height="80"
                class="w-full h-full object-cover rounded-full"
                loading="lazy"
              />
              <div class="absolute -bottom-0.5 -right-0.5 w-4 h-4 rounded-full bg-emerald-500 border-2 border-stone-950 flex items-center justify-center text-[8px] text-white" title="Verified Review">
                <i class="fas fa-check"></i>
              </div>
            </div>
            <div class="min-w-0 flex-1">
              <h4 class="font-heading font-black text-sm uppercase tracking-wide text-white group-hover:text-amber-300 transition-colors truncate">
                {item.name}
              </h4>
              <p class="text-[11px] text-amber-300/90 font-medium truncate">
                {item.role}
              </p>
              <p class="text-[10px] text-rose-300/70 truncate">
                {item.company}
              </p>
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- Rating Summary Pill -->
    <div class="mt-12 text-center">
      <div class="inline-flex flex-wrap items-center justify-center gap-3 px-5 py-2.5 rounded-full bg-brand-950/70 border border-rose-800/40 text-xs text-rose-200">
        <div class="flex items-center gap-1 text-amber-400">
          <i class="fas fa-star"></i>
          <i class="fas fa-star"></i>
          <i class="fas fa-star"></i>
          <i class="fas fa-star"></i>
          <i class="fas fa-star"></i>
        </div>
        <span class="font-bold text-white">4.9 / 5.0</span>
        <span class="text-rose-400/60">•</span>
        <span>Berdasarkan 120+ kegiatan perusahaan, instansi &amp; sekolah di Jawa Timur</span>
      </div>
    </div>

  </div>
</section>

<script is:inline>
  (function() {
    function hydrateTestimonials() {
      var raw = localStorage.getItem('vo_testimonials');
      if (!raw) return;
      try {
        var list = JSON.parse(raw);
        if (!Array.isArray(list) || list.length === 0) return;
        var container = document.getElementById('testimonials-cards-grid');
        if (!container) return;

        container.innerHTML = list.slice(0, 3).map(function(item) {
          var starCount = Number(item.rating) || 5;
          var starsHtml = '';
          for (var i = 0; i < starCount; i++) {
            starsHtml += '<i class="fas fa-star"></i>';
          }
          var avatarSrc = item.avatar || '/images/author-artikel/author-artikel-arby-ardiansyah.webp';
          var clientName = item.name || item.display_name || 'Klien Outbound';
          var clientRole = item.role ? item.role + ' • ' : '';
          var clientOrg = item.company || item.organization || '';
          var clientReview = item.review || item.quote || '';
          var tagLabel = item.tag || item.company || 'Corporate Client';
          var dateLabel = item.date || 'Terverifikasi';

          return (
            '<div class="rounded-2xl bg-[#440308]/75 backdrop-blur-md border border-rose-700/40 hover:border-amber-400/60 p-6 sm:p-7 flex flex-col justify-between shadow-2xl transition-all duration-300 hover:-translate-y-2 group">' +
              '<div>' +
                '<div class="flex items-center justify-between gap-2 mb-4 pb-3 border-b border-rose-900/40">' +
                  '<div class="flex items-center gap-1 text-amber-400 text-sm">' +
                    starsHtml +
                  '</div>' +
                  '<span class="text-[10px] font-bold uppercase tracking-wider text-amber-300/90 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20">' +
                    dateLabel +
                  '</span>' +
                '</div>' +
                '<div class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-rose-200/90 mb-3 bg-brand-950/60 px-2.5 py-1 rounded-md border border-rose-800/30">' +
                  '<i class="fas fa-check-circle text-emerald-400 text-[10px]"></i>' +
                  '<span>' + tagLabel + '</span>' +
                '</div>' +
                '<p class="text-xs sm:text-sm text-rose-100/90 leading-relaxed italic">' +
                  '"' + clientReview + '"' +
                '</p>' +
              '</div>' +
              '<div class="flex items-center gap-3.5 pt-5 mt-6 border-t border-rose-900/40">' +
                '<img src="' + avatarSrc + '" alt="' + clientName + '" width="48" height="48" class="w-12 h-12 rounded-full object-cover border-2 border-amber-400/70 shadow-md group-hover:scale-105 transition-transform" loading="lazy" />' +
                '<div>' +
                  '<h3 class="font-heading font-black text-sm text-white uppercase tracking-wider group-hover:text-amber-400 transition-colors">' +
                    clientName +
                  '</h3>' +
                  '<p class="text-[11px] text-amber-300/90 font-medium">' +
                    clientRole + clientOrg +
                  '</p>' +
                '</div>' +
              '</div>' +
            '</div>'
          );
        }).join('');
      } catch (e) {
        console.error(e);
      }
    }

    hydrateTestimonials();
    document.addEventListener('DOMContentLoaded', hydrateTestimonials);
    window.addEventListener('storage', function(e) {
      if (e.key === 'vo_testimonials') hydrateTestimonials();
    });
    window.addEventListener('vo_content_updated', hydrateTestimonials);

    try {
      var bc = new BroadcastChannel('vo_sync_channel');
      bc.onmessage = function(e) {
        if (!e.data || e.data.key === 'vo_testimonials') {
          hydrateTestimonials();
        }
      };
    } catch(err) {}
  })();
</script>
