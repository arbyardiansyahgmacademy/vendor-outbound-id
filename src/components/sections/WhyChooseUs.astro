---
import { WHY_CHOOSE_US } from '../../data/defaultContent';
---

<section class="py-16 sm:py-20 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-400" id="why-badge">
        Keunggulan Layanan
      </span>
      <h2 class="font-heading font-black text-2xl sm:text-3xl lg:text-4xl uppercase tracking-[0.16em] text-white mt-2" id="why-heading">
        MENGAPA MEMILIH KAMI
      </h2>
      <p class="text-xs sm:text-sm text-rose-200/75 mt-2 max-w-xl mx-auto" id="why-subheading">
        Kombinasi pengalaman lapangan di Batu - Malang, kepedulian terhadap keselamatan, dan agenda yang fleksibel.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {WHY_CHOOSE_US.map((item, index) => (
        <div class="rounded-xl bg-[#480308]/60 border border-rose-700/30 p-6 flex flex-col justify-between hover:border-amber-400/50 transition-all duration-300 hover:-translate-y-1 group">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 font-heading font-black text-sm group-hover:bg-amber-500 group-hover:text-stone-950 transition-colors">
              0{index + 1}
            </div>
            <h3 class="font-heading font-black text-base uppercase tracking-wider text-white group-hover:text-amber-300 transition-colors">
              {item.title}
            </h3>
            <p class="text-xs text-rose-200/75 leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
