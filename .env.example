# Vendor Outbound ID — Environment Variables Template
# Salin file ini menjadi .env pada saat konfigurasi Supabase aktif

PUBLIC_SITE_URL=https://vendoroutbound.id
PUBLIC_OFFICIAL_WHATSAPP=6282211221909
PUBLIC_SITE_NAME="Vendor Outbound"

# Supabase Credentials (Dapatkan dari Project Settings > API di Dashboard Supabase)
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only (JANGAN publikasikan atau beri prefix PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
